        function filtrarDashboardsTodasCategorias() {
            const busq = (document.getElementById('buscarDashTodasCategorias')?.value || '').toLowerCase().trim();
            const btnClear = document.getElementById('btnClearDashTodasCat');
            if (btnClear) btnClear.style.display = busq.length > 0 ? 'block' : 'none';

            const tarjetas = document.querySelectorAll('.tarjeta-dash-todas-cat');
            let visCount = 0;
            tarjetas.forEach(t => {
                const coincide = !busq || (t.dataset.search || '').includes(busq);
                if (coincide) {
                    t.style.display = '';
                    visCount++;
                } else {
                    t.style.display = 'none';
                }
            });

            const msgSin = document.getElementById('sinCoincidenciasDashTodasCat');
            if (msgSin) {
                msgSin.style.display = (tarjetas.length > 0 && visCount === 0) ? 'block' : 'none';
            }
        }

        window.addEventListener('pageshow', function(event) {
            if (event.persisted || (window.performance && window.performance.navigation && window.performance.navigation.type === 2)) {
                window.location.replace('/');
            }
        });

        window.addEventListener('DOMContentLoaded', () => {
            renderizarGrafica('estatus', 'pie', datosEstatus.labels, datosEstatus.counts, datosEstatus.colors, 'Estatus', false);
            renderizarGrafica('prioridad', 'pie', datosPrioridad.labels, datosPrioridad.counts, datosPrioridad.colors, 'Prioridad', false);
            renderizarGrafica('tiempos-resolucion', 'bar', datosTiemposResolucion.labels, datosTiemposResolucion.hours, datosTiemposResolucion.colors, 'Tiempos de Resolución', true, datosTiemposResolucion.formattedTexts);

            const hash = window.location.hash ? window.location.hash.replace('#', '') : '';
            if (hash && (hash === 'general' || hash === 'todas' || hash.startsWith('cat-'))) {
                cambiarVistaDashboard(hash);
            } else {
                cambiarVistaDashboard('general');
            }
        });
    </script>
