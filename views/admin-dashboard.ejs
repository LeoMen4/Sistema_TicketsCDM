            document.getElementById('idTicketEliminar').value = id;
            document.getElementById('txtIdTicketEliminar').textContent = id;
            document.getElementById('txtTituloTicketEliminar').textContent = titulo;
            const passInput = document.getElementById('passAdminEliminarTicket');
            if (passInput) passInput.value = '';
            document.getElementById('modalEliminarTicket').style.display = 'block';
        }

        function cerrarModalEliminarTicket() {
            document.getElementById('modalEliminarTicket').style.display = 'none';
