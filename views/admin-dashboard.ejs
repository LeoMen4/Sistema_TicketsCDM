                            oninput="filtrarSelectorUsuario('buscarCrearEquipoUsuarioSelect', 'crearEquipoUsuarioSelect', 'badgeCrearEquipoUsuarioSelect', 'btnClearCrearEquipoUsuarioSelect', 'sugerenciasCrearEquipoUsuarioSelect')" 
