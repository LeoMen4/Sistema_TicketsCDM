        // ==========================================
        // PROCESADOR DE ALERTAS DE CITAS PROGRAMADAS
        // (Alerta Windows 1 día antes y 1 hora antes)
        // ==========================================
        function procesarAlertasCitasProgramadas(ticketsProgramados, recordatorios) {
            ticketsProgramados = Array.isArray(ticketsProgramados) ? ticketsProgramados : [];
            recordatorios = Array.isArray(recordatorios) ? recordatorios : [];

            const ahora = Date.now();

            // 1. Revisar y disparar alertas de escritorio para Citas de Tickets
            ticketsProgramados.forEach(tp => {
                if (!tp.fecha_programada_cliente) return;
                const dCita = new Date(String(tp.fecha_programada_cliente).includes('T') ? tp.fecha_programada_cliente : String(tp.fecha_programada_cliente).replace(' ', 'T'));
                if (isNaN(dCita.getTime())) return;

                const diffMs = dCita.getTime() - ahora;
                const diffMinutes = Math.floor(diffMs / 60000);
                const diffHours = diffMs / 3600000;

                const horaStr = dCita.toLocaleTimeString('es-MX', { timeZone: 'America/Mexico_City', hour: '2-digit', minute: '2-digit' });

                // Alerta 1 día antes (entre 1.2 hrs y 26 hrs de anticipación)
                const key1Dia = 'notif_cita_1dia_' + tp.id + '_' + tp.fecha_programada_cliente;
                if (diffHours > 1.2 && diffHours <= 26) {
                    if (!localStorage.getItem(key1Dia)) {
                        localStorage.setItem(key1Dia, '1');
                        dispararNotificacionEscritorioAdmin(
                            `Recordatorio: Programación para Mañana (Ticket #${tp.id})`,
                            `El día de mañana tienes programada la resolución de un ticket (Ticket #${tp.id} - ${horaStr} hrs con ${tp.usuario_nombre || 'Usuario'}: ${tp.titulo})`,
                            tp.id,
                            'cita-1dia'
                        );
                        mostrarToastNotificacionAdmin(
                            `El día de mañana tienes programada la resolución de un ticket (#${tp.id})`,
                            `A las ${horaStr} hrs con ${tp.usuario_nombre || 'Usuario'} • "${tp.titulo}"`,
                            tp.id,
                            'cita'
                        );
                        reproducirSonidoAlertaAdmin('ticket');
                    }
                }

                // Alerta 1 hora antes (entre 0 y 65 minutos de anticipación)
                const key1Hora = 'notif_cita_1hora_' + tp.id + '_' + tp.fecha_programada_cliente;
                if (diffMinutes > 0 && diffMinutes <= 65) {
                    if (!localStorage.getItem(key1Hora)) {
                        localStorage.setItem(key1Hora, '1');
                        dispararNotificacionEscritorioAdmin(
                            `Aviso Urgente: Programación en 1 hora (Ticket #${tp.id})`,
                            `En una hora tienes programada la resolución de un ticket (Ticket #${tp.id} - ${horaStr} hrs con ${tp.usuario_nombre || 'Usuario'}: ${tp.titulo})`,
                            tp.id,
                            'cita-1hora'
                        );
                        mostrarToastNotificacionAdmin(
                            `En una hora tienes programada la resolución de un ticket (#${tp.id})`,
                            `A las ${horaStr} hrs con ${tp.usuario_nombre || 'Usuario'} • "${tp.titulo}"`,
                            tp.id,
                            'cita'
                        );
                        reproducirSonidoAlertaAdmin('ticket');
                    }
                }
            });

            // 2. Revisar y disparar alertas de escritorio para Recordatorios Personalizados
            recordatorios.forEach(rec => {
                if (!rec.fecha_programada) return;
                const dRec = new Date(String(rec.fecha_programada).includes('T') ? rec.fecha_programada : String(rec.fecha_programada).replace(' ', 'T'));
                if (isNaN(dRec.getTime())) return;

                const diffMs = dRec.getTime() - ahora;
                const diffMinutes = Math.floor(diffMs / 60000);
                const diffHours = diffMs / 3600000;

                const horaStr = dRec.toLocaleTimeString('es-MX', { timeZone: 'America/Mexico_City', hour: '2-digit', minute: '2-digit' });

                // Alerta 1 día antes
                const key1Dia = 'notif_rec_1dia_' + rec.id + '_' + rec.fecha_programada;
                if (diffHours > 1.2 && diffHours <= 26) {
                    if (!localStorage.getItem(key1Dia)) {
                        localStorage.setItem(key1Dia, '1');
                        dispararNotificacionEscritorioAdmin(
                            `Recordatorio TI para Mañana: ${rec.destinatario}`,
                            `Para mañana a las ${horaStr} hrs: "${rec.descripcion}" (Destinatario: ${rec.destinatario})`,
                            null,
                            'rec-1dia'
                        );
                        mostrarToastNotificacionAdmin(
                            `Recordatorio programado para mañana (${horaStr} hrs)`,
                            `Para ${rec.destinatario} • "${rec.descripcion}"`,
                            null,
                            'recordatorio'
                        );
                        reproducirSonidoAlertaAdmin('ticket');
                    }
                }

                // Alerta 1 hora antes
                const key1Hora = 'notif_rec_1hora_' + rec.id + '_' + rec.fecha_programada;
                if (diffMinutes > 0 && diffMinutes <= 65) {
                    if (!localStorage.getItem(key1Hora)) {
                        localStorage.setItem(key1Hora, '1');
                        dispararNotificacionEscritorioAdmin(
                            `Aviso Urgente: Recordatorio en 1 hora (${rec.destinatario})`,
                            `En una hora a las ${horaStr} hrs: "${rec.descripcion}" (Destinatario: ${rec.destinatario})`,
                            null,
                            'rec-1hora'
                        );
                        mostrarToastNotificacionAdmin(
                            `Recordatorio en 1 hora (${horaStr} hrs)`,
                            `Para ${rec.destinatario} • "${rec.descripcion}"`,
                            null,
                            'recordatorio'
                        );
                        reproducirSonidoAlertaAdmin('ticket');
                    }
                }
            });

            // 3. Refrescar widget de la esquina inferior izquierda
            const listaSidebar = document.getElementById('listaCitasSidebar');
            const badgeSidebar = document.getElementById('badgeTotalCitasSidebar');
            const totalItems = ticketsProgramados.length + recordatorios.length;
            if (badgeSidebar) {
                badgeSidebar.textContent = totalItems;
            }

            if (listaSidebar) {
                if (totalItems === 0) {
                    listaSidebar.innerHTML = `
                        <div class="p-2.5 text-center text-slate-400 text-[11px] italic rounded bg-slate-50 border border-dashed border-slate-200">
                            Sin citas ni recordatorios pendientes
                        </div>
                    `;
                } else {
                    const hoyStr = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City' }).format(new Date());
                    let htmlContenido = '';

                    // 3.1 Citas de Tickets (Ámbar)
                    ticketsProgramados.forEach(tc => {
                        const dCita = new Date(String(tc.fecha_programada_cliente).includes('T') ? tc.fecha_programada_cliente : String(tc.fecha_programada_cliente).replace(' ', 'T'));
                        let fechaFormateada = tc.fecha_programada_cliente;
                        if (!isNaN(dCita.getTime())) {
                            const citaStr = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City' }).format(dCita);
                            const horaStr = dCita.toLocaleTimeString('es-MX', { timeZone: 'America/Mexico_City', hour: '2-digit', minute: '2-digit' });
                            if (citaStr === hoyStr) {
                                fechaFormateada = 'Hoy ' + horaStr + ' hrs';
                            } else {
                                fechaFormateada = dCita.toLocaleDateString('es-MX', { timeZone: 'America/Mexico_City', day: '2-digit', month: 'short' }) + ', ' + horaStr + ' hrs';
                            }
                        }

                        const motivoEsc = (tc.motivo_pendiente_cliente || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
                        const fechaEsc = (tc.fecha_programada_cliente || '').replace(/'/g, "\\'");

                        htmlContenido += `
                            <div class="p-2 rounded-md bg-amber-50/80 border border-amber-300 text-xs hover:bg-amber-100/70 transition-colors shadow-2xs group relative">
                                <div class="flex items-center justify-between gap-1 mb-1">
                                    <span class="inline-flex items-center gap-1 text-[10px] font-black uppercase tracking-wider text-amber-800 bg-amber-200/60 px-1.5 py-0.5 rounded border border-amber-300">
                                        <span>Cita Ticket</span>
                                    </span>
                                    <div class="flex items-center gap-1">
                                        <a href="/admin/tickets/${tc.id}" target="_blank" class="text-[10px] font-black bg-white text-amber-900 hover:text-amber-950 px-1.5 py-0.5 rounded border border-amber-300 shadow-2xs" title="Abrir ticket completo">
                                            #${tc.id}
                                        </a>
                                        <button 
                                            type="button" 
                                            onclick="abrirModalEditarCitaTicket('${tc.id}', '${fechaEsc}', '${motivoEsc}')"
                                            class="text-amber-700 hover:text-amber-900 hover:bg-amber-200/70 p-1 rounded transition-colors cursor-pointer"
                                            title="Editar fecha/motivo de esta cita"
                                        >
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                        </button>
                                        <button 
                                            type="button" 
                                            onclick="confirmarEliminarCitaTicket('${tc.id}')"
                                            class="text-red-500 hover:text-red-700 hover:bg-red-100 p-1 rounded transition-colors cursor-pointer"
                                            title="Eliminar esta cita programada"
                                        >
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </button>
                                    </div>
                                </div>
                                <div class="font-bold text-amber-950 text-[11px] truncate flex items-center gap-1">
                                    <svg class="w-3 h-3 text-amber-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                    ${escaparHtmlSimple(fechaFormateada)}
                                </div>
                                <div class="font-semibold text-slate-800 text-[11px] truncate mt-0.5" title="${escaparHtmlSimple(tc.titulo)}">
                                    ${escaparHtmlSimple(tc.titulo)}
                                </div>
                                <div class="text-[10px] text-slate-600 truncate">
                                    ${escaparHtmlSimple(tc.usuario_nombre || 'Usuario')}
                                </div>
                                ${tc.motivo_pendiente_cliente ? `
                                    <div class="text-[9px] text-amber-800 italic truncate mt-0.5" title="${escaparHtmlSimple(tc.motivo_pendiente_cliente)}">
                                        "${escaparHtmlSimple(tc.motivo_pendiente_cliente)}"
                                    </div>
                                ` : ''}
                            </div>
                        `;
                    });

                    // 3.2 Recordatorios Generales (Índigo)
                    recordatorios.forEach(rec => {
                        const dRec = new Date(String(rec.fecha_programada).includes('T') ? rec.fecha_programada : String(rec.fecha_programada).replace(' ', 'T'));
                        let fechaFormateada = rec.fecha_programada;
                        if (!isNaN(dRec.getTime())) {
                            const recStr = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City' }).format(dRec);
                            const horaStr = dRec.toLocaleTimeString('es-MX', { timeZone: 'America/Mexico_City', hour: '2-digit', minute: '2-digit' });
                            if (recStr === hoyStr) {
                                fechaFormateada = 'Hoy ' + horaStr + ' hrs';
                            } else {
                                fechaFormateada = dRec.toLocaleDateString('es-MX', { timeZone: 'America/Mexico_City', day: '2-digit', month: 'short' }) + ', ' + horaStr + ' hrs';
                            }
                        }

                        const destEsc = (rec.destinatario || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
                        const descEsc = (rec.descripcion || '').replace(/'/g, "\\'").replace(/"/g, '&quot;').replace(/\r?\n/g, ' ');
                        const fProgEsc = (rec.fecha_programada || '').replace(/'/g, "\\'");

                        htmlContenido += `
                            <div class="p-2 rounded-md bg-indigo-50/90 border border-indigo-200 text-xs hover:bg-indigo-100/70 transition-colors shadow-2xs group relative">
                                <div class="flex items-center justify-between gap-1 mb-1">
                                    <span class="inline-flex items-center gap-1 text-[10px] font-black uppercase tracking-wider text-indigo-800 bg-indigo-200/60 px-1.5 py-0.5 rounded border border-indigo-300">
                                        <span>Recordatorio</span>
                                    </span>
                                    <div class="flex items-center gap-1">
                                        <button 
                                            type="button" 
                                            onclick="abrirModalEditarRecordatorio('${rec.id}', '${destEsc}', '${descEsc}', '${fProgEsc}')"
                                            class="text-indigo-700 hover:text-indigo-900 hover:bg-indigo-200/70 p-1 rounded transition-colors cursor-pointer"
                                            title="Editar recordatorio"
                                        >
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                        </button>
                                        <button 
                                            type="button" 
                                            onclick="confirmarEliminarRecordatorio('${rec.id}')"
                                            class="text-red-500 hover:text-red-700 hover:bg-red-100 p-1 rounded transition-colors cursor-pointer"
                                            title="Eliminar este recordatorio"
                                        >
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </button>
                                    </div>
                                </div>
                                <div class="font-bold text-indigo-950 text-[11px] truncate flex items-center gap-1">
                                    <svg class="w-3 h-3 text-indigo-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    ${escaparHtmlSimple(fechaFormateada)}
                                </div>
                                <div class="font-bold text-slate-800 text-[11px] truncate mt-0.5" title="${escaparHtmlSimple(rec.destinatario)}">
                                    Para: ${escaparHtmlSimple(rec.destinatario)}
                                </div>
                                <div class="text-[10px] text-indigo-900 leading-tight mt-0.5 line-clamp-2" title="${escaparHtmlSimple(rec.descripcion)}">
                                    ${escaparHtmlSimple(rec.descripcion)}
                                </div>
                            </div>
                        `;
                    });

                    listaSidebar.innerHTML = htmlContenido;
                }
            }
        }

        // ==========================================
        // FUNCIONES DE GESTIÓN DE RECORDATORIOS Y CITAS
        // ==========================================
        function abrirModalCrearRecordatorio() {
            const form = document.getElementById('formModalCrearRecordatorio');
            if (form) form.reset();
            const inputFecha = document.getElementById('nuevoRecFecha');
            if (inputFecha) {
                const manana = new Date();
                manana.setDate(manana.getDate() + 1);
                manana.setHours(10, 0, 0, 0);
                const anio = manana.getFullYear();
                const mes = String(manana.getMonth() + 1).padStart(2, '0');
                const dia = String(manana.getDate()).padStart(2, '0');
                const hora = String(manana.getHours()).padStart(2, '0');
                const min = String(manana.getMinutes()).padStart(2, '0');
                inputFecha.value = `${anio}-${mes}-${dia}T${hora}:${min}`;
            }
            const modal = document.getElementById('modalCrearRecordatorio');
            if (modal) modal.style.display = 'block';
        }

        function cerrarModalCrearRecordatorio() {
            const modal = document.getElementById('modalCrearRecordatorio');
            if (modal) modal.style.display = 'none';
        }

        async function guardarNuevoRecordatorio(e) {
            e.preventDefault();
            const destinatario = document.getElementById('nuevoRecDestinatario').value;
            const fecha_programada = document.getElementById('nuevoRecFecha').value;
            const descripcion = document.getElementById('nuevoRecDescripcion').value;

            try {
                const resp = await fetch('/admin/recordatorios/crear', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ destinatario, fecha_programada, descripcion, formato: 'json' })
                });
                const resJson = await resp.json();
                if (resJson.ok) {
                    cerrarModalCrearRecordatorio();
                    mostrarToastNotificacionAdmin('Recordatorio guardado', `Se programó recordatorio para ${destinatario}`, null, 'recordatorio');
                    verificarNotificacionesLiveAdmin();
                } else {
                    alert('Error: ' + (resJson.error || 'No se pudo guardar'));
                }
            } catch(err) {
                console.error(err);
                alert('Error al guardar el recordatorio');
            }
        }

        function abrirModalEditarRecordatorio(id, destinatario, descripcion, fecha) {
            document.getElementById('editRecId').value = id;
            document.getElementById('editRecDestinatario').value = destinatario || '';
            document.getElementById('editRecDescripcion').value = descripcion || '';
            const inFecha = document.getElementById('editRecFecha');
            if (inFecha && fecha) {
                inFecha.value = String(fecha).replace(' ', 'T').slice(0, 16);
            }
            const modal = document.getElementById('modalEditarRecordatorio');
            if (modal) modal.style.display = 'block';
        }

        function cerrarModalEditarRecordatorio() {
            const modal = document.getElementById('modalEditarRecordatorio');
            if (modal) modal.style.display = 'none';
        }

        async function guardarEdicionRecordatorio(e) {
            e.preventDefault();
            const id = document.getElementById('editRecId').value;
            const destinatario = document.getElementById('editRecDestinatario').value;
            const fecha_programada = document.getElementById('editRecFecha').value;
            const descripcion = document.getElementById('editRecDescripcion').value;

            try {
                const resp = await fetch('/admin/recordatorios/editar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ id, destinatario, fecha_programada, descripcion, formato: 'json' })
                });
                const resJson = await resp.json();
                if (resJson.ok) {
                    cerrarModalEditarRecordatorio();
                    mostrarToastNotificacionAdmin('Recordatorio actualizado', `Cambios guardados con éxito`, null, 'recordatorio');
                    verificarNotificacionesLiveAdmin();
                } else {
                    alert('Error: ' + (resJson.error || 'No se pudo actualizar'));
                }
            } catch(err) {
                console.error(err);
                alert('Error al actualizar el recordatorio');
            }
        }

        async function confirmarEliminarRecordatorio(id) {
            if (!confirm('¿Estás seguro de que deseas eliminar este recordatorio?')) return;
            try {
                const resp = await fetch('/admin/recordatorios/eliminar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ id })
                });
                const resJson = await resp.json();
                if (resJson.ok) {
                    cerrarModalEditarRecordatorio();
                    mostrarToastNotificacionAdmin('Recordatorio eliminado', 'Se eliminó el recordatorio correctamente', null, 'recordatorio');
                    verificarNotificacionesLiveAdmin();
                } else {
                    alert('Error: ' + (resJson.error || 'No se pudo eliminar'));
                }
            } catch(err) {
                console.error(err);
                alert('Error al eliminar el recordatorio');
            }
        }

        function confirmarEliminarRecordatorioDesdeModal() {
            const id = document.getElementById('editRecId').value;
            if (id) confirmarEliminarRecordatorio(id);
        }

        function abrirModalEditarCitaTicket(ticketId, fecha, motivo) {
            document.getElementById('editCitaTicketId').value = ticketId;
            const spanNum = document.getElementById('spanEditarCitaTicketNum');
            if (spanNum) spanNum.textContent = '#' + ticketId;
            const inFecha = document.getElementById('editCitaFecha');
            if (inFecha && fecha) {
                inFecha.value = String(fecha).replace(' ', 'T').slice(0, 16);
            }
            const inMotivo = document.getElementById('editCitaMotivo');
            if (inMotivo) inMotivo.value = motivo || '';

            const modal = document.getElementById('modalEditarCitaTicket');
            if (modal) modal.style.display = 'block';
        }

        function cerrarModalEditarCitaTicket() {
            const modal = document.getElementById('modalEditarCitaTicket');
            if (modal) modal.style.display = 'none';
        }

        async function guardarEdicionCitaTicket(e) {
            e.preventDefault();
            const ticket_id = document.getElementById('editCitaTicketId').value;
            const fecha_programada_cliente = document.getElementById('editCitaFecha').value;
            const motivo_pendiente_cliente = document.getElementById('editCitaMotivo').value;

            try {
                const resp = await fetch('/admin/tickets/editar-cita', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ ticket_id, fecha_programada_cliente, motivo_pendiente_cliente, formato: 'json' })
                });
                const resJson = await resp.json();
                if (resJson.ok) {
                    cerrarModalEditarCitaTicket();
                    mostrarToastNotificacionAdmin('Cita actualizada', `Cita del Ticket #${ticket_id} actualizada correctamente`, ticket_id, 'cita');
                    verificarNotificacionesLiveAdmin();
                } else {
                    alert('Error: ' + (resJson.error || 'No se pudo guardar la cita'));
                }
            } catch(err) {
                console.error(err);
                alert('Error al actualizar la cita del ticket');
            }
        }

        async function confirmarEliminarCitaTicket(ticketId) {
            if (!confirm(`¿Deseas retirar/eliminar la cita programada del Ticket #${ticketId}?`)) return;
            try {
                const resp = await fetch('/admin/tickets/eliminar-cita', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ ticket_id: ticketId, formato: 'json' })
                });
                const resJson = await resp.json();
                if (resJson.ok) {
                    cerrarModalEditarCitaTicket();
                    mostrarToastNotificacionAdmin('Cita eliminada', `Se retiró la cita programada del Ticket #${ticketId}`, ticketId, 'cita');
                    verificarNotificacionesLiveAdmin();
                } else {
                    alert('Error: ' + (resJson.error || 'No se pudo eliminar la cita'));
                }
            } catch(err) {
                console.error(err);
                alert('Error al eliminar la cita del ticket');
            }
        }

        function confirmarEliminarCitaDesdeModal() {
            const ticketId = document.getElementById('editCitaTicketId').value;
            if (ticketId) confirmarEliminarCitaTicket(ticketId);
        }

        // ==========================================
        // POLEO EN VIVO Y ACTUALIZACIÓN EN TIEMPO REAL
        // ==========================================
        async function verificarNotificacionesLiveAdmin() {
            try {
                const resp = await fetch('/api/admin/notificaciones-live');
                const data = await resp.json();
                if (!data.ok) return;

                // Procesar recordatorios y alertas de citas programadas
                if (data.ticketsProgramados || data.recordatorios) {
                    procesarAlertasCitasProgramadas(data.ticketsProgramados || [], data.recordatorios || []);
                }

                const descartados = obtenerTicketsDescartados();
                const ticketsNuevosActivos = (data.ticketsNuevos || []).filter(t => !descartados.includes(Number(t.id)));
                const mensajesNoLeidosActivos = data.listaMensajesNoLeidos || [];

                const ultimoTk = data.ultimoTicket ? data.ultimoTicket.id : 0;
                const ultimoCom = data.ultimoComentarioUsuario ? data.ultimoComentarioUsuario.id : 0;

                // Alerta sonora y visual al recibir nuevo ticket (solo si WebSockets estuviese desconectado)
                if (ultimoTicketIdConocido === null) {
                    ultimoTicketIdConocido = ultimoTk;
                } else if (ultimoTk > ultimoTicketIdConocido) {
                    ultimoTicketIdConocido = ultimoTk;
                    const wsConectado = (socketAdmin && socketAdmin.connected);
                    if (!wsConectado && !descartados.includes(Number(ultimoTk))) {
                        reproducirSonidoAlertaAdmin('ticket');
                        const t = data.ultimoTicket;
                        const titToast = `Ticket #${t.id}: ${t.titulo}`;
                        const subToast = `Solicitante: ${t.usuario_nombre || 'Usuario'} (${t.prioridad})`;

                        mostrarToastNotificacionAdmin(titToast, subToast, t.id, 'ticket');
                        dispararNotificacionEscritorioAdmin(
                            `Nuevo Ticket #${t.id} - ${t.prioridad}`,
                            `${t.usuario_nombre || 'Usuario'}: ${t.titulo}`,
                            t.id,
                            'ticket'
                        );
                    }
                }

                // Alerta sonora y visual al recibir nuevo mensaje de chat (solo si WebSockets estuviese desconectado)
                if (ultimoComentarioIdConocido === null) {
                    ultimoComentarioIdConocido = ultimoCom;
                } else if (ultimoCom > ultimoComentarioIdConocido) {
                    ultimoComentarioIdConocido = ultimoCom;
                    const wsConectado = (socketAdmin && socketAdmin.connected);
                    if (!wsConectado) {
                        reproducirSonidoAlertaAdmin('chat');
                        const c = data.ultimoComentarioUsuario;
                        const titToast = `Ticket #${c.ticket_id} — ${c.autor_nombre}`;
                        const subToast = c.mensaje || 'Envió un archivo o evidencia adjunta';

                        mostrarToastNotificacionAdmin(titToast, subToast, c.ticket_id, 'chat');
                        dispararNotificacionEscritorioAdmin(
                            `Nuevo mensaje en Ticket #${c.ticket_id}`,
                            `${c.autor_nombre}: ${c.mensaje || 'Envió un adjunto'}`,
                            c.ticket_id,
                            'chat'
                        );
                    }

                    const badgeFila = document.getElementById('badgeChatAdminTicket-' + c.ticket_id);
                    if (badgeFila) {
                        const actual = parseInt(badgeFila.textContent || '0', 10) + 1;
                        badgeFila.textContent = actual;
                        badgeFila.style.display = '';
                    }
                }

                // Actualizar badges en filas de la tabla
                if (data.conteosPorTicket && Array.isArray(data.conteosPorTicket)) {
                    data.conteosPorTicket.forEach(item => {
                        const badgeFila = document.getElementById('badgeChatAdminTicket-' + item.ticket_id);
                        if (badgeFila) {
                            if (item.no_leidos_admin > 0) {
                                badgeFila.textContent = item.no_leidos_admin;
                                badgeFila.style.display = '';
                            } else {
                                badgeFila.style.display = 'none';
                                badgeFila.textContent = '0';
                            }
                        }
                    });
                }

                // Actualizar contador del botón en el Header y título de pestaña
                const totalAlertas = ticketsNuevosActivos.length + mensajesNoLeidosActivos.length;
                const badgeHeader = document.getElementById('badgeNotifAdminHeader');
                if (badgeHeader) {
                    if (totalAlertas > 0) {
                        badgeHeader.textContent = totalAlertas;
                        badgeHeader.style.display = '';
                        document.title = `(${totalAlertas}) ${tituloOriginalAdmin}`;
                    } else {
                        badgeHeader.style.display = 'none';
                        document.title = tituloOriginalAdmin;
                    }
                }

                // Actualizar lista dentro del dropdown de la campana
                const lista = document.getElementById('listaNotificacionesLiveAdmin');
                if (lista) {
                    let htmlItems = '';

                    // 1. Renderizar cada ticket nuevo
                    ticketsNuevosActivos.forEach(t => {
                        htmlItems += `
                            <div class="p-3 bg-brand-50/60 hover:bg-brand-50 border-l-4 border-brand-600 flex items-start justify-between gap-2.5 transition-colors">
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-1.5 flex-wrap">
                                        <span class="px-1.5 py-0.2 rounded text-[9px] font-extrabold bg-brand-600 text-white"> NUEVO TICKET #${t.id}</span>
                                        <span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-white text-slate-700 border border-slate-300">${escaparHtmlSimple(t.prioridad || 'Media')}</span>
                                    </div>
                                    <div class="font-bold text-slate-900 text-xs mt-1 truncate" title="${escaparHtmlSimple(t.titulo)}">
                                        ${escaparHtmlSimple(t.titulo)}
                                    </div>
                                    <div class="text-[11px] text-slate-500 truncate">
                                        Solicitante: <strong class="text-slate-700">${escaparHtmlSimple(t.usuario_nombre || 'Usuario')}</strong> ${t.usuario_puesto ? '• ' + escaparHtmlSimple(t.usuario_puesto) : ''}
                                    </div>
                                    <div class="mt-2 flex items-center gap-2">
                                        <a 
                                            href="/admin/tickets/${t.id}" 
                                            target="_blank" 
                                            class="px-2.5 py-1 rounded bg-brand-600 hover:bg-brand-700 text-white text-[11px] font-bold inline-flex items-center gap-1 shadow-2xs transition-colors"
                                            title="Abrir este ticket completo en pestaña nueva"
                                        >
                                            <span>Abrir Ticket</span>
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                                        </a>
                                    </div>
                                </div>
                                <button 
                                    type="button" 
                                    onclick="descartarAlertaTicketAdmin(${t.id}, event)" 
                                    title="Quitar esta notificación de la lista" 
                                    class="text-slate-400 hover:text-red-600 p-1.5 rounded hover:bg-red-50 text-xs font-bold cursor-pointer transition-colors"
                                >
                                    ✕
                                </button>
                            </div>
                        `;
                    });

                    // 2. Renderizar cada mensaje no leído
                    mensajesNoLeidosActivos.forEach(m => {
                        htmlItems += `
                            <div class="p-3 bg-sky-50/60 hover:bg-sky-50 border-l-4 border-sky-500 flex items-start justify-between gap-2.5 transition-colors">
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-1.5 flex-wrap">
                                        <span class="px-1.5 py-0.2 rounded text-[9px] font-extrabold bg-sky-600 text-white">MENSAJE CHAT</span>
                                        <span class="text-[10px] font-bold text-sky-800">Ticket #${m.ticket_id}</span>
                                    </div>
                                    <div class="font-bold text-slate-900 text-xs mt-1 truncate">
                                        ${escaparHtmlSimple(m.autor_nombre)}
                                    </div>
                                    <div class="text-[11px] text-slate-600 line-clamp-2 italic mt-0.5">
                                        "${escaparHtmlSimple(m.mensaje || 'Archivo o evidencia adjunta')}"
                                    </div>
                                    <div class="mt-2 flex items-center gap-2">
                                        <button 
                                            type="button" 
                                            onclick="abrirChatTicketAdmin('${m.ticket_id}'); descartarAlertaMensajeAdmin('${m.ticket_id}', event);" 
                                            class="px-2.5 py-1 rounded bg-sky-600 hover:bg-sky-700 text-white text-[11px] font-bold cursor-pointer shadow-2xs transition-colors"
                                        >
                                            Responder Chat
                                        </button>
                                        <a 
                                            href="/admin/tickets/${m.ticket_id}" 
                                            target="_blank" 
                                            class="px-2 py-1 rounded bg-slate-200 hover:bg-slate-300 text-slate-700 text-[11px] font-bold inline-flex items-center gap-1 transition-colors"
                                        >
                                            Abrir
                                        </a>
                                    </div>
                                </div>
                                <button 
                                    type="button" 
                                    onclick="descartarAlertaMensajeAdmin('${m.ticket_id}', event)" 
                                    title="Quitar esta notificación de la lista" 
                                    class="text-slate-400 hover:text-red-600 p-1.5 rounded hover:bg-red-50 text-xs font-bold cursor-pointer transition-colors"
                                >
                                    ✕
                                </button>
                            </div>
                        `;
                    });

                    if (!htmlItems) {
                        htmlItems = `
                            <div class="p-6 text-center text-slate-400">
                                
                                <div class="font-semibold text-slate-600">Todo al día</div>
                                <div class="text-[11px] text-slate-400 mt-0.5">No hay alertas ni tickets pendientes en este momento.</div>
                            </div>
                        `;
                    }

                    lista.innerHTML = htmlItems;
                }
            } catch (e) {
                console.error('Error al verificar alertas en vivo:', e);
            }
        }

        // ==========================================
        // COMUNICACIÓN EN TIEMPO REAL CON WEBSOCKETS (SOCKET.IO)
        // ==========================================
        function actualizarEstatusTicketEnTabla(data) {
            if (!data || !data.ticket_id) return;
            const ticketId = data.ticket_id;
            const nuevoEst = data.estatus;

            // 1. Actualizar celda de estatus
            const celda = document.getElementById('celdaEstatusTicket-' + ticketId);
            if (celda) {
                let badgeHtml = '';
                if (nuevoEst === 'Nuevo ticket') {
                    badgeHtml = '<div class="flex items-center gap-1.5"><span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-sky-50 text-sky-700 border border-sky-200"><span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>Nuevo ticket</span></div>';
                } else if (nuevoEst === 'En proceso') {
                    badgeHtml = '<div class="flex items-center gap-1.5"><span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>En proceso</span></div>';
                } else if (nuevoEst === 'Pendiente') {
                    badgeHtml = '<div class="flex items-center gap-1.5"><span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Pendiente</span></div>';
                } else if (nuevoEst === 'Pendiente por cliente') {
                    let infoExtra = '';
                    if (data.fecha_programada_cliente) {
                        infoExtra += `<div class="text-[10px] font-bold text-orange-950 bg-orange-50 border border-orange-200 px-1.5 py-0.5 rounded flex items-center gap-1 mt-1"><span>Cita:</span> ${data.fecha_programada_cliente}</div>`;
                    }
                    if (data.motivo_pendiente_cliente) {
                        infoExtra += `<div class="text-[10px] text-slate-500 italic max-w-[160px] truncate mt-0.5" title="${escaparHtmlSimple(data.motivo_pendiente_cliente)}">"${escaparHtmlSimple(data.motivo_pendiente_cliente)}"</div>`;
                    }
                    badgeHtml = `<div class="space-y-1"><span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-orange-100 text-orange-800 border border-orange-300 shadow-2xs">Pendiente por cliente</span>${infoExtra}</div>`;
                } else if (nuevoEst === 'Resuelto') {
                    badgeHtml = '<div class="flex items-center gap-1.5"><span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Resuelto</span></div>';
                } else {
                    badgeHtml = `<div class="flex items-center gap-1.5"><span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700">${escaparHtmlSimple(nuevoEst)}</span></div>`;
                }
                celda.innerHTML = badgeHtml;
            }

            // 2. Actualizar el selector <select> de la fila
            const sel = document.getElementById('selectEstatusFila-' + ticketId) || document.querySelector(`.select-estatus-ticket[data-ticket-id="${ticketId}"]`);
            if (sel) {
                sel.value = nuevoEst;
                sel.dataset.originalStatus = nuevoEst;
                if (data.fecha_programada_cliente) sel.dataset.fechaProgramada = data.fecha_programada_cliente;
                if (data.motivo_pendiente_cliente) sel.dataset.motivoPendiente = data.motivo_pendiente_cliente;

                sel.className = 'select-estatus-ticket w-full max-w-[155px] rounded border px-2 py-1 text-xs font-bold focus:outline-none focus:ring-1 focus:ring-brand-500 cursor-pointer transition-all shadow-2xs ' +
                    (nuevoEst === 'Nuevo ticket' ? 'bg-sky-50 text-sky-700 border-sky-300' :
                     nuevoEst === 'Pendiente' ? 'bg-rose-50 text-rose-700 border-rose-300' :
                     nuevoEst === 'Pendiente por cliente' ? 'bg-orange-50 text-orange-800 border-orange-300' :
                     nuevoEst === 'En proceso' ? 'bg-amber-50 text-amber-700 border-amber-300' :
                     nuevoEst === 'Resuelto' ? 'bg-emerald-50 text-emerald-700 border-emerald-300' : 'bg-white text-slate-800 border-slate-300');
            }

            // 3. Efecto flash visual en la fila
            const fila = document.getElementById('filaTicket-' + ticketId);
            if (fila) {
                fila.classList.add('bg-amber-100/60');
                setTimeout(() => fila.classList.remove('bg-amber-100/60'), 2500);
            }

            // 4. Refrescar widget de citas programadas
            verificarNotificacionesLiveAdmin();
        }

        // ==========================================
        // SINCRONIZACIÓN AUTOMÁTICA EN TIEMPO REAL (ADMINISTRADOR)
        // ==========================================
        let sincronizandoTableroAdmin = false;
        async function refrescarTableroAdminEnVivo() {
            if (sincronizandoTableroAdmin) return;
            // No interrumpir si hay un modal abierto o si el admin está escribiendo en un formulario
            const modalAbierto = document.querySelector('.modal[style*="display: block"]') || 
                                 document.querySelector('.modal:not([style*="display: none"])[style*="display"]');
            const inputActivo = document.activeElement && 
                                (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA') && 
                                document.activeElement.id !== 'buscarTicketsAdmin';
            if (modalAbierto || inputActivo) return;

            sincronizandoTableroAdmin = true;
            try {
                const resp = await fetch(window.location.href, { 
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    cache: 'no-store' 
                });
                if (!resp.ok) return;
                const html = await resp.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');

                // 1. Actualizar contenedor de la tabla de tickets
                const nuevoContTabla = doc.getElementById('contenedorTablaTicketsAdmin');
                const contTablaActual = document.getElementById('contenedorTablaTicketsAdmin');
                if (nuevoContTabla && contTablaActual) {
                    contTablaActual.innerHTML = nuevoContTabla.innerHTML;
                }

                // 2. Actualizar clasificadores de estatus
                const nuevoClasif = doc.getElementById('clasificadorEstatusAdmin');
                const clasifActual = document.getElementById('clasificadorEstatusAdmin');
                if (nuevoClasif && clasifActual) {
                    clasifActual.innerHTML = nuevoClasif.innerHTML;
                }

                // 3. Actualizar contador visible
                const nuevoContador = doc.getElementById('contadorTicketsVisibles');
                const contadorActual = document.getElementById('contadorTicketsVisibles');
                if (nuevoContador && contadorActual) {
                    contadorActual.innerHTML = nuevoContador.innerHTML;
                }

                // 4. Actualizar citas programadas del sidebar
                const nuevasCitas = doc.getElementById('contenedorCitasSidebar');
                const citasActual = document.getElementById('contenedorCitasSidebar');
                if (nuevasCitas && citasActual) {
                    citasActual.innerHTML = nuevasCitas.innerHTML;
                }

                // 5. Re-aplicar filtros activos que el admin tenga seleccionados
                if (typeof filtrarTablaTicketsAdmin === 'function') {
                    filtrarTablaTicketsAdmin();
                }
            } catch (err) {
                console.warn('Error sincronizando tablero admin en vivo:', err);
            } finally {
                sincronizandoTableroAdmin = false;
            }
        }

        let socketAdmin = null;
        function inicializarSocketsAdmin() {
            if (typeof io === 'undefined') {
                console.warn('[WebSocket Admin] io no está disponible aún');
                return;
            }
            try {
                socketAdmin = io({
                    transports: ['websocket', 'polling'],
                    reconnection: true,
                    reconnectionAttempts: Infinity,
                    reconnectionDelay: 1000,
                    reconnectionDelayMax: 5000,
                    timeout: 20000
                });

                socketAdmin.on('connect', function() {
                    console.log('[WebSocket Admin] Conectado en tiempo real al servidor');
                    refrescarTableroAdminEnVivo();
                    verificarNotificacionesLiveAdmin();
                });

                // 1. NUEVO TICKET EN TIEMPO REAL
                socketAdmin.on('ticket:nuevo', function(data) {
                    refrescarTableroAdminEnVivo();
                    if (!data || !data.ticket) return;
                    const t = data.ticket;
                    const descartados = obtenerTicketsDescartados();
                    if (descartados.includes(Number(t.id))) return;

                    ultimoTicketIdConocido = Number(t.id);

                    if (!yaFueNotificadoRecientemente('ticket_nuevo_' + t.id, 8000)) {
                        reproducirSonidoAlertaAdmin('ticket');
                        mostrarToastNotificacionAdmin(
                            `Ticket #${t.id}: ${t.titulo}`,
                            `Solicitante: ${t.usuario_nombre || 'Usuario'} (${t.prioridad || 'Media'})`,
                            t.id,
                            'ticket'
                        );
                        dispararNotificacionEscritorioAdmin(
                            `Nuevo Ticket #${t.id} - ${t.prioridad || 'Media'}`,
                            `${t.usuario_nombre || 'Usuario'}: ${t.titulo}`,
                            t.id,
                            'ticket'
                        );
                    }

                    verificarNotificacionesLiveAdmin();
                });

                // 2. CAMBIOS GLOBALES EN TICKETS
                socketAdmin.on('ticket:cambio_global', function() {
                    refrescarTableroAdminEnVivo();
                    verificarNotificacionesLiveAdmin();
                });

                // 3. NUEVO MENSAJE DE CHAT EN TIEMPO REAL
                socketAdmin.on('comentario:nuevo', function(data) {
                    if (!data || !data.comentario) return;
                    const c = data.comentario;
                    const tId = data.ticketId;

                    ultimoComentarioIdConocido = Number(c.id);

                    // Si este ticket está abierto en el modal de chat, recargar inmediatamente
                    if (chatAdminTicketActivo && Number(chatAdminTicketActivo) === Number(tId)) {
                        cargarMensajesChatAdmin(tId, false);
                    }

                    // Si fue enviado por un usuario solicitante, alertar con sonido y notificación
                    if (c.autor_rol !== 'admin') {
                        if (!yaFueNotificadoRecientemente('chat_msg_' + c.id, 8000)) {
                            reproducirSonidoAlertaAdmin('chat');
                            mostrarToastNotificacionAdmin(
                                `Ticket #${tId} — ${c.autor_nombre}`,
                                c.mensaje || 'Envió un archivo o evidencia adjunta',
                                tId,
                                'chat'
                            );
                            dispararNotificacionEscritorioAdmin(
                                `Nuevo mensaje en Ticket #${tId}`,
                                `${c.autor_nombre}: ${c.mensaje || 'Envió un adjunto'}`,
                                tId,
                                'chat'
                            );
                        }

                        // Actualizar badge en la fila
                        const badgeFila = document.getElementById('badgeChatAdminTicket-' + tId);
                        if (badgeFila) {
                            const actual = parseInt(badgeFila.textContent || '0', 10) + 1;
                            badgeFila.textContent = actual;
                            badgeFila.style.display = '';
                        }

                        verificarNotificacionesLiveAdmin();
                    }
                });

                // 4. CAMBIO DE ESTATUS EN TIEMPO REAL
                socketAdmin.on('ticket:estatus_cambiado', function(data) {
                    refrescarTableroAdminEnVivo();
                    if (data) actualizarEstatusTicketEnTabla(data);
                    verificarNotificacionesLiveAdmin();
                });

                // 5. RECLASIFICACIÓN DE CATEGORÍA EN TIEMPO REAL
                socketAdmin.on('ticket:categoria_actualizada', function() {
                    refrescarTableroAdminEnVivo();
                });

                // 6. EDICIÓN O ELIMINACIÓN DE COMENTARIOS EN TIEMPO REAL
                socketAdmin.on('comentario:editado', function(data) {
                    if (chatAdminTicketActivo && Number(chatAdminTicketActivo) === Number(data.ticketId)) {
                        cargarMensajesChatAdmin(data.ticketId, false);
                    }
                });
                socketAdmin.on('comentario:eliminado', function(data) {
                    if (chatAdminTicketActivo && Number(chatAdminTicketActivo) === Number(data.ticketId)) {
                        cargarMensajesChatAdmin(data.ticketId, false);
                    }
                });

                // 7. CITAS, EDICIÓN Y ELIMINACIÓN EN TIEMPO REAL
                socketAdmin.on('ticket:cita_actualizada', function() {
                    refrescarTableroAdminEnVivo();
                    verificarNotificacionesLiveAdmin();
                });
                socketAdmin.on('ticket:editado', function() {
                    refrescarTableroAdminEnVivo();
                });
                socketAdmin.on('ticket:eliminado', function() {
                    refrescarTableroAdminEnVivo();
                    verificarNotificacionesLiveAdmin();
                });
                socketAdmin.on('recordatorio:nuevo', function() {
                    verificarNotificacionesLiveAdmin();
                });
                socketAdmin.on('recordatorio:actualizado', function() {
                    verificarNotificacionesLiveAdmin();
                });
                socketAdmin.on('recordatorio:eliminado', function() {
                    verificarNotificacionesLiveAdmin();
                });
            } catch(e) {
                console.warn('Error inicializando WebSocket Admin:', e);
            }
        }

        // Interceptar formularios de modales para actualizar estatus sin recargar la página
        document.addEventListener('DOMContentLoaded', function() {
            const fPendiente = document.getElementById('formModalPendienteCliente');
            if (fPendiente) {
                fPendiente.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const fd = new FormData(fPendiente);
                    fd.append('formato', 'json');
                    fetch('/admin/tickets/cambiar-estatus', {
                        method: 'POST',
                        headers: { 'Accept': 'application/json' },
                        body: fd
                    })
                    .then(r => r.json())
                    .then(data => {
                        cerrarModalPendienteCliente();
                        if (data && data.ok) {
                            actualizarEstatusTicketEnTabla(data);
                            refrescarTableroAdminEnVivo();
                        }
                    })
                    .catch(() => fPendiente.submit());
                });
            }

            const fResolucion = document.getElementById('formModalResolucion');
            if (fResolucion) {
                fResolucion.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const fd = new FormData(fResolucion);
                    fd.append('formato', 'json');
                    fetch('/admin/tickets/cambiar-estatus', {
                        method: 'POST',
                        headers: { 'Accept': 'application/json' },
                        body: fd
                    })
                    .then(r => r.json())
                    .then(data => {
                        cerrarModalResolucion();
                        if (data && data.ok) {
                            actualizarEstatusTicketEnTabla(data);
                            refrescarTableroAdminEnVivo();
                        }
                    })
                    .catch(() => fResolucion.submit());
                });
            }
        });

        function iniciarMonitoreoNotificacionesAdmin() {
            actualizarBotonSonidoAdminUI();
            actualizarBotonNotifEscritorioAdminUI();
            inicializarSocketsAdmin();
            verificarNotificacionesLiveAdmin();
            // Sincronización continua de respaldo (cada 5s) para asegurar actualización en todas las computadoras
            setInterval(refrescarTableroAdminEnVivo, 5000);
            setInterval(verificarNotificacionesLiveAdmin, 15000);
        }
    </script>

</body>
</html>