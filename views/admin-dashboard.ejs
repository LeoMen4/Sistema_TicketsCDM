                <span id="chatAdminInfoEntregado"><strong>Entrega/Cierre:</strong> Pendiente</span>
            </div>

            <!-- Contenedor de Mensajes -->
            <div id="contenedorMensajesChatAdmin" class="p-4 bg-slate-50 h-80 overflow-y-auto space-y-3">
                <div class="text-center text-xs text-slate-400 py-10 italic">Cargando conversación...</div>
            </div>

            <!-- Formulario para Enviar Mensaje / Captura -->
            <form id="formEnviarChatAdmin" onsubmit="enviarMensajeChatAdmin(event)" class="p-4 bg-white border-t border-slate-200 space-y-2.5">
                <input type="hidden" id="chatAdminTicketId" value="">
                
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <label class="text-[11px] font-bold text-slate-600">Tipo de registro:</label>
                        <select 
                            id="chatAdminTipoIntervencion" 
                            class="rounded border border-slate-300 px-2 py-1 text-[11px] font-semibold text-slate-800 bg-white focus:border-brand-600 focus:outline-none"
                        >
                            <option value="comentario">Mensaje / Respuesta al Usuario</option>
                            <option value="diagnostico">Nota de Diagnóstico / Revisión</option>
                            <option value="avance">Avance Técnico de Sistemas</option>
                            <option value="entrega">Nota de Entrega / Validación</option>
                        </select>
                    </div>

                    <label class="inline-flex items-center gap-1.5 text-[11px] font-bold text-brand-600 hover:text-brand-800 cursor-pointer">
                        <span>Adjuntar captura o foto</span>
                        <input type="file" id="chatAdminInputImagen" accept="image/*" class="hidden" onchange="manejarSeleccionImagenChatAdmin(event)">
                        <span id="chatAdminNombreImagen" class="text-[10px] text-slate-500 font-normal"></span>
                    </label>
                </div>

                <!-- Vista previa de imagen adjunta con botón para quitarla antes de enviar -->
                <div id="chatAdminPreviewContenedor" style="display: none;" class="p-2.5 bg-slate-100 rounded-md border border-slate-200 flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2.5 overflow-hidden">
                        <img id="chatAdminImgPreview" src="" alt="Vista previa" class="w-12 h-12 object-cover rounded border border-slate-300 bg-white shadow-2xs">
                        <div class="text-[11px] min-w-0">
                            <span id="chatAdminNombreImagenPreview" class="font-bold text-slate-800 block truncate max-w-xs"></span>
                            <span id="chatAdminSizeImagenPreview" class="text-slate-500 text-[10px]"></span>
                        </div>
                    </div>
                    <button 
                        type="button" 
                        onclick="quitarImagenAdjuntaChatAdmin()" 
                        class="px-2.5 py-1 text-xs font-bold text-red-600 hover:text-white bg-red-50 hover:bg-red-600 rounded border border-red-200 transition-colors cursor-pointer whitespace-nowrap shadow-2xs"
                        title="Quitar esta imagen antes de enviar"
                    >
                        ✕ Quitar imagen
                    </button>
                </div>

                <div class="flex gap-2">
                    <textarea 
                        id="chatAdminInputMensaje" 
                        rows="2" 
                        placeholder="Escribe una indicación remota para el usuario o registra un avance..."
                        class="flex-1 rounded-md border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none resize-none"
                    ></textarea>
                    <button 
                        type="submit" 
                        id="btnSubmitChatAdmin"
                        class="px-4 py-2 rounded-md text-xs font-extrabold text-white bg-brand-600 hover:bg-brand-700 transition-all shadow-xs cursor-pointer self-end flex items-center gap-1.5"
                    >
                        <span>Enviar</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

