    <!-- SCRIPTS DE INTERACCIÓN Y NAVEGACIÓN LATERAL -->
    <script>
        // Función para cambiar de módulo desde el menú lateral
        function cambiarModuloAdmin(moduloKey) {
            const modulos = ['tickets', 'crear-ticket', 'guias', 'categorias', 'usuarios', 'equipos', 'crear-usuario', 'papelera', 'correo', 'discord'];
            
            modulos.forEach(m => {
                const sec = document.getElementById('modulo-' + m);
                const btn = document.getElementById('btn-nav-' + m);
                if (sec) {
                    sec.style.display = (m === moduloKey) ? 'block' : 'none';
                }
                if (btn) {
                    if (m === moduloKey) {
                        btn.classList.add('active');
                        btn.classList.remove('text-slate-700');
                    } else {
                        btn.classList.remove('active');
                        btn.classList.add('text-slate-700');
                    }
                }
            });

            // Guardar en hash de URL y localStorage
            try {
                window.location.hash = moduloKey;
                localStorage.setItem('admin_modulo_activo', moduloKey);
            } catch (e) {}
        }

        // Determinar qué módulo abrir al cargar
        window.addEventListener('DOMContentLoaded', () => {
            let moduloInicial = 'tickets'; // Por defecto siempre el sistema de tickets

            const hash = window.location.hash ? window.location.hash.replace('#', '') : '';
            const guardado = localStorage.getItem('admin_modulo_activo');
            const modulosValidos = ['tickets', 'crear-ticket', 'guias', 'categorias', 'usuarios', 'equipos', 'crear-usuario', 'papelera', 'correo', 'discord'];

            if (hash && modulosValidos.includes(hash)) {
                moduloInicial = hash;
            } else if (guardado && modulosValidos.includes(guardado)) {
                moduloInicial = guardado;
            }

            <% if (error) { %>
                const errTexto = <%- JSON.stringify(error) %>;
                if (errTexto.includes('papelera') || errTexto.includes('recuperar') || errTexto.includes('restaurar') || errTexto.includes('definitivo')) {
                    moduloInicial = 'papelera';
                } else if (errTexto.includes('Guía') || errTexto.includes('guía')) {
                    moduloInicial = 'guias';
                } else if (errTexto.includes('Outlook') || errTexto.includes('plantilla') || errTexto.includes('SMTP') || (errTexto.includes('correo') && !errTexto.includes('registrado'))) {
                    moduloInicial = 'correo';
                } else if (errTexto.includes('equipo') || errTexto.includes('componente') || errTexto.includes('periférico')) {
                    moduloInicial = 'equipos';
                } else if (errTexto.includes('categoría') || errTexto.includes('subcategoría')) {
                    moduloInicial = 'categorias';
                } else if (errTexto.includes('solicitante') || errTexto.includes('levantar')) {
                    moduloInicial = 'crear-ticket';
                } else if (errTexto.includes('usuario') || errTexto.includes('contraseña')) {
                    moduloInicial = 'crear-usuario';
                } else {
                    moduloInicial = 'tickets';
                }
            <% } %>

            <% if (mensaje) { %>
                const msgTexto = <%- JSON.stringify(mensaje) %>;
                if (msgTexto.includes('papelera') || msgTexto.includes('recuperado') || msgTexto.includes('restaurado') || msgTexto.includes('definitivamente')) {
                    moduloInicial = 'papelera';
                    if (msgTexto.toLowerCase().includes('ticket')) {
                        setTimeout(() => mostrarSubtabPapelera('tickets'), 60);
                    } else if (msgTexto.toLowerCase().includes('usuario')) {
                        setTimeout(() => mostrarSubtabPapelera('usuarios'), 60);
                    }
                } else if (msgTexto.includes('Guía') || msgTexto.includes('guía')) {
                    moduloInicial = 'guias';
                } else if (msgTexto.includes('Outlook') || msgTexto.includes('correo') || msgTexto.includes('Plantilla') || msgTexto.includes('plantilla') || msgTexto.includes('prueba')) {
                    moduloInicial = 'correo';
                } else if (msgTexto.includes('Componente') || msgTexto.includes('componente') || msgTexto.includes('equipo') || msgTexto.includes('inventario')) {
                    moduloInicial = 'equipos';
                } else if (msgTexto.includes('Avance') || msgTexto.includes('avance') || msgTexto.includes('Estatus') || msgTexto.includes('estatus')) {
                    moduloInicial = 'tickets';
                } else if (msgTexto.includes('levantado exitosamente') || msgTexto.includes('levantado para el usuario')) {
                    moduloInicial = 'crear-ticket';
                } else if (msgTexto.includes('categoría') || msgTexto.includes('subcategoría')) {
                    moduloInicial = 'categorias';
                } else if (msgTexto.includes('Usuario') || msgTexto.includes('usuario')) {
                    moduloInicial = 'usuarios';
                } else {
                    moduloInicial = 'tickets';
                }
            <% } %>

            cambiarModuloAdmin(moduloInicial);
            iniciarMonitoreoNotificacionesAdmin();
        });

        function togglePass(id) {
            const hidden = document.getElementById('pass-hidden-' + id);
            const shown = document.getElementById('pass-shown-' + id);
            hidden.style.display = hidden.style.display === 'none' ? 'inline' : 'none';
            shown.style.display = shown.style.display === 'none' ? 'inline' : 'none';
        }

        function toggleDetalles(id) {
            const box = document.getElementById('detalles-' + id);
            box.style.display = (box.style.display === 'block') ? 'none' : 'block';
        }

        let selectEstatusPendiente = null;

        function manejarCambioSelectEstatus(select) {
            const nuevoEstatus = select.value;
            const ticketId = select.dataset.ticketId;
            const btnFila = document.getElementById('btnGuardarFila-' + ticketId);

            if (nuevoEstatus === 'Resuelto') {
                if (btnFila) btnFila.style.display = 'none';
                selectEstatusPendiente = select;
                document.getElementById('idTicketResolucion').value = ticketId;
                const inputAtendido = document.getElementById('inputAtendidoPorResolucion');
                if (inputAtendido) {
                    inputAtendido.value = select.dataset.atendidoPor || '';
                }
                document.getElementById('modalResolucion').style.display = 'block';
                evaluarCategoriaResolucion();
                return;
            }

            if (nuevoEstatus === 'Pendiente por cliente') {
                if (btnFila) btnFila.style.display = 'none';
                selectEstatusPendiente = select;
                const inId = document.getElementById('idTicketPendienteCliente');
                if (inId) inId.value = ticketId;
                const inFecha = document.getElementById('inputFechaProgramadaCliente');
                if (inFecha) inFecha.value = select.dataset.fechaProgramada || '';
                const inMotivo = document.getElementById('inputMotivoPendienteCliente');
                if (inMotivo) inMotivo.value = select.dataset.motivoPendiente || '';
                const modal = document.getElementById('modalPendienteCliente');
                if (modal) modal.style.display = 'block';
                return;
            }

            if (btnFila) {
                if (nuevoEstatus !== select.dataset.originalStatus) {
                    btnFila.style.display = 'inline-flex';
                } else {
                    btnFila.style.display = 'none';
                }
            }

            actualizarVisualizacionCambios();
        }

        function guardarEstatusTicketFila(ticketId) {
            const sel = document.querySelector(`.select-estatus-ticket[data-ticket-id="${ticketId}"]`);
            if (!sel) return;
            const nuevoEstatus = sel.value;
            if (nuevoEstatus === sel.dataset.originalStatus) return;

            if (nuevoEstatus === 'Resuelto' || nuevoEstatus === 'Pendiente por cliente') {
                manejarCambioSelectEstatus(sel);
                return;
            }

            const btnFila = document.getElementById('btnGuardarFila-' + ticketId);
            if (btnFila) {
                btnFila.disabled = true;
                btnFila.innerHTML = '<span>⏳ Guardando...</span>';
            }

            const params = new URLSearchParams();
            params.append('ticket_id', ticketId);
            params.append('estatus', nuevoEstatus);
            params.append('formato', 'json');

            fetch('/admin/tickets/cambiar-estatus', {
                method: 'POST',
                headers: { 'Accept': 'application/json' },
                body: params
            })
            .then(r => r.json())
            .then(data => {
                if (btnFila) {
                    btnFila.disabled = false;
                    btnFila.innerHTML = '<span>Guardar</span>';
                    btnFila.style.display = 'none';
                }
                if (data && data.ok) {
                    actualizarEstatusTicketEnTabla(data);
                } else {
                    alert(data?.error || 'Error al actualizar el estatus');
                }
            })
            .catch(err => {
                console.error(err);
                if (btnFila) {
                    btnFila.disabled = false;
                    btnFila.innerHTML = '<span>Guardar</span>';
                }
            });
        }

        function evaluarCategoriaResolucion() {
            const cat = document.getElementById('categoriaResolucionSelect').value;
            const campos = document.getElementById('camposReemplazo');
            const tipoInput = document.getElementById('inputTipoNuevo');
            const modelInput = document.getElementById('inputModeloNuevo');
            const serieInput = document.getElementById('inputSerieNueva');

            if (cat === 'Reemplazo') {
                campos.style.display = 'block';
                tipoInput.required = true;
                modelInput.required = true;
                serieInput.required = true;
            } else {
                campos.style.display = 'none';
                tipoInput.required = false;
                modelInput.required = false;
                serieInput.required = false;
            }
        }

        function cerrarModalPendienteCliente() {
            document.getElementById('modalPendienteCliente').style.display = 'none';
            if (selectEstatusPendiente) {
                const ticketId = selectEstatusPendiente.dataset.ticketId;
                const btnFila = document.getElementById('btnGuardarFila-' + ticketId);
                if (btnFila) btnFila.style.display = 'none';
                selectEstatusPendiente.value = selectEstatusPendiente.dataset.originalStatus;
                selectEstatusPendiente = null;
                actualizarVisualizacionCambios();
            }
        }

        function cerrarModalResolucion() {
            document.getElementById('modalResolucion').style.display = 'none';
            if (selectEstatusPendiente) {
                const ticketId = selectEstatusPendiente.dataset.ticketId;
                const btnFila = document.getElementById('btnGuardarFila-' + ticketId);
                if (btnFila) btnFila.style.display = 'none';
                selectEstatusPendiente.value = selectEstatusPendiente.dataset.originalStatus;
                selectEstatusPendiente = null;
                actualizarVisualizacionCambios();
            }
        }

        function actualizarVisualizacionCambios() {
            const selects = document.querySelectorAll('.select-estatus-ticket');
            let cambiosCount = 0;

            selects.forEach(sel => {
                const ticketId = sel.dataset.ticketId;
                const btnFila = document.getElementById('btnGuardarFila-' + ticketId);
                if (sel.value !== sel.dataset.originalStatus) {
                    cambiosCount++;
                    sel.style.borderColor = '#16a34a';
                    sel.style.backgroundColor = '#f0fdf4';
                    sel.style.fontWeight = 'bold';
                    if (btnFila) btnFila.style.display = 'inline-flex';
                } else {
                    sel.style.borderColor = '#cbd5e1';
                    sel.style.backgroundColor = 'white';
                    sel.style.fontWeight = 'normal';
                    if (btnFila) btnFila.style.display = 'none';
                }
            });

            const btn = document.getElementById('btnGuardarEstatusGlobal');
            if (btn) {
                if (cambiosCount > 0) {
                    btn.innerHTML = `<span>Guardar Cambios (${cambiosCount} pendiente${cambiosCount > 1 ? 's' : ''})</span>`;
                    btn.classList.remove('bg-brand-600', 'hover:bg-brand-700');
                    btn.classList.add('bg-emerald-600', 'hover:bg-emerald-700', 'ring-2', 'ring-emerald-400');
                } else {
                    btn.innerHTML = '<span>Guardar Cambios de Estatus</span>';
                    btn.classList.remove('bg-emerald-600', 'hover:bg-emerald-700', 'ring-2', 'ring-emerald-400');
                    btn.classList.add('bg-brand-600', 'hover:bg-brand-700');
                }
            }
        }

        function guardarTodosLosEstatus() {
            const selects = document.querySelectorAll('.select-estatus-ticket');
            const cambios = [];

            selects.forEach(sel => {
                if (sel.value !== sel.dataset.originalStatus) {
                    cambios.push({
                        id: sel.dataset.ticketId,
                        estatus: sel.value
                    });
                }
            });

            if (cambios.length === 0) {
                alert('ℹ️ No se han modificado estatus en los tickets de la tabla.\n\nPara guardar, cambia el estatus de uno o más tickets en la columna "Cambiar Estatus" y luego presiona este botón.');
                return;
            }

            const plural = cambios.length > 1 ? `los estatus de ${cambios.length} tickets` : `el estatus de 1 ticket`;
            if (!confirm(`¿Confirmas que deseas guardar ${plural}?`)) {
                return;
            }

            const btn = document.getElementById('btnGuardarEstatusGlobal');
            if (btn) {
                btn.disabled = true;
                btn.style.opacity = '0.7';
                btn.innerHTML = '<span>⏳ Guardando cambios...</span>';
            }

            document.getElementById('inputCambiosEstatus').value = JSON.stringify(cambios);
            document.getElementById('formGuardarEstatusGlobal').submit();
        }

        function toggleVerPassword(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const isPass = input.type === 'password';
            input.type = isPass ? 'text' : 'password';
            if (btn) {
                btn.textContent = isPass ? 'Ocultar' : 'Mostrar';
                btn.title = isPass ? 'Ocultar contraseña' : 'Ver contraseña';
            }
        }

        function cerrarAlerta(id) {
            const el = document.getElementById(id);
            if (el) {
                el.style.opacity = '0';
                el.style.transition = 'opacity 0.25s ease';
                setTimeout(() => { if (el) el.remove(); }, 250);
            }
        }

        // Auto cerrar alerta de éxito después de 8 segundos
        setTimeout(() => {
            cerrarAlerta('alertaMensajeExito');
        }, 8000);

        function abrirModalEliminarUsuarioDefinitivo(id, nombre, email) {
            document.getElementById('idUsuarioDefinitivo').value = id;
            document.getElementById('txtIdUsuarioDefinitivo').textContent = id;
            document.getElementById('txtNombreUsuarioDefinitivo').textContent = nombre;
            document.getElementById('txtEmailUsuarioDefinitivo').textContent = email;
            const pass = document.getElementById('passAdminEliminarUsuarioDefinitivo');
            if (pass) pass.value = '';
            document.getElementById('modalEliminarUsuarioDefinitivo').style.display = 'block';
        }

        function cerrarModalEliminarUsuarioDefinitivo() {
            document.getElementById('modalEliminarUsuarioDefinitivo').style.display = 'none';
        }

