        let chatAdminTicketActivo = null;
        let intervaloChatAdmin = null;
        let idMensajeEnEdicionAdmin = null;

        function escaparHtmlSimple(str) {
            return String(str || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

