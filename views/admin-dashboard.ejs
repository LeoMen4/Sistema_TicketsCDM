    <!-- MODAL PARA RESOLUCIÓN DE TICKET (CON BITÁCORA MULTI-ESPECIALISTA) -->
    <div id="modalResolucion" class="modal">
        <div class="modal-content" style="max-width: 540px; border-top: 4px solid #059669;">
            <div class="flex items-center gap-2 mb-3 border-b border-slate-100 pb-2.5">
                
                <div>
                    <h4 class="text-base font-bold text-slate-900 m-0">
                        Detalles de Resolución y Entrega de Ticket
                    </h4>
                    <p class="text-[11px] text-slate-500">Registra quién diagnosticó/avanzó el caso y quién realiza el cierre o entrega.</p>
                </div>
            </div>
            
            <form action="/admin/tickets/cambiar-estatus" method="POST" id="formModalResolucion" class="space-y-3.5">
                <input type="hidden" name="ticket_id" id="idTicketResolucion">
                <input type="hidden" name="estatus" value="Resuelto">

                <!-- Bitácora por etapas: Quién avanzó vs Quién entrega/resuelve -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 bg-slate-50 p-3 rounded border border-slate-200">
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">
                            Diagnosticó / Avanzó (Opcional):
                        </label>
                        <input 
                            type="text" 
                            name="atendido_por" 
                            id="inputAtendidoPorResolucion"
                            list="listaEspecialistasTI"
                            placeholder="Ej. quien inició revisión"
                            class="w-full rounded border border-slate-300 px-2.5 py-1.5 text-xs text-slate-900 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                        >
                        <span class="text-[10px] text-slate-400">Puedes separar varios nombres con coma</span>
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">
                            Entrega / Cierra Ticket <span class="text-brand-600">*</span>:
                        </label>
                        <input 
                            type="text" 
                            name="tecnico_resolvio" 
                            id="inputTecnicoResolvioModal"
                            list="listaEspecialistasTI"
                            value="<%= adminNombre %>" 
                            required
                            class="w-full rounded border border-slate-300 px-2.5 py-1.5 text-xs text-slate-900 bg-white focus:border-brand-600 focus:outline-none shadow-2xs font-semibold"
                        >
                    </div>
                </div>

                <datalist id="listaEspecialistasTI">
                    <% (typeof especialistasTI !== 'undefined' ? especialistasTI : []).forEach(esp => { %>
                        <option value="<%= esp.nombre %>"><%= esp.puesto || 'Sistemas TI' %></option>
                    <% }) %>
                </datalist>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                        Categoría de Resolución <span class="text-brand-600">*</span>:
                    </label>
                    <select 
                        name="categoria_resolucion" 
                        id="categoriaResolucionSelect" 
                        onchange="evaluarCategoriaResolucion()" 
                        required
                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none shadow-2xs bg-white"
                    >
                        <option value="Mantenimiento">Mantenimiento</option>
                        <option value="Cambio de pieza">Cambio de pieza</option>
                        <option value="Reemplazo">Reemplazo</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                        Comentario sobre la resolución:
                    </label>
                    <textarea 
                        name="comentario_resolucion" 
                        rows="3" 
                        placeholder="Procedimiento realizado para solucionar la incidencia..."
                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none shadow-2xs"
                    ></textarea>
                </div>

                <div id="camposReemplazo" style="display: none;" class="p-3 bg-emerald-50/70 border border-emerald-200 rounded space-y-2">
                    <span class="text-xs font-bold text-emerald-900 block">Datos del Equipo de Reemplazo:</span>
                    <div>
                        <label class="block text-[11px] font-semibold text-emerald-800">Tipo de equipo nuevo:</label>
                        <input type="text" name="tipo_equipo_nuevo" id="inputTipoNuevo" class="w-full rounded border border-slate-300 px-2 py-1 text-xs">
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-emerald-800">Modelo del equipo nuevo:</label>
                        <input type="text" name="modelo_nuevo" id="inputModeloNuevo" class="w-full rounded border border-slate-300 px-2 py-1 text-xs">
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-emerald-800">Número de Serie nuevo:</label>
                        <input type="text" name="numero_serie_nuevo" id="inputSerieNueva" class="w-full rounded border border-slate-300 px-2 py-1 text-xs">
                    </div>
                </div>

                <div class="modal-actions pt-2">
                    <button 
                        type="button" 
                        onclick="cerrarModalResolucion()" 
                        class="px-4 py-2 rounded text-xs font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 transition-colors cursor-pointer"
                    >
                        Cancelar
                    </button>
                    <button 
                        type="submit" 
                        class="px-4 py-2 rounded text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-colors shadow-xs cursor-pointer"
                    >
                        Guardar y Marcar Resuelto
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL PARA REGISTRAR AVANCE TÉCNICO / INTERVENCIÓN POR ETAPAS (OPCIÓN 5) -->
    <div id="modalRegistrarAvance" class="modal">
        <div class="modal-content" style="max-width: 500px; border-top: 4px solid #d97706;">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-3">
                <div>
                    <h4 class="text-base font-bold text-slate-900 m-0 flex items-center gap-2">
                        
                        <span>Registrar Avance / Intervención por Etapas</span>
                    </h4>
                    <p class="text-xs text-slate-500 mt-0.5" id="subtituloModalAvance">Ticket #</p>
                </div>
                <button type="button" onclick="cerrarModalRegistrarAvance()" class="text-slate-400 hover:text-slate-700 font-bold text-sm cursor-pointer">✕</button>
            </div>

            <form action="/admin/tickets/registrar-avance" method="POST" class="space-y-3.5">
                <input type="hidden" name="ticket_id" id="avanceTicketId">

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                        Especialista(s) que realiza(n) este avance <span class="text-brand-600">*</span>
                    </label>
                    <input 
                        type="text" 
                        name="especialista_nombre" 
                        id="avanceEspecialistaNombre"
                        list="listaEspecialistasTI"
                        value="<%= adminNombre %>" 
                        required
                        placeholder="Nombre del especialista de TI..."
                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 bg-white focus:border-brand-600 focus:outline-none shadow-2xs font-semibold"
                    >
                    <% if (typeof especialistasTI !== 'undefined' && especialistasTI.length > 0) { %>
                        <div class="flex flex-wrap gap-1 mt-1.5">
                            <span class="text-[10px] text-slate-400 mr-1">Selección rápida:</span>
                            <% especialistasTI.forEach(esp => { %>
                                <button 
                                    type="button" 
                                    onclick="agregarEspecialistaInput('avanceEspecialistaNombre', '<%= esp.nombre.replace(/'/g, "\\'") %>')"
                                    class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 hover:bg-brand-50 text-slate-700 hover:text-brand-700 border border-slate-200 cursor-pointer"
                                >
                                    + <%= esp.nombre %>
                                </button>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                        Etapa de Intervención
                    </label>
                    <select 
                        name="etapa_accion" 
                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 bg-white focus:border-brand-600 focus:outline-none shadow-2xs font-semibold"
                    >
                        <option value="Diagnóstico y Revisión">Diagnóstico y Revisión Inicial</option>
                        <option value="Avance Técnico / Reparación">Avance Técnico / Reparación</option>
                        <option value="Soporte Remoto">Soporte Remoto al Usuario</option>
                        <option value="Pruebas y Validación">Pruebas y Validación de Equipo</option>
                        <option value="Espera de Pieza / Proveedor">⏳ Espera de Pieza / Proveedor</option>
                        <option value="Preparación para Entrega">Preparación para Entrega</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                        Detalle de lo realizado en esta etapa <span class="text-brand-600">*</span>
                    </label>
                    <textarea 
                        name="detalle_avance" 
                        rows="3" 
                        required
                        placeholder="Ej. Se revisó configuración de red y se respaldó información; queda listo para que otro compañero entregue el equipo..."
                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                    ></textarea>
                </div>

                <div class="modal-actions pt-2">
                    <button 
                        type="button" 
                        onclick="cerrarModalRegistrarAvance()" 
                        class="px-4 py-2 rounded text-xs font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 transition-colors cursor-pointer"
                    >
                        Cancelar
                    </button>
                    <button 
                        type="submit" 
                        class="px-4 py-2 rounded text-xs font-bold text-white bg-amber-600 hover:bg-amber-700 transition-colors shadow-xs cursor-pointer"
                    >
                        Guardar Avance en Bitácora
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL DE CHAT Y SEGUIMIENTO REMOTO (ADMIN ↔ USUARIO) -->
    <div id="modalChatAdmin" class="modal">
        <div class="modal-content" style="max-width: 650px; padding: 0; overflow: hidden; border-top: 4px solid #dc2626;">
            <!-- Header del Chat -->
            <div class="px-5 py-3.5 bg-slate-900 text-white flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        
                        <h4 class="text-sm font-extrabold m-0" id="chatAdminTituloTicket">Seguimiento Remoto - Ticket #</h4>
                        <span id="chatAdminEstatusBadge" class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-700 text-slate-200"></span>
                    </div>
                    <p class="text-[11px] text-slate-300 mt-0.5" id="chatAdminSubtituloParticipantes">
                        Comunicación directa en tiempo real con el usuario solicitante
                    </p>
                </div>
                <button type="button" onclick="cerrarChatTicketAdmin()" class="text-slate-400 hover:text-white text-base font-bold cursor-pointer">✕</button>
