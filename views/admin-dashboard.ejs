        async function solicitarPermisoNotificacionesEscritorioAdmin() {
            if (!('Notification' in window)) {
                alert('Este navegador web no soporta notificaciones de escritorio.');
                return;
            }

            if (Notification.permission === 'granted') {
                try {
                    const notif = new Notification('Alertas Windows del Sistema Activas', {
                        body: 'Las alertas de tickets y mensajes aparecerán aquí abajo a la derecha.',
                        icon: '/favicon.ico',
                        tag: 'test-sistema-tickets'
                    });
                    setTimeout(() => notif.close(), 6000);
                } catch (e) {}
                return;
            }

            if (Notification.permission === 'denied') {
                alert('Las notificaciones de escritorio están bloqueadas en este navegador para esta página.\n\nPara habilitarlas:\n1. Haga clic en el ícono de candado o configuración al inicio de la barra de direcciones (junto a la URL).\n2. En "Notificaciones", seleccione "Permitir".\n3. Recargue la página.');
                return;
            }

            try {
                const permiso = await Notification.requestPermission();
                actualizarBotonNotifEscritorioAdminUI();
                if (permiso === 'granted') {
                    const notif = new Notification(' ¡Alertas de Windows Activadas!', {
                        body: 'Recibirá avisos inmediatos en segundo plano cuando lleguen nuevos tickets o respuestas de usuarios.',
                        icon: '/favicon.ico',
                        tag: 'bienvenida-notif'
                    });
                    setTimeout(() => notif.close(), 6000);
                }
            } catch (e) {
                console.error('Error solicitando permisos de notificación:', e);
            }
        }

        // Candado global para evitar duplicar alertas entre pestañas y entre socket/polling
        function yaFueNotificadoRecientemente(clave, ttlMs = 8000) {
            try {
                const ahora = Date.now();
                const lockKey = 'notif_lock_' + clave;
                const ultimo = parseInt(localStorage.getItem(lockKey) || '0', 10);
                if (ahora - ultimo < ttlMs) {
                    return true;
                }
                localStorage.setItem(lockKey, String(ahora));
                return false;
            } catch(e) {
                return false;
            }
        }

        function dispararNotificacionEscritorioAdmin(titulo, cuerpo, ticketId, tipo) {
            if (!('Notification' in window) || Notification.permission !== 'granted') return;
            const claveNotif = ticketId + '_' + (tipo || 'alerta');
            if (yaFueNotificadoRecientemente('escritorio_' + claveNotif, 8000)) {
                return;
            }
            try {
                const notif = new Notification(titulo, {
                    body: cuerpo,
                    icon: '/favicon.ico',
                    tag: 'ticket-' + ticketId + '-' + (tipo || 'alerta'), // Tag limpio para deduplicación nativa de Windows
                    requireInteraction: false
                });

                notif.onclick = function() {
                    try { window.focus(); } catch (e) {}
                    window.open('/admin/tickets/' + ticketId, '_blank');
                    this.close();
                };

                setTimeout(() => {
                    try { notif.close(); } catch(e) {}
                }, 8000);
            } catch (e) {
                console.error('Error lanzando notificación nativa:', e);
            }
        }

