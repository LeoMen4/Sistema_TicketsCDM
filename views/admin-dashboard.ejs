    <!-- MODAL PARA CAMBIO A 'PENDIENTE POR CLIENTE' (CON CONTEO PAUSADO Y CITA PROGRAMADA) -->
    <div id="modalPendienteCliente" class="modal" style="display: none;">
        <div class="modal-content" style="max-width: 520px; border-top: 4px solid #f59e0b;">
            <div class="flex items-center gap-2.5 mb-3 border-b border-slate-100 pb-2.5">
                <span class="text-2xl">⏳</span>
                <div>
                    <h4 class="text-base font-bold text-slate-900 m-0">
                        Pausar Ticket: Pendiente por Cliente
                    </h4>
                    <p class="text-[11px] text-slate-500">Pausa el conteo del tiempo de resolución mientras se espera disponibilidad del usuario.</p>
                </div>
            </div>
            
            <form action="/admin/tickets/cambiar-estatus" method="POST" id="formModalPendienteCliente" class="space-y-4">
                <input type="hidden" name="ticket_id" id="idTicketPendienteCliente">
                <input type="hidden" name="estatus" value="Pendiente por cliente">

                <div class="bg-amber-50 border border-amber-200 rounded-md p-3 text-xs text-amber-900 space-y-1">
                    <div class="font-bold flex items-center gap-1.5">
                        <span>Medición de tiempos pausada</span>
                    </div>
                    <p class="text-[11px] leading-relaxed text-amber-800">
                        Los días o momentos que el ticket permanezca en este estatus <strong>no contarán en los gráficos ni afectarán el cumplimiento de SLA</strong>.
                    </p>
                </div>

                <!-- 1. Fecha y hora programada de contacto / visita -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                        Fecha y hora programada de visita / contacto (Opcional):
                    </label>
                    <input 
                        type="datetime-local" 
                        name="fecha_programada_cliente" 
                        id="inputFechaProgramadaCliente"
                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 bg-white focus:border-amber-600 focus:outline-none shadow-2xs font-bold"
                    >
                    <span class="text-[10px] text-slate-500 block mt-1">
                        Si programas una fecha, el sistema te mostrará una alerta destacada ese día en la barra superior para recordarte la cita.
                    </span>
                </div>

                <!-- 2. Motivo o breve descripción -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                        Motivo / Breve descripción (Opcional):
                    </label>
                    <textarea 
                        name="motivo_pendiente_cliente" 
                        id="inputMotivoPendienteCliente"
                        rows="2"
                        placeholder="Ej. El usuario estará disponible el día 2 de octubre a las 3:00 pm para revisión física."
                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 bg-white focus:border-amber-600 focus:outline-none shadow-2xs"
                    ></textarea>
                </div>

                <div class="modal-actions pt-2 flex items-center justify-end gap-2">
                    <button 
                        type="button" 
                        onclick="cerrarModalPendienteCliente()" 
                        class="px-4 py-2 rounded text-xs font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 transition-colors cursor-pointer"
                    >
                        Cancelar
                    </button>
                    <button 
                        type="submit" 
                        class="px-4 py-2 rounded text-xs font-bold text-white bg-amber-600 hover:bg-amber-700 transition-colors shadow-xs cursor-pointer flex items-center gap-1.5"
                    >
                        <span>Guardar y Pausar Ticket</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

