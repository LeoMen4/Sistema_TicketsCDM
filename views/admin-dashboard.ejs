        // ==========================================
        // BUSCADOR INTELIGENTE PARA SELECTORES DE USUARIO
        // ==========================================
        function asegurarCacheOpcionesSelect(selectEl) {
            if (!selectEl) return;
            if (!selectEl._opcionesOriginales) {
                selectEl._opcionesOriginales = Array.from(selectEl.options).map(o => ({
                    value: o.value,
                    text: o.text,
                    disabled: o.disabled
                }));
            }
        }

        function filtrarSelectorUsuario(inputId, selectId, badgeId, btnClearId, sugerenciasId) {
            const inputEl = document.getElementById(inputId);
            const selectEl = document.getElementById(selectId);
            const badgeEl = document.getElementById(badgeId);
            const btnClearEl = document.getElementById(btnClearId);
            const sugerenciasEl = document.getElementById(sugerenciasId);

            if (!inputEl || !selectEl) return;
            asegurarCacheOpcionesSelect(selectEl);

            const query = (inputEl.value || '').toLowerCase().trim();
            if (btnClearEl) {
                btnClearEl.style.display = query.length > 0 ? 'block' : 'none';
            }

            const todas = selectEl._opcionesOriginales;
            const usuariosOpts = todas.filter(o => o.value !== '');
            const valorActual = selectEl.value;

            if (!query) {
                selectEl.innerHTML = '';
                todas.forEach(o => {
                    const opt = document.createElement('option');
                    opt.value = o.value;
                    opt.textContent = o.text;
                    opt.disabled = o.disabled;
                    selectEl.appendChild(opt);
                });
                if (valorActual && usuariosOpts.some(o => o.value === valorActual)) {
                    selectEl.value = valorActual;
                } else {
                    selectEl.selectedIndex = 0;
                }
                if (badgeEl) {
                    badgeEl.textContent = `${usuariosOpts.length} usuario${usuariosOpts.length === 1 ? '' : 's'}`;
                }
                if (sugerenciasEl) {
                    sugerenciasEl.style.display = 'none';
                    sugerenciasEl.innerHTML = '';
                }
                return;
            }

            const coincidencias = usuariosOpts.filter(o => o.text.toLowerCase().includes(query));
            selectEl.innerHTML = '';

            if (coincidencias.length > 0) {
                coincidencias.forEach(o => {
                    const opt = document.createElement('option');
                    opt.value = o.value;
                    opt.textContent = o.text;
                    selectEl.appendChild(opt);
                });

                if (valorActual && coincidencias.some(o => o.value === valorActual)) {
                    selectEl.value = valorActual;
                } else {
                    selectEl.value = coincidencias[0].value;
                }

                if (badgeEl) {
                    badgeEl.textContent = `${coincidencias.length} coincidencia${coincidencias.length === 1 ? '' : 's'}`;
                }

                if (sugerenciasEl) {
                    sugerenciasEl.innerHTML = '';
                    coincidencias.forEach(o => {
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        const activo = selectEl.value === o.value;
                        btn.className = `w-full text-left px-3 py-1.5 flex items-center justify-between gap-2 hover:bg-brand-50 transition-colors cursor-pointer ${activo ? 'bg-emerald-50 font-bold text-emerald-900' : 'text-slate-700'}`;
                        const spanText = document.createElement('span');
                        spanText.className = 'truncate';
                        spanText.textContent = o.text;
                        const spanBadge = document.createElement('span');
                        spanBadge.className = 'text-[10px] font-bold text-emerald-600 shrink-0';
                        spanBadge.textContent = activo ? '✓ Seleccionado' : 'Elegir';
                        btn.appendChild(spanText);
                        btn.appendChild(spanBadge);
                        btn.onclick = () => seleccionarSugerenciaUsuario(selectId, o.value, inputId, badgeId, btnClearId, sugerenciasId);
                        sugerenciasEl.appendChild(btn);
                    });
                    sugerenciasEl.style.display = 'block';
                }
            } else {
                const opt = document.createElement('option');
                opt.value = '';
                opt.disabled = true;
                opt.selected = true;
                opt.textContent = `Sin coincidencias para "${inputEl.value}"`;
                selectEl.appendChild(opt);

                if (badgeEl) {
                    badgeEl.textContent = '0 coincidencias';
                }
                if (sugerenciasEl) {
                    sugerenciasEl.innerHTML = '<div class="px-3 py-2 text-slate-400 italic text-center">No se encontraron usuarios con ese nombre o correo.</div>';
                    sugerenciasEl.style.display = 'block';
                }
            }
        }

        function seleccionarSugerenciaUsuario(selectId, userId, inputId, badgeId, btnClearId, sugerenciasId) {
            const selectEl = document.getElementById(selectId);
            const inputEl = document.getElementById(inputId);
            const badgeEl = document.getElementById(badgeId);
            const btnClearEl = document.getElementById(btnClearId);
            const sugerenciasEl = document.getElementById(sugerenciasId);

            if (!selectEl) return;
            asegurarCacheOpcionesSelect(selectEl);

            // Restaurar todas las opciones y dejar seleccionado el usuario elegido
            selectEl.innerHTML = '';
            selectEl._opcionesOriginales.forEach(o => {
                const opt = document.createElement('option');
                opt.value = o.value;
                opt.textContent = o.text;
                opt.disabled = o.disabled;
                selectEl.appendChild(opt);
            });
            selectEl.value = userId;

            const elegido = selectEl._opcionesOriginales.find(o => o.value === String(userId));
            if (inputEl && elegido) {
                inputEl.value = '';
            }
            if (btnClearEl) {
                btnClearEl.style.display = 'none';
            }
            if (badgeEl) {
                badgeEl.textContent = '✓ Usuario seleccionado';
            }
            if (sugerenciasEl) {
                sugerenciasEl.style.display = 'none';
                sugerenciasEl.innerHTML = '';
            }
        }

        function limpiarBuscadorSelectorUsuario(inputId, selectId, badgeId, btnClearId, sugerenciasId) {
            const inputEl = document.getElementById(inputId);
            if (inputEl) inputEl.value = '';
            filtrarSelectorUsuario(inputId, selectId, badgeId, btnClearId, sugerenciasId);
        }

        function filtrarOpcionesSelectSimple(inputId, selectId, dispararFiltroEquipos) {
            const inputEl = document.getElementById(inputId);
            const selectEl = document.getElementById(selectId);
            if (!inputEl || !selectEl) return;
            asegurarCacheOpcionesSelect(selectEl);

            const query = (inputEl.value || '').toLowerCase().trim();
            const todas = selectEl._opcionesOriginales;
            const opcionTodos = todas.find(o => o.value === '');
            const usuariosOpts = todas.filter(o => o.value !== '');

            selectEl.innerHTML = '';
            if (opcionTodos) {
                const opt0 = document.createElement('option');
                opt0.value = opcionTodos.value;
                opt0.textContent = opcionTodos.text;
                selectEl.appendChild(opt0);
            }

            if (!query) {
                usuariosOpts.forEach(o => {
                    const opt = document.createElement('option');
                    opt.value = o.value;
                    opt.textContent = o.text;
                    selectEl.appendChild(opt);
                });
                selectEl.value = '';
            } else {
                const coincidencias = usuariosOpts.filter(o => o.text.toLowerCase().includes(query));
                coincidencias.forEach(o => {
                    const opt = document.createElement('option');
                    opt.value = o.value;
                    opt.textContent = o.text;
                    selectEl.appendChild(opt);
                });
                if (coincidencias.length > 0) {
                    selectEl.value = coincidencias[0].value;
                } else {
                    const optVacio = document.createElement('option');
                    optVacio.value = '__ninguno__';
                    optVacio.textContent = 'Sin usuarios coincidentes';
                    selectEl.appendChild(optVacio);
                    selectEl.value = '__ninguno__';
                }
            }

            if (dispararFiltroEquipos === 'tickets') {
                filtrarTablaTicketsAdmin();
            } else if (dispararFiltroEquipos) {
                filtrarTablaEquipos();
            }
        }

        // ==========================================
        // FILTROS DE TABLAS EN PANEL DE ADMINISTRACIÓN
        // ==========================================
        function filtrarTablaTicketsAdmin() {
            const busqVal = (document.getElementById('buscarTicketsAdmin')?.value || '').toLowerCase().trim();
            const userVal = document.getElementById('filtroTicketsUsuario')?.value || '';
            const catVal = (document.getElementById('filtroTicketsCategoria')?.value || '').toLowerCase().trim();
            const prioVal = (document.getElementById('filtroTicketsPrioridad')?.value || '').toLowerCase().trim();

            const btnClear = document.getElementById('btnClearBuscarTickets');
            if (btnClear) btnClear.style.display = busqVal.length > 0 ? 'block' : 'none';

            const filas = document.querySelectorAll('.fila-ticket-admin');
            let visCount = 0;

            filas.forEach(fila => {
                const coincideBusq = !busqVal || (fila.dataset.search || '').includes(busqVal);
                const coincideUser = !userVal || fila.dataset.usuarioId === userVal;
                const coincideCat = !catVal || (fila.dataset.categoria || '') === catVal;
                const coincidePrio = !prioVal || (fila.dataset.prioridad || '') === prioVal;

                if (coincideBusq && coincideUser && coincideCat && coincidePrio) {
                    fila.style.display = '';
                    visCount++;
                } else {
                    fila.style.display = 'none';
                }
            });

            const contador = document.getElementById('contadorTicketsVisibles');
            if (contador) {
                contador.textContent = `Mostrando ${visCount} de ${filas.length}`;
            }

            const filaSin = document.getElementById('filaSinCoincidenciasTickets');
            if (filaSin) {
                filaSin.style.display = (filas.length > 0 && visCount === 0) ? '' : 'none';
            }
        }

