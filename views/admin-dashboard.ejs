        function abrirModalEliminarTicketDefinitivo(id, titulo) {
            document.getElementById('idTicketDefinitivo').value = id;
            document.getElementById('txtIdTicketDefinitivo').textContent = id;
            document.getElementById('txtTituloTicketDefinitivo').textContent = titulo;
            const passInput = document.getElementById('passAdminEliminarTicketDefinitivo');
            if (passInput) passInput.value = '';
            document.getElementById('modalEliminarTicketDefinitivo').style.display = 'block';
        }

        function cerrarModalEliminarTicketDefinitivo() {
            document.getElementById('modalEliminarTicketDefinitivo').style.display = 'none';
        }

        function abrirModalEliminar(id, nombre) {
            document.getElementById('idUsuarioEliminar').value = id;
            document.getElementById('nombreUsuarioEliminar').innerText = nombre;
            const passInput = document.getElementById('passAdminEliminarUsuario');
            if (passInput) passInput.value = '';
            document.getElementById('modalEliminar').style.display = 'block';
        }

        function cerrarModalEliminar() {
            document.getElementById('modalEliminar').style.display = 'none';
        }

        function abrirModalEditarUsuario(btn) {
            if (!btn) return;
