        function manejarSeleccionImagenChatAdmin(e) {
            const input = document.getElementById('chatAdminInputImagen');
            const previewCont = document.getElementById('chatAdminPreviewContenedor');
            const imgPreview = document.getElementById('chatAdminImgPreview');
            const nombreSpan = document.getElementById('chatAdminNombreImagenPreview');
            const sizeSpan = document.getElementById('chatAdminSizeImagenPreview');
            const labelSpan = document.getElementById('chatAdminNombreImagen');

            if (input && input.files && input.files[0]) {
                const file = input.files[0];
                const sizeKb = (file.size / 1024).toFixed(1);

                if (nombreSpan) nombreSpan.textContent = file.name;
                if (sizeSpan) sizeSpan.textContent = `(${sizeKb} KB)`;
                if (labelSpan) labelSpan.textContent = file.name;

                const reader = new FileReader();
                reader.onload = function(evt) {
                    if (imgPreview) imgPreview.src = evt.target.result;
                    if (previewCont) previewCont.style.display = 'flex';
                };
                reader.readAsDataURL(file);
            } else {
                quitarImagenAdjuntaChatAdmin();
            }
        }

        function quitarImagenAdjuntaChatAdmin() {
            const input = document.getElementById('chatAdminInputImagen');
            const previewCont = document.getElementById('chatAdminPreviewContenedor');
            const imgPreview = document.getElementById('chatAdminImgPreview');
            const nombreSpan = document.getElementById('chatAdminNombreImagenPreview');
            const sizeSpan = document.getElementById('chatAdminSizeImagenPreview');
            const labelSpan = document.getElementById('chatAdminNombreImagen');

            if (input) input.value = '';
            if (imgPreview) imgPreview.src = '';
            if (nombreSpan) nombreSpan.textContent = '';
            if (sizeSpan) sizeSpan.textContent = '';
            if (labelSpan) labelSpan.textContent = '';
            if (previewCont) previewCont.style.display = 'none';
        }

        async function cargarMensajesChatAdmin(ticketId, scrollAlFinal) {
            // Si el usuario está editando activamente un mensaje y es un refresco automático en segundo plano, NO sobrescribir el DOM del chat
            const activo = document.activeElement;
            const tieneFocoEnEdicion = activo && activo.id && activo.id.startsWith('inputEdicionMensajeAdmin');
            if ((idMensajeEnEdicionAdmin !== null || tieneFocoEnEdicion) && !scrollAlFinal) {
                return;
            }

            try {
                const resp = await fetch(`/api/tickets/${ticketId}/comentarios`);
                const data = await resp.json();
                if (!data.ok) return;

                if (data.ticket) {
                    document.getElementById('chatAdminTituloTicket').textContent = `Ticket #${data.ticket.id} — ${data.ticket.titulo || ''}`;
                    document.getElementById('chatAdminEstatusBadge').textContent = data.ticket.estatus || '';
                    document.getElementById('chatAdminInfoAtendido').innerHTML = `<strong>Avance TI:</strong> ${escaparHtmlSimple(data.ticket.atendido_por || 'Sin registro previo')}`;
                    document.getElementById('chatAdminInfoEntregado').innerHTML = `<strong>Entrega/Cierre:</strong> ${escaparHtmlSimple(data.ticket.entregado_por || 'Pendiente')}`;
                }

                const cont = document.getElementById('contenedorMensajesChatAdmin');
                if (!cont) return;

                const comentarios = data.comentarios || [];
                if (comentarios.length === 0) {
                    cont.innerHTML = `
                        <div class="text-center py-10 text-slate-400 text-xs">
                            
                            No hay mensajes ni notas de seguimiento en este ticket todavía.<br>
                            Envía el primer mensaje para atender al usuario de forma remota.
                        </div>
                    `;
                    return;
                }

                const usuarioActual = data.usuarioActual;

                cont.innerHTML = comentarios.map(c => {
                    const esAdmin = c.autor_rol === 'admin';
                    const fechaStr = c.fecha ? new Date(c.fecha).toLocaleString('es-ES', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) : '';
                    let etiquetaTipo = '';
                    if (c.tipo_intervencion === 'diagnostico') {
                        etiquetaTipo = '<span class="px-1.5 py-0.2 rounded text-[9px] font-extrabold bg-amber-100 text-amber-800 border border-amber-300">DIAGNÓSTICO TI</span>';
                    } else if (c.tipo_intervencion === 'avance') {
                        etiquetaTipo = '<span class="px-1.5 py-0.2 rounded text-[9px] font-extrabold bg-sky-100 text-sky-800 border border-sky-300">AVANCE TÉCNICO</span>';
                    } else if (c.tipo_intervencion === 'entrega') {
                        etiquetaTipo = '<span class="px-1.5 py-0.2 rounded text-[9px] font-extrabold bg-emerald-100 text-emerald-800 border border-emerald-300">ENTREGA / CIERRE</span>';
                    }

                    const jsonMensajeEscapado = JSON.stringify(c.mensaje || '');
                    const esMio = (usuarioActual && c.usuario_id === usuarioActual.id);
                    const fechaCreacion = new Date(String(c.fecha).replace(' ', 'T')).getTime();
                    const diffMs = Date.now() - fechaCreacion;
                    const puedeEditar = esMio && (diffMs <= 5 * 60 * 1000);
                    const puedeEliminar = esMio;

                    return `
                        <div class="flex ${esAdmin ? 'justify-end' : 'justify-start'}" id="bloqueMensajeAdmin-${c.id}">
                            <div class="max-w-[85%] rounded-md p-3 shadow-2xs border ${esAdmin ? 'bg-brand-50/80 border-brand-200 text-slate-900' : 'bg-white border-slate-200 text-slate-800'}">
                                <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5 border-b border-slate-200/60 pb-1">
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-[11px] font-extrabold ${esAdmin ? 'text-brand-700' : 'text-slate-900'}">
                                             ${esAdmin ? '[TI] ' : ''}${escaparHtmlSimple(c.autor_nombre)}
                                        </span>
                                        ${c.autor_puesto ? `<span class="text-[10px] text-slate-500">(${escaparHtmlSimple(c.autor_puesto)})</span>` : ''}
                                        ${etiquetaTipo}
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-[10px] text-slate-400">${fechaStr}</span>
                                        ${puedeEditar ? `
                                            <button 
                                                type="button" 
                                                onclick='iniciarEdicionMensajeAdmin(${c.id}, ${jsonMensajeEscapado})' 
                                                class="text-[10px] text-slate-400 hover:text-brand-600 px-1 py-0.5 rounded hover:bg-slate-200 transition-colors cursor-pointer"
                                                title="Editar este mensaje (disponible durante 5 min)"
                                            >
                                                Editar
                                            </button>
                                        ` : ''}
                                        ${puedeEliminar ? `
                                            <button 
                                                type="button" 
                                                onclick="eliminarMensajeAdmin(${c.id})" 
                                                class="text-[10px] text-slate-400 hover:text-red-600 px-1 py-0.5 rounded hover:bg-red-50 transition-colors cursor-pointer"
                                                title="Eliminar este mensaje"
                                            >
                                                Eliminar
                                            </button>
                                        ` : ''}
                                    </div>
                                </div>

                                <div id="cuerpoMensajeTextoAdmin-${c.id}">
                                    ${c.mensaje ? `<div class="text-xs leading-relaxed whitespace-pre-line">${escaparHtmlSimple(c.mensaje)}</div>` : ''}
                                    ${c.editado == 1 ? `
                                        <div class="flex items-center gap-1 text-[10px] text-slate-400 mt-1 italic select-none">
                                            <span>Editar</span>
                                            <span>editado</span>
                                        </div>
                                    ` : ''}
                                </div>

                                <!-- Formulario Inline de Edición (Oculto inicialmente) -->
                                <div id="formEdicionMensajeAdmin-${c.id}" style="display: none;" class="mt-2 space-y-2 bg-white p-2.5 rounded border border-brand-300 shadow-2xs">
                                    <textarea 
                                        id="inputEdicionMensajeAdmin-${c.id}" 
                                        rows="2" 
                                        onkeydown="if(event.key === 'Escape') { cancelarEdicionMensajeAdmin(${c.id}); } else if(event.key === 'Enter' && (event.ctrlKey || event.metaKey)) { guardarEdicionMensajeAdmin(${c.id}); }"
                                        class="w-full text-xs rounded border border-slate-300 p-2 text-slate-800 focus:border-brand-600 focus:outline-none"
                                        placeholder="Escribe el nuevo texto del mensaje..."
                                    ></textarea>
                                    <div class="flex items-center justify-between gap-1.5">
                                        <span class="text-[10px] text-slate-400 hidden sm:inline">Ctrl+Enter para guardar · Esc para cancelar</span>
                                        <div class="flex items-center gap-1.5 ml-auto">
                                            <button 
                                                type="button" 
                                                onclick="cancelarEdicionMensajeAdmin(${c.id})" 
                                                class="px-2 py-1 rounded text-[11px] font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 cursor-pointer"
                                            >
                                                Cancelar
                                            </button>
                                            <button 
                                                type="button" 
                                                onclick="guardarEdicionMensajeAdmin(${c.id})" 
                                                class="px-2.5 py-1 rounded text-[11px] font-bold text-white bg-brand-600 hover:bg-brand-700 shadow-2xs cursor-pointer"
                                            >
                                                Guardar
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                ${c.imagen ? `
                                    <div class="mt-2">
                                        <a href="/uploads/${encodeURIComponent(c.imagen)}" target="_blank" class="inline-block">
                                            <img src="/uploads/${encodeURIComponent(c.imagen)}" alt="Adjunto" class="max-h-40 rounded border border-slate-300 object-contain bg-white p-0.5 shadow-2xs hover:opacity-95 transition-opacity">
                                        </a>
                                    </div>
                                ` : ''}
                            </div>
                        </div>
                    `;
                }).join('');

                if (scrollAlFinal) {
                    cont.scrollTop = cont.scrollHeight;
                }
            } catch (e) {
                console.error('Error cargando chat:', e);
            }
        }

        function iniciarEdicionMensajeAdmin(comentarioId, textoActual) {
            if (idMensajeEnEdicionAdmin && idMensajeEnEdicionAdmin !== comentarioId) {
                cancelarEdicionMensajeAdmin(idMensajeEnEdicionAdmin);
            }
            idMensajeEnEdicionAdmin = comentarioId;
            const form = document.getElementById('formEdicionMensajeAdmin-' + comentarioId);
            const input = document.getElementById('inputEdicionMensajeAdmin-' + comentarioId);
            const cuerpo = document.getElementById('cuerpoMensajeTextoAdmin-' + comentarioId);
            if (form && input) {
                input.value = textoActual;
                form.style.display = 'block';
                if (cuerpo) cuerpo.style.display = 'none';
                input.focus();
                const len = input.value.length;
                input.setSelectionRange(len, len);
            }
        }

        function cancelarEdicionMensajeAdmin(comentarioId) {
            if (idMensajeEnEdicionAdmin === comentarioId) {
                idMensajeEnEdicionAdmin = null;
            }
            const form = document.getElementById('formEdicionMensajeAdmin-' + comentarioId);
            const cuerpo = document.getElementById('cuerpoMensajeTextoAdmin-' + comentarioId);
            if (form) form.style.display = 'none';
            if (cuerpo) cuerpo.style.display = 'block';
        }

        async function guardarEdicionMensajeAdmin(comentarioId) {
            const input = document.getElementById('inputEdicionMensajeAdmin-' + comentarioId);
            if (!input) return;
            const nuevoTexto = (input.value || '').trim();
            if (!nuevoTexto) {
                alert('El mensaje no puede estar vacío.');
                return;
            }

            try {
                const resp = await fetch(`/api/tickets/comentarios/${comentarioId}/editar`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mensaje: nuevoTexto })
                });
                const data = await resp.json();
                if (data.ok) {
                    idMensajeEnEdicionAdmin = null;
                    if (chatAdminTicketActivo) {
                        await cargarMensajesChatAdmin(chatAdminTicketActivo, false);
                    }
                } else {
                    alert(data.error || 'No se pudo editar el mensaje.');
                }
            } catch (err) {
                console.error(err);
                alert('Error al guardar la edición.');
            }
        }

        async function eliminarMensajeAdmin(comentarioId) {
            if (!confirm('¿Estás seguro de que deseas eliminar este mensaje del chat? Esta acción no se puede deshacer.')) {
                return;
            }

            try {
                const resp = await fetch(`/api/tickets/comentarios/${comentarioId}/eliminar`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await resp.json();
                if (data.ok) {
                    if (chatAdminTicketActivo) {
                        cargarMensajesChatAdmin(chatAdminTicketActivo, false);
                    }
                } else {
                    alert(data.error || 'No se pudo eliminar el mensaje.');
                }
            } catch (err) {
                console.error(err);
                alert('Error al eliminar el mensaje.');
            }
        }

        async function enviarMensajeChatAdmin(e) {
            e.preventDefault();
            if (enviandoMensajeChatAdmin) return; // Candado estricto contra clics múltiples

            const ticketId = document.getElementById('chatAdminTicketId').value;
            const inputMsg = document.getElementById('chatAdminInputMensaje');
            const inputImg = document.getElementById('chatAdminInputImagen');
            const selectTipo = document.getElementById('chatAdminTipoIntervencion');
            const btn = document.getElementById('btnSubmitChatAdmin');

            const mensaje = (inputMsg.value || '').trim();
            const archivo = inputImg.files && inputImg.files[0];

            if (!mensaje && !archivo) {
                alert('Escribe un mensaje o adjunta una imagen antes de enviar.');
                return;
            }

            enviandoMensajeChatAdmin = true;
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span>⏳ Enviando...</span>';
                btn.classList.add('opacity-70', 'cursor-not-allowed');
            }

            const formData = new FormData();
            formData.append('mensaje', mensaje);
            formData.append('tipo_intervencion', selectTipo ? selectTipo.value : 'comentario');
            formData.append('formato', 'json');
            if (archivo) {
                formData.append('imagen', archivo);
            }

            try {
                const resp = await fetch(`/api/tickets/${ticketId}/comentarios`, {
                    method: 'POST',
                    headers: { 'Accept': 'application/json' },
                    body: formData
                });
                const data = await resp.json();
                if (data.ok) {
                    inputMsg.value = '';
                    quitarImagenAdjuntaChatAdmin();
                    await cargarMensajesChatAdmin(ticketId, true);
                } else {
                    alert(data.error || 'No se pudo enviar el mensaje.');
                }
            } catch (err) {
                console.error('Error enviando mensaje:', err);
                alert('Ocurrió un error al enviar el mensaje. Inténtalo de nuevo.');
            } finally {
                enviandoMensajeChatAdmin = false;
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<span>Enviar</span>';
                    btn.classList.remove('opacity-70', 'cursor-not-allowed');
                }
            }
        }

