<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración - Sistema de Tickets</title>
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Socket.IO para comunicación y sincronización instantánea en tiempo real -->
    <script src="/socket.io/socket.io.js"></script>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        // Protección contra el botón atrás del navegador tras cerrar sesión (bfcache)
        window.addEventListener('pageshow', function (event) {
            if (event.persisted || (window.performance && window.performance.navigation && window.performance.navigation.type === 2) || (window.performance && window.performance.getEntriesByType && window.performance.getEntriesByType('navigation')[0]?.type === 'back_forward')) {
                window.location.replace('/');
            }
        });
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#fef2f2',
                            100: '#fee2e2',
                            200: '#fecaca',
                            300: '#fca5a5',
                            400: '#f87171',
                            500: '#ef4444',
                            600: '#dc2626',
                            700: '#b91c1c',
                            800: '#991b1b',
                            900: '#7f1d1d',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Modales */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(2px);
            overflow-y: auto;
            padding: 20px;
            box-sizing: border-box;
        }
        .modal-content {
            background-color: #ffffff;
            margin: 40px auto;
            padding: 24px;
            border-radius: 8px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            border: 1px solid #cbd5e1;
            position: relative;
        }
        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 20px;
        }

        /* Historial */
        .historial-desplegable summary {
            cursor: pointer;
            list-style: none;
            outline: none;
        }
        .historial-desplegable summary::-webkit-details-marker {
            display: none;
        }
        .historial-desplegable summary::after {
            content: "▼";
            font-size: 8px;
            transition: transform 0.2s ease;
        }
        .historial-desplegable[open] summary::after {
            transform: rotate(180deg);
        }

        /* Elementos activos del menú lateral */
        .menu-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 14px;
            font-size: 13px;
            font-weight: 600;
            border-radius: 6px;
            transition: all 0.15s ease;
            cursor: pointer;
            width: 100%;
            text-align: left;
            border-left: 3px solid transparent;
        }
        .menu-item:hover {
            background-color: #f8fafc;
            color: #0f172a;
        }
        .menu-item.active {
            background-color: #fef2f2;
            color: #b91c1c;
            border-left-color: #dc2626;
            font-weight: 700;
        }
    </style>
</head>
<body class="min-h-full bg-slate-50 font-sans text-slate-800 antialiased flex flex-col">

    <!-- BARRA SUPERIOR DE NAVEGACIÓN CORPORATIVA -->
    <header class="bg-white border-b border-slate-200 border-t-4 border-brand-600 sticky top-0 z-30 shadow-xs">
        <div class="w-full px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
            
            <div class="flex items-center gap-3.5">
                <!-- Logo Corporativo CDM -->
                <a href="/admin" class="flex items-center pr-3 border-r border-slate-200" title="Panel Central de Tickets CDM">
                    <img 
                        src="/img/logo-cdm.png" 
                        alt="CDM" 
                        class="h-8 sm:h-9 w-auto object-contain select-none"
                    >
                </a>
                <div class="w-8 h-8 rounded-md bg-brand-600 text-white hidden sm:flex items-center justify-center font-bold shadow-xs">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-sm sm:text-base font-extrabold text-slate-900 tracking-tight leading-tight">
                        Sistema de Tickets
                    </h1>
                    <span class="text-[11px] font-semibold text-slate-500">
                        Panel de Administración y Control Central TI
                    </span>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <!-- Botón Añadir Recordatorio -->
                <button 
                    type="button" 
                    id="btnAbrirModalRecordatorio"
                    onclick="abrirModalCrearRecordatorio()"
                    title="Añadir un recordatorio personalizado para el equipo o colaborador"
                    class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md bg-indigo-600 hover:bg-indigo-700 text-xs font-bold text-white shadow-xs transition-colors cursor-pointer"
                >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    <span>Añadir Recordatorio</span>
                </button>

                <!-- Botón Notificaciones Nativas de Windows / Escritorio -->
                <button 
                    type="button" 
                    id="btnNotifEscritorioAdmin"
                    onclick="solicitarPermisoNotificacionesEscritorioAdmin()"
                    title="Activar notificaciones de escritorio de Windows para recibir avisos incluso si está en otra ventana o programa"
                    class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md bg-slate-100 hover:bg-slate-200 border border-slate-200 text-xs font-bold text-slate-700 transition-colors cursor-pointer"
                >
                    <span id="iconoNotifEscritorioAdmin" class="text-xs font-bold text-slate-500">Escritorio</span>
                    <span class="hidden xl:inline text-[11px]" id="textoNotifEscritorioAdmin">Alertas Windows</span>
                </button>

                <!-- Botón Activar/Silenciar Sonido de Notificación en Tiempo Real -->
                <button 
                    type="button" 
                    id="btnToggleSonidoAdmin"
                    onclick="toggleSonidoNotificacionesAdmin()"
                    title="Activar/Silenciar alerta sonora de nuevos tickets y mensajes"
                    class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md bg-slate-100 hover:bg-slate-200 border border-slate-200 text-xs font-bold text-slate-700 transition-colors cursor-pointer"
                >
                    <span id="iconoSonidoAdmin" class="text-xs font-bold text-slate-500">Sonido</span>
                    <span class="hidden lg:inline text-[11px]" id="textoSonidoAdmin">Sonido</span>
                </button>

                <!-- Campana de Notificaciones en Tiempo Real (Tickets nuevos y Mensajes de Chat) -->
                <div class="relative">
                    <button 
                        type="button" 
                        id="btnCampanaNotificacionesAdmin"
                        onclick="togglePanelNotificacionesAdmin(event)"
                        class="relative inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md bg-slate-100 hover:bg-slate-200 border border-slate-200 text-xs font-bold text-slate-700 transition-colors cursor-pointer"
                        title="Centro de Alertas en Tiempo Real"
                    >
                        
                        <span class="hidden xl:inline text-[11px]">Alertas Live</span>
                        <% 
                            const totalNoLeidosInicial = (tickets || []).reduce((acc, tk) => acc + (tk.no_leidos_admin || 0), 0);
                            const totalNuevosInicial = (tickets || []).filter(tk => tk.estatus === 'Nuevo ticket').length;
                            const badgeTotalInicial = totalNoLeidosInicial + totalNuevosInicial;
                        %>
                        <span 
                            id="badgeNotifAdminHeader" 
                            style="<%= badgeTotalInicial > 0 ? '' : 'display:none;' %>"
                            class="px-1.5 py-0.2 rounded-full text-[10px] font-extrabold bg-brand-600 text-white animate-pulse"
                        ><%= badgeTotalInicial %></span>
                    </button>

                    <!-- Dropdown de Notificaciones en Vivo -->
                    <div 
                        id="dropdownNotificacionesAdmin" 
                        style="display: none;" 
                        class="absolute right-0 mt-2 w-80 sm:w-[420px] bg-white rounded-lg shadow-2xl border border-slate-200 z-50 overflow-hidden"
                    >
                        <div class="px-3.5 py-2.5 bg-slate-900 text-white flex items-center justify-between gap-2 border-b border-slate-800">
                            <span class="text-xs font-bold flex items-center gap-1.5 truncate">
                                
                                <span>Centro de Alertas Live</span>
                            </span>
                            <div class="flex items-center gap-2 flex-shrink-0">
                                <button 
                                    type="button" 
                                    onclick="descartarTodasLasAlertasAdmin()" 
                                    class="inline-flex items-center gap-1 text-[11px] font-bold text-slate-300 hover:text-white px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-colors cursor-pointer"
                                    title="Quitar todas las alertas actuales del centro de notificaciones"
                                >
                                    
                                    <span>Limpiar Alertas</span>
                                </button>
                            </div>
                        </div>
                        <div id="listaNotificacionesLiveAdmin" class="max-h-96 overflow-y-auto divide-y divide-slate-100 text-xs">
                            <div class="p-4 text-center text-slate-400 italic">
                                Monitoreando actividad en tiempo real...
                            </div>
                        </div>
                    </div>
                </div>

                <div class="hidden md:flex items-center gap-2 px-2.5 py-1 rounded-md bg-slate-100 border border-slate-200 text-xs text-slate-700">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                    <span>Admin: <strong><%= adminNombre %></strong></span>
                </div>

                <a 
                    href="/admin/dashboards" 
                    class="inline-flex items-center gap-1.5 bg-brand-600 hover:bg-brand-700 text-white font-bold px-3.5 py-2 rounded-md shadow-xs text-xs transition-all"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                    <span class="hidden sm:inline">Ver Dashboards y Métricas</span>
                </a>

                <a 
                    href="/logout" 
                    class="inline-flex items-center gap-1 text-xs font-bold text-slate-600 hover:text-brand-600 px-3 py-2 rounded-md hover:bg-slate-100 transition-colors"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    <span class="hidden sm:inline">Cerrar Sesión</span>
                </a>
            </div>
        </div>
    </header>

    <!-- CONTENEDOR FLOTANTE DE ALERTAS EN TIEMPO REAL (TOASTS) -->
    <div id="toastContainerAdmin" class="fixed bottom-5 right-5 z-50 flex flex-col gap-3 max-w-md sm:max-w-lg w-full pointer-events-none"></div>

    <!-- ESTRUCTURA PRINCIPAL: MENÚ LATERAL IZQUIERDO + CONTENIDO DERECHO (PANTALLA COMPLETA) -->
    <div class="flex flex-col md:flex-row w-full min-h-[calc(100vh-4rem)] flex-1">
        
        <!-- MENÚ LATERAL IZQUIERDO -->
        <aside class="w-full md:w-72 flex-shrink-0 bg-white border-r border-slate-200 p-4 space-y-1.5 shadow-2xs">
            <div class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400 px-3 py-2 border-b border-slate-100 mb-2">
                Menú de Administración
            </div>

            <!-- 1. Atención de Tickets (Principal por defecto) -->
            <button 
                type="button" 
                onclick="cambiarModuloAdmin('tickets')" 
                id="btn-nav-tickets" 
                class="menu-item active"
            >
                
                <span class="flex-1">Atención de Tickets</span>
                <span class="text-xs bg-brand-100 text-brand-800 font-bold px-2 py-0.5 rounded" id="badge-nav-tickets">
                    <%= tickets.length %>
                </span>
            </button>

            <!-- 2. Levantar Ticket a Usuario -->
            <button 
                type="button" 
                onclick="cambiarModuloAdmin('crear-ticket')" 
                id="btn-nav-crear-ticket" 
                class="menu-item text-slate-700"
            >
                
                <span class="flex-1">Levantar Ticket a Usuario</span>
            </button>

            <!-- 3. Guías Rápidas y Soluciones (FAQ / Base de Conocimiento) -->
            <button 
                type="button" 
                onclick="cambiarModuloAdmin('guias')" 
                id="btn-nav-guias" 
                class="menu-item text-slate-700"
            >
                
                <span class="flex-1">Guías y Soluciones (FAQ)</span>
                <span class="text-xs bg-slate-100 text-slate-600 font-bold px-2 py-0.5 rounded" id="badge-nav-guias">
                    <%= (typeof guias !== 'undefined' && guias) ? guias.length : 0 %>
                </span>
            </button>

            <!-- 4. Categorías y Subcategorías -->
            <button 
                type="button" 
                onclick="cambiarModuloAdmin('categorias')" 
                id="btn-nav-categorias" 
                class="menu-item text-slate-700"
            >
                
                <span class="flex-1">Gestión de Categorías</span>
                <span class="text-xs bg-slate-100 text-slate-600 font-bold px-2 py-0.5 rounded">
                    <%= (categorias || []).length %>
                </span>
            </button>

            <!-- 5. Usuarios Registrados -->
            <button 
                type="button" 
                onclick="cambiarModuloAdmin('usuarios')" 
                id="btn-nav-usuarios" 
                class="menu-item text-slate-700"
            >
                
                <span class="flex-1">Usuarios Registrados</span>
                <span class="text-xs bg-slate-100 text-slate-600 font-bold px-2 py-0.5 rounded">
                    <%= (usuarios || []).length %>
                </span>
            </button>

            <!-- 6. Equipos y Periféricos por Usuario -->
            <button 
                type="button" 
                onclick="cambiarModuloAdmin('equipos')" 
                id="btn-nav-equipos" 
                class="menu-item text-slate-700"
            >
                
                <span class="flex-1">Equipos y Periféricos</span>
                <span class="text-xs bg-slate-100 text-slate-600 font-bold px-2 py-0.5 rounded" id="badge-nav-equipos">
                    <%= (equipos || []).length %>
                </span>
            </button>

            <!-- 7. Crear Nuevo Usuario -->
            <button 
                type="button" 
                onclick="cambiarModuloAdmin('crear-usuario')" 
                id="btn-nav-crear-usuario" 
                class="menu-item text-slate-700"
            >
                
                <span class="flex-1">Crear Nuevo Usuario</span>
            </button>

            <!-- 8. Papelera de Reciclaje -->
            <button 
                type="button" 
                onclick="cambiarModuloAdmin('papelera')" 
                id="btn-nav-papelera" 
                class="menu-item text-slate-700"
            >
                
                <span class="flex-1">Papelera de Reciclaje</span>
                <% 
                    const totalEnPapelera = ((typeof usuariosEliminados !== 'undefined' ? usuariosEliminados.length : 0) + (typeof ticketsEliminados !== 'undefined' ? ticketsEliminados.length : 0));
                    if (totalEnPapelera > 0) { 
                %>
                    <span class="text-xs bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded">
                        <%= totalEnPapelera %>
                    </span>
                <% } %>
            </button>

            <!-- 9. Configuración de Correo Outlook y Plantillas -->
            <button 
                type="button" 
                onclick="cambiarModuloAdmin('correo')" 
                id="btn-nav-correo" 
                class="menu-item text-slate-700"
            >
                
                <span class="flex-1">Configuración de Correo</span>
            </button>

            <!-- 10. Integración con Discord TI -->
            <button 
                type="button" 
                onclick="cambiarModuloAdmin('discord')" 
                id="btn-nav-discord" 
                class="menu-item text-slate-700"
            >
                <svg class="w-4 h-4 text-indigo-600 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                <span class="flex-1">Integración Discord</span>
                <span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-1.5 py-0.5 rounded">Activo</span>
            </button>

            <!-- RECORDATORIOS Y CITAS PROGRAMADAS (ESQUINA INFERIOR IZQUIERDA) -->
            <div id="contenedorCitasSidebar" class="pt-3 mt-3 border-t border-slate-200">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-[11px] font-black uppercase tracking-wider text-slate-800 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                        Citas y Recordatorios
                    </span>
                    <span id="badgeTotalCitasSidebar" class="text-[10px] font-black px-1.5 py-0.2 rounded-full bg-indigo-100 text-indigo-900 border border-indigo-200">
                        <%= ((typeof ticketsProgramados !== 'undefined' && ticketsProgramados) ? ticketsProgramados.length : 0) + ((typeof recordatorios !== 'undefined' && recordatorios) ? recordatorios.length : 0) %>
                    </span>
                </div>

                <div id="listaCitasSidebar" class="space-y-2 max-h-64 overflow-y-auto pr-1">
                    <% 
                    const hayTickets = typeof ticketsProgramados !== 'undefined' && ticketsProgramados && ticketsProgramados.length > 0;
                    const hayRecs = typeof recordatorios !== 'undefined' && recordatorios && recordatorios.length > 0;
                    %>
                    <% if (hayTickets || hayRecs) { %>
                        <!-- 1. Citas de Tickets (Color Ámbar) -->
                        <% if (hayTickets) { %>
                            <% ticketsProgramados.forEach(function(tc) { 
                                const dCita = new Date(String(tc.fecha_programada_cliente).includes('T') ? tc.fecha_programada_cliente : String(tc.fecha_programada_cliente).replace(' ', 'T'));
                                let fechaFormateada = tc.fecha_programada_cliente;
                                if (!isNaN(dCita.getTime())) {
                                    const hoyStr = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City' }).format(new Date());
                                    const citaStr = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City' }).format(dCita);
                                    const horaStr = dCita.toLocaleTimeString('es-MX', { timeZone: 'America/Mexico_City', hour: '2-digit', minute: '2-digit' });
                                    if (citaStr === hoyStr) {
                                        fechaFormateada = 'Hoy ' + horaStr + ' hrs';
                                    } else {
                                        fechaFormateada = dCita.toLocaleDateString('es-MX', { timeZone: 'America/Mexico_City', day: '2-digit', month: 'short' }) + ', ' + horaStr + ' hrs';
                                    }
                                }
                            %>
                                <div class="p-2 rounded-md bg-amber-50/80 border border-amber-300 text-xs hover:bg-amber-100/70 transition-colors shadow-2xs group relative">
                                    <div class="flex items-center justify-between gap-1 mb-1">
                                        <span class="inline-flex items-center gap-1 text-[10px] font-black uppercase tracking-wider text-amber-800 bg-amber-200/60 px-1.5 py-0.5 rounded border border-amber-300">
                                            <span>Cita Ticket</span>
                                        </span>
                                        <div class="flex items-center gap-1">
                                            <a href="/admin/tickets/<%= tc.id %>" target="_blank" class="text-[10px] font-black bg-white text-amber-900 hover:text-amber-950 px-1.5 py-0.5 rounded border border-amber-300 shadow-2xs" title="Abrir ticket completo">
                                                #<%= tc.id %>
                                            </a>
                                            <!-- Botón Editar Cita Ticket -->
                                            <button 
                                                type="button" 
                                                onclick="abrirModalEditarCitaTicket('<%= tc.id %>', '<%= tc.fecha_programada_cliente %>', '<%= (tc.motivo_pendiente_cliente || '').replace(/'/g, '\\\'').replace(/\r?\n/g, ' ') %>')"
                                                class="text-amber-700 hover:text-amber-900 hover:bg-amber-200/70 p-1 rounded transition-colors cursor-pointer"
                                                title="Editar fecha/motivo de esta cita"
                                            >
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                            </button>
                                            <!-- Botón Eliminar Cita Ticket -->
                                            <button 
                                                type="button" 
                                                onclick="confirmarEliminarCitaTicket('<%= tc.id %>')"
                                                class="text-red-500 hover:text-red-700 hover:bg-red-100 p-1 rounded transition-colors cursor-pointer"
                                                title="Eliminar esta cita programada"
                                            >
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="font-bold text-amber-950 text-[11px] truncate flex items-center gap-1">
                                        <svg class="w-3 h-3 text-amber-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                        <%= fechaFormateada %>
                                    </div>
                                    <div class="font-semibold text-slate-800 text-[11px] truncate mt-0.5" title="<%= tc.titulo %>">
                                        <%= tc.titulo %>
                                    </div>
                                    <div class="text-[10px] text-slate-600 truncate">
                                        <%= tc.usuario_nombre %>
                                    </div>
                                    <% if (tc.motivo_pendiente_cliente) { %>
                                        <div class="text-[9px] text-amber-800 italic truncate mt-0.5" title="<%= tc.motivo_pendiente_cliente %>">
                                            "<%= tc.motivo_pendiente_cliente %>"
                                        </div>
                                    <% } %>
                                </div>
                            <% }); %>
                        <% } %>

                        <!-- 2. Recordatorios Generales (Color Índigo) -->
                        <% if (hayRecs) { %>
                            <% recordatorios.forEach(function(rec) { 
                                const dRec = new Date(String(rec.fecha_programada).includes('T') ? rec.fecha_programada : String(rec.fecha_programada).replace(' ', 'T'));
                                let fechaFormateada = rec.fecha_programada;
                                if (!isNaN(dRec.getTime())) {
                                    const hoyStr = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City' }).format(new Date());
                                    const recStr = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City' }).format(dRec);
                                    const horaStr = dRec.toLocaleTimeString('es-MX', { timeZone: 'America/Mexico_City', hour: '2-digit', minute: '2-digit' });
                                    if (recStr === hoyStr) {
                                        fechaFormateada = 'Hoy ' + horaStr + ' hrs';
                                    } else {
                                        fechaFormateada = dRec.toLocaleDateString('es-MX', { timeZone: 'America/Mexico_City', day: '2-digit', month: 'short' }) + ', ' + horaStr + ' hrs';
                                    }
                                }
                            %>
                                <div class="p-2 rounded-md bg-indigo-50/90 border border-indigo-200 text-xs hover:bg-indigo-100/70 transition-colors shadow-2xs group relative">
                                    <div class="flex items-center justify-between gap-1 mb-1">
                                        <span class="inline-flex items-center gap-1 text-[10px] font-black uppercase tracking-wider text-indigo-800 bg-indigo-200/60 px-1.5 py-0.5 rounded border border-indigo-300">
                                            <span>Recordatorio</span>
                                        </span>
                                        <div class="flex items-center gap-1">
                                            <!-- Botón Editar Recordatorio -->
                                            <button 
                                                type="button" 
                                                onclick="abrirModalEditarRecordatorio('<%= rec.id %>', '<%= (rec.destinatario || '').replace(/'/g, '\\\'') %>', '<%= (rec.descripcion || '').replace(/'/g, '\\\'').replace(/\r?\n/g, ' ') %>', '<%= rec.fecha_programada %>')"
                                                class="text-indigo-700 hover:text-indigo-900 hover:bg-indigo-200/70 p-1 rounded transition-colors cursor-pointer"
                                                title="Editar recordatorio"
                                            >
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                            </button>
                                            <!-- Botón Eliminar Recordatorio -->
                                            <button 
                                                type="button" 
                                                onclick="confirmarEliminarRecordatorio('<%= rec.id %>')"
                                                class="text-red-500 hover:text-red-700 hover:bg-red-100 p-1 rounded transition-colors cursor-pointer"
                                                title="Eliminar este recordatorio"
                                            >
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="font-bold text-indigo-950 text-[11px] truncate flex items-center gap-1">
                                        <svg class="w-3 h-3 text-indigo-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                        <%= fechaFormateada %>
                                    </div>
                                    <div class="font-bold text-slate-800 text-[11px] truncate mt-0.5" title="<%= rec.destinatario %>">
                                        Para: <%= rec.destinatario %>
                                    </div>
                                    <div class="text-[10px] text-indigo-900 leading-tight mt-0.5 line-clamp-2" title="<%= rec.descripcion %>">
                                        <%= rec.descripcion %>
                                    </div>
                                </div>
                            <% }); %>
                        <% } %>
                    <% } else { %>
                        <div class="p-2.5 text-center text-slate-400 text-[11px] italic rounded bg-slate-50 border border-dashed border-slate-200">
                            Sin citas ni recordatorios pendientes
                        </div>
                    <% } %>
                </div>
            </div>
        </aside>

        <!-- ÁREA PRINCIPAL DE CONTENIDO (PANTALLA COMPLETA A LA DERECHA) -->
        <main class="flex-1 w-full p-4 sm:p-6 lg:p-8 bg-slate-50 space-y-6 overflow-x-hidden">

            <!-- Mensajes de Alerta con botón de cierre (✕) y auto-cierre -->
            <% if (mensaje) { %>
                <div id="alertaMensajeExito" class="rounded-md bg-emerald-50 border border-emerald-200 p-3.5 text-sm text-emerald-800 flex items-start justify-between gap-3 shadow-xs transition-opacity duration-300">
                    <div class="flex items-start gap-2.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 mt-1"></span>
                        <div class="font-medium text-xs sm:text-sm leading-snug"><%= mensaje %></div>
                    </div>
                    <button type="button" onclick="cerrarAlerta('alertaMensajeExito')" class="text-emerald-500 hover:text-emerald-800 hover:bg-emerald-100 p-1 rounded transition-colors text-xs font-bold leading-none cursor-pointer flex-shrink-0" title="Cerrar notificación">
                        ✕
                    </button>
                </div>
            <% } %>
            <% if (error) { %>
                <div id="alertaMensajeError" class="rounded-md bg-rose-50 border border-rose-200 p-3.5 text-sm text-rose-800 flex items-start justify-between gap-3 shadow-xs transition-opacity duration-300">
                    <div class="flex items-start gap-2.5">
                        <span class="w-2 h-2 rounded-full bg-rose-500 mt-1"></span>
                        <div class="font-medium text-xs sm:text-sm leading-snug"><%= error %></div>
                    </div>
                    <button type="button" onclick="cerrarAlerta('alertaMensajeError')" class="text-rose-500 hover:text-rose-800 hover:bg-rose-100 p-1 rounded transition-colors text-xs font-bold leading-none cursor-pointer flex-shrink-0" title="Cerrar notificación">
                        ✕
                    </button>
                </div>
            <% } %>

            <!-- MÓDULO 1: ATENCIÓN DE TICKETS DE FALLAS (VISIBLE PRINCIPALMENTE) -->
            <section id="modulo-tickets" class="modulo-admin space-y-4">
                <div class="bg-white rounded-md shadow-xs border border-slate-200 overflow-hidden">
                    
                    <!-- Barra de Filtros por Estatus y Botón Masivo a la Derecha -->
                    <div class="p-4 border-b border-slate-200 bg-slate-50/70 flex flex-wrap items-center justify-between gap-4">
                        
                        <!-- Clasificador de Estatus -->
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 mr-1">
                                Clasificar por estatus:
                            </span>
                            <div class="inline-flex items-center gap-1 bg-white p-1 rounded-md border border-slate-200 shadow-2xs" id="clasificadorEstatusAdmin">
                                <a 
                                    href="/admin?estatus=Todos" 
                                    class="px-3 py-1 rounded text-xs font-bold transition-all <%= filtroActual === 'Todos' ? 'bg-brand-600 text-white shadow-2xs' : 'text-slate-600 hover:text-brand-600 hover:bg-slate-50' %>"
                                >Todos</a>
                                <a 
                                    href="/admin?estatus=Nuevo ticket" 
                                    class="px-3 py-1 rounded text-xs font-bold transition-all <%= filtroActual === 'Nuevo ticket' ? 'bg-brand-600 text-white shadow-2xs' : 'text-slate-600 hover:text-brand-600 hover:bg-slate-50' %>"
                                >Nuevos</a>
                                <a 
                                    href="/admin?estatus=Pendiente" 
                                    class="px-3 py-1 rounded text-xs font-bold transition-all <%= filtroActual === 'Pendiente' ? 'bg-brand-600 text-white shadow-2xs' : 'text-slate-600 hover:text-brand-600 hover:bg-slate-50' %>"
                                >Pendientes</a>
                                <a 
                                    href="/admin?estatus=Pendiente por cliente" 
                                    class="px-3 py-1 rounded text-xs font-bold transition-all <%= filtroActual === 'Pendiente por cliente' ? 'bg-brand-600 text-white shadow-2xs' : 'text-slate-600 hover:text-brand-600 hover:bg-slate-50' %>"
                                >Pend. Cliente</a>
                                <a 
                                    href="/admin?estatus=En proceso" 
                                    class="px-3 py-1 rounded text-xs font-bold transition-all <%= filtroActual === 'En proceso' ? 'bg-brand-600 text-white shadow-2xs' : 'text-slate-600 hover:text-brand-600 hover:bg-slate-50' %>"
                                >En proceso</a>
                                <a 
                                    href="/admin?estatus=Resuelto" 
                                    class="px-3 py-1 rounded text-xs font-bold transition-all <%= filtroActual === 'Resuelto' ? 'bg-brand-600 text-white shadow-2xs' : 'text-slate-600 hover:text-brand-600 hover:bg-slate-50' %>"
                                >Resueltos</a>
                            </div>
                            <% if (filtroActual === 'Todos') { %>
                                <span class="text-[11px] text-slate-400 italic">
                                    (Los tickets resueltos se consultan en "Resueltos")
                                </span>
                            <% } %>
                        </div>

                        <!-- Botón Masivo a la Derecha -->
                        <div>
                            <button 
                                type="button" 
                                id="btnGuardarEstatusGlobal" 
                                onclick="guardarTodosLosEstatus()" 
                                class="inline-flex items-center gap-2 py-2 px-4 rounded-md shadow-xs text-xs font-extrabold text-white bg-brand-600 hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500 transition-all cursor-pointer whitespace-nowrap"
                                title="Guardar todos los cambios de estatus pendientes"
                            >
                                <span>Guardar Cambios de Estatus</span>
                            </button>
                        </div>
                    </div>

                    <!-- Barra de Búsqueda Rápida de Tickets y Filtros por Usuario / Categoría / Prioridad -->
                    <div class="px-4 py-3 border-b border-slate-200 bg-white flex flex-col lg:flex-row gap-2.5 items-stretch lg:items-center justify-between">
                        <div class="flex flex-col sm:flex-row gap-2 items-stretch sm:items-center flex-1 flex-wrap">
                            <!-- Buscador en texto libre -->
                            <div class="relative flex-1 min-w-[240px]">
                                <input 
                                    type="text" 
                                    id="buscarTicketsAdmin" 
                                    oninput="filtrarTablaTicketsAdmin()" 
                                    placeholder="Buscar por #ID, nombre de usuario, correo, título, falla o descripción..." 
                                    class="w-full rounded-md border border-slate-300 pl-8 pr-7 py-1.5 text-xs text-slate-900 placeholder-slate-400 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                                >
                                
                                <button 
                                    type="button" 
                                    id="btnClearBuscarTickets" 
                                    onclick="document.getElementById('buscarTicketsAdmin').value=''; filtrarTablaTicketsAdmin();" 
                                    style="display: none;" 
                                    class="absolute right-2 top-1.5 text-slate-400 hover:text-slate-600 text-xs font-bold cursor-pointer"
                                    title="Limpiar búsqueda"
                                >✕</button>
                            </div>

                            <!-- Filtro por Usuario Solicitante con búsqueda -->
                            <div class="flex items-center gap-1 min-w-[260px]">
                                <div class="relative w-28 flex-shrink-0">
                                    <input 
                                        type="text" 
                                        id="buscarFiltroTicketsUsuario" 
                                        oninput="filtrarOpcionesSelectSimple('buscarFiltroTicketsUsuario', 'filtroTicketsUsuario', 'tickets')" 
                                        placeholder="Filtrar por usuario..." 
                                        class="w-full rounded-md border border-slate-300 px-2 py-1.5 text-xs text-slate-900 placeholder-slate-400 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                                        title="Filtrar opciones de usuario"
                                    >
                                </div>
                                <div class="relative flex-1">
                                    <select 
                                        id="filtroTicketsUsuario" 
                                        onchange="filtrarTablaTicketsAdmin()" 
                                        class="w-full rounded-md border border-slate-300 px-2.5 py-1.5 text-xs text-slate-900 bg-white font-medium focus:border-brand-600 focus:outline-none shadow-2xs"
                                    >
                                        <option value="">Todos los usuarios</option>
                                        <% (usuarios || []).forEach(u => { %>
                                            <option value="<%= u.id %>"><%= u.nombre %> (<%= u.email %>)</option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>

                            <!-- Filtro por Categoría -->
                            <div class="min-w-[165px]">
                                <select 
                                    id="filtroTicketsCategoria" 
                                    onchange="filtrarTablaTicketsAdmin()" 
                                    class="w-full rounded-md border border-slate-300 px-2.5 py-1.5 text-xs text-slate-900 bg-white font-medium focus:border-brand-600 focus:outline-none shadow-2xs"
                                >
                                    <option value="">Todas las categorías</option>
                                    <% (categorias || []).forEach(c => { %>
                                        <option value="<%= c.nombre.toLowerCase() %>"><%= c.nombre %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <!-- Filtro por Prioridad -->
                            <div class="min-w-[140px]">
                                <select 
                                    id="filtroTicketsPrioridad" 
                                    onchange="filtrarTablaTicketsAdmin()" 
                                    class="w-full rounded-md border border-slate-300 px-2.5 py-1.5 text-xs text-slate-900 bg-white font-medium focus:border-brand-600 focus:outline-none shadow-2xs"
                                >
                                    <option value="">Prioridad: Todas</option>
                                    <option value="alta">Alta</option>
                                    <option value="media">Media</option>
                                    <option value="baja">Baja</option>
                                </select>
                            </div>
                        </div>

                        <div class="flex items-center justify-between sm:justify-end gap-2">
                            <span id="contadorTicketsVisibles" class="text-[11px] font-bold text-slate-500 bg-slate-100 px-2.5 py-1 rounded border border-slate-200 whitespace-nowrap">
                                Mostrando <%= tickets.length %> de <%= tickets.length %>
                            </span>
                            <button 
                                type="button" 
                                onclick="limpiarFiltrosTicketsAdmin()" 
                                class="px-2.5 py-1.5 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 text-xs font-bold transition-colors cursor-pointer whitespace-nowrap"
                            >
                                Limpiar Filtros
                            </button>
                        </div>
                    </div>

                    <!-- Formulario oculto para el guardado global de estatus -->
                    <form id="formGuardarEstatusGlobal" action="/admin/tickets/actualizar-estatus-masivo" method="POST" style="display: none;">
                        <input type="hidden" name="cambios" id="inputCambiosEstatus">
                    </form>

                    <!-- Tabla de Tickets (Aprovecha toda la pantalla) -->
                    <div class="overflow-x-auto w-full" id="contenedorTablaTicketsAdmin">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-slate-200 bg-slate-50 text-[11px] font-bold uppercase tracking-wider text-slate-600">
                                    <th class="py-3 px-4 w-24">ID</th>
                                    <th class="py-3 px-4">Usuario</th>
                                    <th class="py-3 px-4">Título / Falla</th>
                                    <th class="py-3 px-4">Prioridad</th>
                                    <th class="py-3 px-4">Descripción</th>
                                    <th class="py-3 px-4 text-center">Evidencia</th>
                                    <th class="py-3 px-4">Estatus Actual</th>
                                    <th class="py-3 px-4 min-w-[150px]">Cambiar Estatus</th>
                                    <th class="py-3 px-4 min-w-[170px]">Historial de Fechas y Horas</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-xs">
                                <% if (tickets.length === 0) { %>
                                    <tr>
                                        <td colspan="9" class="py-12 text-center text-slate-400 italic">
                                            <div class="w-8 h-8 mx-auto mb-2 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 font-bold text-xs">--</div>
                                            No hay tickets para mostrar con el filtro actual (<%= filtroActual %>).
                                        </td>
                                    </tr>
                                <% } %>
                                <% tickets.forEach(t => { %>
                                    <tr 
                                        id="filaTicket-<%= t.id %>"
                                        class="fila-ticket-admin hover:bg-slate-50 transition-colors"
                                        data-usuario-id="<%= t.usuario_id || '' %>"
                                        data-categoria="<%= (t.tipo_falla || '').toLowerCase() %>"
                                        data-prioridad="<%= (t.prioridad || '').toLowerCase() %>"
                                        data-search="<%= ('#' + t.id + ' ' + t.id + ' ' + (t.usuario_nombre || '') + ' ' + (t.usuario_puesto || '') + ' ' + (t.usuario_email || '') + ' ' + (t.titulo || '') + ' ' + (t.tipo_falla || '') + ' ' + (t.subcategoria || '') + ' ' + (t.descripcion || '') + ' ' + (t.estatus || '') + ' ' + (t.creado_por_admin || '') + ' ' + (t.atendido_por || '') + ' ' + (t.entregado_por || '') + ' ' + (t.participantes_ti || '')).toLowerCase() %>"
                                    >
                                        <!-- ID y botón eliminar -->
                                        <td class="py-3 px-4 font-bold whitespace-nowrap">
                                            <div class="flex items-center justify-between gap-1.5">
                                                <a 
                                                    href="/admin/tickets/<%= t.id %>" target="_blank" rel="opener" 
                                                    class="inline-flex items-center gap-1 text-brand-600 hover:text-brand-800 font-extrabold hover:underline"
                                                    title="Abrir ticket completo en pestaña nueva"
                                                >
                                                    <span>#<%= t.id %></span>
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                                    </svg>
                                                </a>
                                                <button 
                                                    type="button" 
                                                    onclick="abrirModalEliminarTicket('<%= t.id %>', '<%= t.titulo.replace(/'/g, "\\'") %>')" 
                                                    title="Eliminar este ticket"
                                                    class="text-slate-400 hover:text-brand-600 hover:bg-brand-50 p-1 rounded transition-colors cursor-pointer text-sm"
                                                >
                                                    Eliminar
                                                </button>
                                            </div>
                                        </td>

                                        <!-- Usuario -->
                                        <td class="py-3 px-4">
                                            <div class="font-semibold text-slate-900">
                                                <%= t.usuario_nombre %>
                                            </div>
                                            <% if (t.usuario_puesto) { %>
                                                <div class="text-[11px] font-semibold text-brand-700">
                                                    <%= t.usuario_puesto %>
                                                </div>
                                            <% } %>
                                            <div class="text-[11px] text-slate-500">
                                                <%= t.usuario_email %>
                                            </div>
                                            <% if (t.creado_por_admin) { %>
                                                <div class="mt-0.5">
                                                    <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-semibold bg-purple-50 text-purple-700 border border-purple-200">
                                                        Por: <%= t.creado_por_admin %>
                                                    </span>
                                                </div>
                                            <% } %>
                                        </td>

                                        <!-- Título / Tipo de Falla -->
                                        <td class="py-3 px-4">
                                            <div class="font-semibold text-slate-900 flex items-center gap-1.5 flex-wrap">
                                                <span><%= t.titulo %></span>
                                                <% if (t.editado) { %>
                                                    <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded text-[10px] font-bold bg-amber-50 text-amber-800 border border-amber-300 shadow-2xs" title="Modificado por el usuario <%= t.editado_at ? 'el ' + new Date(t.editado_at).toLocaleString('es-ES') : '' %>">
                                                        Editado
                                                    </span>
                                                <% } %>
                                            </div>
                                            <div class="text-[11px] text-slate-500 mt-0.5">
                                                <span><%= t.tipo_falla %></span>
                                                <% if (t.subcategoria) { %>
                                                    <span class="text-brand-600 font-bold">› <%= t.subcategoria %></span>
                                                <% } %>
                                            </div>
                                        </td>

                                        <!-- Prioridad -->
                                        <td class="py-3 px-4 whitespace-nowrap">
                                            <% if (t.prioridad === 'Alta') { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-brand-50 text-brand-700 border border-brand-200">
                                                    Alta
                                                </span>
                                            <% } else if (t.prioridad === 'Media') { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                    Media
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                    Baja
                                                </span>
                                            <% } %>
                                        </td>

                                        <!-- Descripción -->
                                        <td class="py-3 px-4 text-slate-600">
                                            <p class="line-clamp-2 leading-relaxed" title="<%= t.descripcion %>">
                                                <%= t.descripcion %>
                                            </p>
                                        </td>

                                        <!-- Evidencia -->
                                        <td class="py-3 px-4 text-center whitespace-nowrap">
                                            <% if (t.imagen) { %>
                                                <a href="/uploads/<%= t.imagen %>" target="_blank" class="inline-block group" title="Ver imagen de evidencia">
                                                    <img 
                                                        src="/uploads/<%= t.imagen %>" 
                                                        alt="Evidencia" 
                                                        class="w-10 h-10 object-cover rounded border border-slate-200 group-hover:border-brand-500 shadow-2xs transition-all"
                                                    >
                                                </a>
                                            <% } else { %>
                                                <span class="text-slate-400 text-[10px] italic">Sin imagen</span>
                                            <% } %>
                                        </td>

                                        <!-- Estatus Actual, Intervención TI y Detalles de Resolución -->
                                        <td class="py-3 px-4 whitespace-nowrap" id="celdaEstatusTicket-<%= t.id %>">
                                            <div class="flex items-center gap-1.5">
                                                <% if (t.estatus === 'Nuevo ticket') { %>
                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-sky-50 text-sky-700 border border-sky-200">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
                                                        Nuevo ticket
                                                    </span>
                                                <% } else if (t.estatus === 'En proceso') { %>
                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                                        En proceso
                                                    </span>
                                                <% } else if (t.estatus === 'Pendiente') { %>
                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                                        Pendiente
                                                    </span>
                                                <% } else if (t.estatus === 'Pendiente por cliente') { %>
                                                    <div class="space-y-1">
                                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-orange-100 text-orange-800 border border-orange-300 shadow-2xs">
                                                            Pendiente por cliente
                                                        </span>
                                                        <% if (t.fecha_programada_cliente) { %>
                                                            <div class="text-[10px] font-bold text-orange-950 bg-orange-50 border border-orange-200 px-1.5 py-0.5 rounded flex items-center gap-1" title="Cita o contacto acordado con el usuario">
                                                                <%= t.fecha_programada_cliente %>
                                                            </div>
                                                        <% } %>
                                                        <% if (t.motivo_pendiente_cliente) { %>
                                                            <div class="text-[10px] text-slate-500 italic max-w-[160px] truncate" title="<%= t.motivo_pendiente_cliente %>">
                                                                <%= t.motivo_pendiente_cliente %>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                <% } else if (t.estatus === 'Resuelto') { %>
                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                                        Resuelto
                                                    </span>
                                                <% } else { %>
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700">
                                                        <%= t.estatus %>
                                                    </span>
                                                <% } %>

                                                <% if ((t.estatus === 'Resuelto' && t.categoria_resolucion) || t.atendido_por || t.entregado_por || t.participantes_ti) { %>
                                                    <button 
                                                        class="text-emerald-700 hover:text-emerald-900 bg-emerald-50 hover:bg-emerald-100 p-0.5 rounded text-[10px] font-bold cursor-pointer transition-colors" 
                                                        onclick="toggleDetalles('<%= t.id %>')" 
                                                        title="Ver bitácora de especialistas y resolución"
                                                    >
                                                        ▼
                                                    </button>
                                                <% } %>
                                            </div>

                                            <% if (t.fecha_programada_cliente) { %>
                                                <% 
                                                    const ahoraDiaHoy = new Date().toISOString().slice(0, 10);
                                                    const fProgStr = String(t.fecha_programada_cliente).replace(' ', 'T');
                                                    const esHoyProg = fProgStr.startsWith(ahoraDiaHoy);
                                                    const dProg = new Date(fProgStr);
                                                    const horaFmt = !isNaN(dProg.getTime()) ? dProg.toLocaleString('es-MX', { timeZone: 'America/Mexico_City', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : t.fecha_programada_cliente;
                                                %>
                                                <div class="mt-1 px-2 py-0.5 rounded border <%= esHoyProg ? 'bg-amber-100 border-amber-300 text-amber-950 font-black animate-pulse' : 'bg-orange-50 border-orange-200 text-orange-900 font-bold' %> text-[10px] flex items-center gap-1">
                                                    <span><%= esHoyProg ? 'CITA HOY:' : 'Cita:' %></span>
                                                    <span><%= horaFmt %></span>
                                                </div>
                                            <% } %>
                                            <% if (t.motivo_pendiente_cliente) { %>
                                                <div class="text-[10px] text-slate-500 italic mt-0.5 max-w-[200px] truncate" title="<%= t.motivo_pendiente_cliente %>">
                                                    Motivo: <%= t.motivo_pendiente_cliente %>
                                                </div>
                                            <% } %>

                                            <!-- Resumen visible de quiénes han intervenido (Multi-especialista) -->
                                            <% if (t.atendido_por || t.entregado_por || t.tecnico_resolvio) { %>
                                                <div class="mt-1 space-y-0.5 text-[10px] text-slate-600">
                                                    <% if (t.atendido_por) { %>
                                                        <div title="Diagnosticado / Avanzado por"><strong>Avance:</strong> <%= t.atendido_por %></div>
                                                    <% } %>
                                                    <% if (t.entregado_por || t.tecnico_resolvio) { %>
                                                        <div class="text-emerald-700" title="Entregado / Cerrado por"><strong>Entrega:</strong> <%= t.entregado_por || t.tecnico_resolvio %></div>
                                                    <% } %>
                                                </div>
                                            <% } %>

                                            <% if ((t.estatus === 'Resuelto' && t.categoria_resolucion) || t.atendido_por || t.entregado_por || t.participantes_ti) { %>
                                                <div id="detalles-<%= t.id %>" style="display: none;" class="mt-2 p-2 bg-emerald-50 border border-emerald-200 rounded text-[11px] text-emerald-900 leading-relaxed shadow-2xs whitespace-normal min-w-[200px]">
                                                    <% if (t.atendido_por) { %>
                                                        <div><strong>Avance / Diagnóstico:</strong> <%= t.atendido_por %></div>
                                                    <% } %>
                                                    <% if (t.entregado_por || t.tecnico_resolvio) { %>
                                                        <div><strong>Entrega / Cierre:</strong> <%= t.entregado_por || t.tecnico_resolvio %></div>
                                                    <% } %>
                                                    <% if (t.participantes_ti) { %>
                                                        <div><strong>Equipo TI participante:</strong> <%= t.participantes_ti %></div>
                                                    <% } %>
                                                    <% if (t.categoria_resolucion) { %>
                                                        <div><strong>Categoría:</strong> <%= t.categoria_resolucion %></div>
                                                    <% } %>
                                                    <% if (t.comentario_resolucion) { %>
                                                        <div><strong>Comentario:</strong> <%= t.comentario_resolucion %></div>
                                                    <% } %>
                                                    <% if (t.categoria_resolucion === 'Reemplazo') { %>
                                                        <div class="mt-1 pt-1 border-t border-emerald-200 text-emerald-800">
                                                            <div><strong>Tipo nuevo:</strong> <%= t.tipo_equipo_nuevo || 'N/A' %></div>
                                                            <div><strong>Modelo:</strong> <%= t.modelo_nuevo || 'N/A' %></div>
                                                            <div><strong>N° Serie:</strong> <%= t.numero_serie_nuevo || 'N/A' %></div>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            <% } %>
                                        </td>

                                        <!-- Selector de Cambio de Estatus + Botones de Seguimiento Remoto y Avance -->
                                        <td class="py-3 px-4">
                                            <div class="space-y-1.5">
                                                <%
                                                    let claseSelectEstatus = 'bg-white text-slate-800 border-slate-300';
                                                    if (t.estatus === 'Nuevo ticket') {
                                                        claseSelectEstatus = 'bg-sky-50 text-sky-700 border-sky-300';
                                                    } else if (t.estatus === 'Pendiente') {
                                                        claseSelectEstatus = 'bg-rose-50 text-rose-700 border-rose-300';
                                                    } else if (t.estatus === 'Pendiente por cliente') {
                                                        claseSelectEstatus = 'bg-orange-50 text-orange-800 border-orange-300';
                                                    } else if (t.estatus === 'En proceso') {
                                                        claseSelectEstatus = 'bg-amber-50 text-amber-700 border-amber-300';
                                                    } else if (t.estatus === 'Resuelto') {
                                                        claseSelectEstatus = 'bg-emerald-50 text-emerald-700 border-emerald-300';
                                                    }
                                                %>
                                                <select 
                                                    id="selectEstatusFila-<%= t.id %>"
                                                    class="select-estatus-ticket w-full max-w-[155px] rounded border <%= claseSelectEstatus %> px-2 py-1 text-xs font-bold focus:outline-none focus:ring-1 focus:ring-brand-500 cursor-pointer transition-all shadow-2xs" 
                                                    data-ticket-id="<%= t.id %>" 
                                                    data-original-status="<%= t.estatus %>" 
                                                    data-atendido-por="<%= t.atendido_por || '' %>"
                                                    data-entregado-por="<%= t.entregado_por || t.tecnico_resolvio || '' %>"
                                                    data-fecha-programada="<%= t.fecha_programada_cliente || '' %>"
                                                    data-motivo-pendiente="<%= t.motivo_pendiente_cliente || '' %>"
                                                    onchange="manejarCambioSelectEstatus(this)"
                                                >
                                                    <option value="Nuevo ticket" class="bg-sky-50 text-sky-800 font-bold" <%= t.estatus === 'Nuevo ticket' ? 'selected' : '' %>>Nuevo ticket</option>
                                                    <option value="Pendiente" class="bg-rose-50 text-rose-800 font-bold" <%= t.estatus === 'Pendiente' ? 'selected' : '' %>>Pendiente TI</option>
                                                    <option value="Pendiente por cliente" class="bg-orange-50 text-orange-800 font-bold" <%= t.estatus === 'Pendiente por cliente' ? 'selected' : '' %>>Pendiente por cliente</option>
                                                    <option value="En proceso" class="bg-amber-50 text-amber-800 font-bold" <%= t.estatus === 'En proceso' ? 'selected' : '' %>>En proceso</option>
                                                    <option value="Resuelto" class="bg-emerald-50 text-emerald-800 font-bold" <%= t.estatus === 'Resuelto' ? 'selected' : '' %>>Resuelto</option>
                                                </select>

                                                <div class="flex flex-wrap items-center gap-1">


                                                    <!-- Botón Chat / Seguimiento Remoto -->
                                                    <button 
                                                        type="button" 
                                                        onclick="abrirChatTicketAdmin('<%= t.id %>')"
                                                        class="relative inline-flex items-center gap-1 px-2 py-1 rounded text-[10px] font-bold bg-slate-100 hover:bg-brand-50 text-slate-700 hover:text-brand-700 border border-slate-300 hover:border-brand-300 transition-colors cursor-pointer"
                                                        title="Abrir chat y seguimiento remoto con el usuario"
                                                    >
                                                        <span>Chat</span>
                                                        <% if (t.total_comentarios > 0) { %>
                                                             <span class="text-[9px] text-slate-500">(<%= t.total_comentarios %>)</span>
                                                        <% } %>
                                                        <span 
                                                            id="badgeChatAdminTicket-<%= t.id %>"
                                                            style="<%= (t.no_leidos_admin && t.no_leidos_admin > 0) ? '' : 'display:none;' %>"
                                                            class="px-1 py-0.1 rounded-full text-[9px] font-extrabold bg-brand-600 text-white animate-bounce"
                                                        ><%= t.no_leidos_admin || 0 %></span>
                                                    </button>

                                                    <!-- Botón Registrar Avance Colaborativo TI -->
                                                    <button 
                                                        type="button" 
                                                        data-ticket-id="<%= t.id %>"
                                                        data-ticket-titulo="<%= t.titulo %>"
                                                        data-ticket-estatus="<%= t.estatus %>"
                                                        data-atendido-actual="<%= t.atendido_por || '' %>"
                                                        onclick="abrirModalRegistrarAvance(this)"
                                                        class="inline-flex items-center gap-1 px-2 py-1 rounded text-[10px] font-bold bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 transition-colors cursor-pointer"
                                                        title="Registrar quién avanzó, diagnosticó o intervino en esta etapa"
                                                    >
                                                        <span>Avance</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Historial de Fechas, Horas y Especialistas por Etapa -->
                                        <td class="py-3 px-4">
                                            <div class="min-w-[180px]">
                                                <% 
                                                    const histItems = (t.historial && t.historial.length > 0) ? t.historial : [];
                                                    const ultimoHist = histItems.length > 0 ? histItems[histItems.length - 1] : null;
                                                    const anterioresHist = histItems.length > 1 ? histItems.slice(0, histItems.length - 1).reverse() : [];

                                                    function obtenerClasesBadgeEstatus(est) {
                                                        const e = (est || '').trim();
                                                        if (e === 'Nuevo ticket') {
                                                            return { badge: 'bg-sky-50 text-sky-700 border border-sky-200', dot: 'bg-sky-500' };
                                                        } else if (e === 'Pendiente') {
                                                            return { badge: 'bg-rose-50 text-rose-700 border border-rose-200', dot: 'bg-rose-500' };
                                                        } else if (e === 'Pendiente por cliente' || e.includes('cliente')) {
                                                            return { badge: 'bg-orange-100 text-orange-800 border border-orange-300', dot: 'bg-orange-500' };
                                                        } else if (e === 'En proceso') {
                                                            return { badge: 'bg-amber-50 text-amber-700 border border-amber-200', dot: 'bg-amber-500' };
                                                        } else if (e === 'Resuelto') {
                                                            return { badge: 'bg-emerald-50 text-emerald-700 border border-emerald-200', dot: 'bg-emerald-500' };
                                                        }
                                                        return { badge: 'bg-slate-100 text-slate-700 border border-slate-200', dot: 'bg-slate-400' };
                                                    }
                                                %>

                                                <% if (ultimoHist) { 
                                                    const estiloUltimo = obtenerClasesBadgeEstatus(ultimoHist.estatus);
                                                %>
                                                    <div class="flex items-start justify-between gap-1">
                                                        <div>
                                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold <%= estiloUltimo.badge %>">
                                                                <span class="w-1.5 h-1.5 rounded-full <%= estiloUltimo.dot %>"></span>
                                                                <%= ultimoHist.estatus %>
                                                            </span>
                                                            <% if (ultimoHist.usuario_nombre) { %>
                                                                <div class="text-[10px] font-bold text-slate-700 mt-0.5">
                                                                    <%= ultimoHist.usuario_nombre %>
                                                                </div>
                                                            <% } %>
                                                            <% if (ultimoHist.detalle) { %>
                                                                <div class="text-[10px] text-slate-500 italic line-clamp-1" title="<%= ultimoHist.detalle %>">
                                                                    "<%= ultimoHist.detalle %>"
                                                                </div>
                                                            <% } %>
                                                            <div class="text-[10px] text-slate-500 mt-0.5">
                                                                <%= new Date(ultimoHist.fecha).toLocaleDateString('es-ES') %>
                                                                ⏰ <%= new Date(ultimoHist.fecha).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) %>
                                                            </div>
                                                        </div>
                                                        <button 
                                                            type="button" 
                                                            onclick="abrirModalEliminarHistorial('<%= ultimoHist.id %>')" 
                                                            title="Eliminar este cambio de historial"
                                                            class="text-slate-400 hover:text-brand-600 hover:bg-brand-50 px-1 py-0.5 rounded text-xs transition-colors cursor-pointer"
                                                        >
                                                            ✕
                                                        </button>
                                                    </div>

                                                    <% if (anterioresHist.length > 0) { %>
                                                        <details class="historial-desplegable mt-1.5 pt-1 border-t border-slate-200">
                                                            <summary class="flex items-center justify-between text-[10px] font-bold text-brand-600 hover:text-brand-700 bg-slate-50 px-1.5 py-0.5 rounded border border-slate-200 cursor-pointer">
                                                                <span>⏱️ Anteriores (<%= anterioresHist.length %>)</span>
                                                            </summary>
                                                            <ul class="pl-2 mt-1 space-y-1 border-l-2 border-slate-200">
                                                                <% anterioresHist.forEach(h => { 
                                                                    const estiloAnt = obtenerClasesBadgeEstatus(h.estatus);
                                                                %>
                                                                    <li class="flex items-start justify-between gap-1 pt-0.5 border-b border-slate-100 pb-0.5">
                                                                        <div>
                                                                            <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded text-[9px] font-bold <%= estiloAnt.badge %>">
                                                                                <span class="w-1.5 h-1.5 rounded-full <%= estiloAnt.dot %>"></span>
                                                                                <%= h.estatus %>
                                                                            </span>
                                                                            <% if (h.usuario_nombre) { %>
                                                                                <div class="text-[9px] font-bold text-slate-600">
                                                                                    <%= h.usuario_nombre %>
                                                                                </div>
                                                                            <% } %>
                                                                            <% if (h.detalle) { %>
                                                                                <div class="text-[9px] text-slate-500 italic">
                                                                                    <%= h.detalle %>
                                                                                </div>
                                                                            <% } %>
                                                                            <div class="text-[9px] text-slate-400">
                                                                                <%= new Date(h.fecha).toLocaleDateString('es-ES') %> <%= new Date(h.fecha).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) %>
                                                                            </div>
                                                                        </div>
                                                                        <button 
                                                                            type="button" 
                                                                            onclick="abrirModalEliminarHistorial('<%= h.id %>')" 
                                                                            title="Eliminar este registro"
                                                                            class="text-slate-400 hover:text-brand-600 text-xs px-1"
                                                                        >
                                                                            ✕
                                                                        </button>
                                                                    </li>
                                                                <% }) %>
                                                            </ul>
                                                        </details>
                                                    <% } %>

                                                <% } else { 
                                                    const estiloFallback = obtenerClasesBadgeEstatus(t.estatus);
                                                %>
                                                    <div>
                                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold <%= estiloFallback.badge %>">
                                                            <span class="w-1.5 h-1.5 rounded-full <%= estiloFallback.dot %>"></span>
                                                            <%= t.estatus %>
                                                        </span>
                                                        <div class="text-[10px] text-slate-500 mt-0.5">
                                                            <%= new Date(t.fecha).toLocaleDateString('es-ES') %>
                                                            ⏰ <%= new Date(t.fecha).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) %>
                                                        </div>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                                <tr id="filaSinCoincidenciasTickets" style="display: none;">
                                    <td colspan="9" class="py-10 text-center text-slate-400 italic">
                                        No se encontraron tickets que coincidan con los criterios de búsqueda.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
            </section>

            <!-- MÓDULO 2: LEVANTAR NUEVO TICKET PARA UN USUARIO -->
            <section id="modulo-crear-ticket" class="modulo-admin space-y-4" style="display: none;">
                <div class="bg-white rounded-md shadow-xs border border-slate-200 p-6 border-t-4 border-t-emerald-600 space-y-4">
                    <div class="border-b border-slate-100 pb-3 flex items-center justify-between">
                        <div>
                            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                                
                                <span>Levantar Nuevo Ticket para un Usuario (Atención Telefónica / Presencial)</span>
                            </h3>
                            <p class="text-xs text-slate-500 mt-0.5">Genera el reporte a nombre del usuario para que quede en su historial y reciba su correo de confirmación.</p>
                        </div>
                    </div>

                    <form action="/admin/tickets/crear" method="POST" enctype="multipart/form-data" onsubmit="prevenirDobleEnvio(this)" class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            
                            <!-- Solicitante con Buscador Integrado -->
                            <div class="md:col-span-2 rounded-md bg-emerald-50/70 border border-emerald-200 p-4 space-y-2.5">
                                <div class="flex items-center justify-between gap-2 flex-wrap">
                                    <label class="block text-xs font-bold uppercase tracking-wider text-emerald-900">
                                        Seleccionar Usuario Solicitante <span class="text-brand-600">*</span>:
                                    </label>
                                    <span id="badgeAdminUsuarioSelect" class="text-[11px] font-bold px-2 py-0.5 rounded bg-white text-emerald-800 border border-emerald-200">
                                        <%= (usuarios || []).length %> usuario<%= (usuarios || []).length === 1 ? '' : 's' %> disponible<%= (usuarios || []).length === 1 ? '' : 's' %>
                                    </span>
                                </div>

                                <!-- Buscador en tiempo real para filtrar solicitante -->
                                <div class="relative">
                                    <input 
                                        type="text" 
                                        id="buscarAdminUsuarioSelect" 
                                        oninput="filtrarSelectorUsuario('buscarAdminUsuarioSelect', 'adminUsuarioSelect', 'badgeAdminUsuarioSelect', 'btnClearAdminUsuarioSelect', 'sugerenciasAdminUsuarioSelect')" 
                                        placeholder="Escribe para buscar solicitante por nombre, puesto o correo electrónico..." 
                                        autocomplete="off"
                                        class="w-full rounded border border-emerald-300 pl-8 pr-8 py-2 text-xs text-slate-900 placeholder-slate-400 bg-white focus:border-emerald-600 focus:outline-none shadow-2xs"
                                    >
                                    
                                    <button 
                                        type="button" 
                                        id="btnClearAdminUsuarioSelect" 
                                        onclick="limpiarBuscadorSelectorUsuario('buscarAdminUsuarioSelect', 'adminUsuarioSelect', 'badgeAdminUsuarioSelect', 'btnClearAdminUsuarioSelect', 'sugerenciasAdminUsuarioSelect')" 
                                        style="display: none;" 
                                        class="absolute right-2.5 top-2 text-slate-400 hover:text-slate-700 text-xs font-bold cursor-pointer"
                                        title="Limpiar búsqueda"
                                    >✕</button>
                                </div>

                                <!-- Lista de sugerencias rápidas al escribir -->
                                <div id="sugerenciasAdminUsuarioSelect" style="display: none;" class="max-h-40 overflow-y-auto rounded border border-emerald-200 bg-white divide-y divide-slate-100 shadow-xs text-xs"></div>

                                <select 
                                    name="usuario_id" 
                                    id="adminUsuarioSelect" 
                                    required 
                                    class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none bg-white shadow-2xs font-medium"
                                >
                                    <option value="" disabled selected>-- Elige al usuario que reporta la falla --</option>
                                    <% (usuarios || []).forEach(u => { %>
                                        <option value="<%= u.id %>"><%= u.nombre %><%= u.puesto ? ' (' + u.puesto + ')' : '' %> — <%= u.email %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <!-- Título breve -->
                            <div class="md:col-span-2">
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                    Título breve de la falla <span class="text-brand-600">*</span>
                                </label>
                                <input 
                                    type="text" 
                                    name="titulo" 
                                    required 
                                    placeholder="Ej. Computadora no enciende / Problema en Outlook / Sin internet"
                                    class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none shadow-2xs"
                                >
                            </div>

                            <!-- Categoría -->
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                    Tipo de Falla / Categoría <span class="text-brand-600">*</span>
                                </label>
                                <select 
                                    name="tipo_falla" 
                                    id="adminCategoriaSelect" 
                                    required 
                                    onchange="manejarCambioCategoriaAdmin()"
                                    class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none shadow-2xs bg-white"
                                >
                                    <option value="" disabled selected>-- Selecciona la categoría / área afectada --</option>
                                    <% if (typeof categorias !== 'undefined' && categorias && categorias.length > 0) { %>
                                        <% categorias.forEach(c => { %>
                                            <option value="<%= c.nombre %>"><%= c.nombre %></option>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>

                            <!-- Prioridad -->
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                    Nivel de Prioridad <span class="text-brand-600">*</span>
                                </label>
                                <select 
                                    name="prioridad" 
                                    required
                                    class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none shadow-2xs bg-white"
                                >
                                    <option value="Baja">Baja (No impide realizar tareas críticas)</option>
                                    <option value="Media" selected>Media (Afecta parcialmente las tareas)</option>
                                    <option value="Alta">Alta (Trabajo totalmente detenido)</option>
                                </select>
                            </div>

                            <!-- Subcategoría condicional -->
                            <div 
                                id="adminGrupoSubcategoria" 
                                style="display: none;" 
                                class="md:col-span-2 rounded-md bg-brand-50/50 border border-brand-200 p-4"
                            >
                                <label id="adminSubcategoriaLabel" class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1">
                                    Especificar Dispositivo / Componente Afectado:
                                </label>
                                <select 
                                    name="subcategoria" 
                                    id="adminSubcategoriaSelect"
                                    class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none shadow-2xs bg-white"
                                >
                                    <option value="">-- Selecciona una opción (opcional) --</option>
                                </select>
                            </div>

                            <!-- Descripción detallada -->
                            <div class="md:col-span-2">
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                    Descripción detallada del problema <span class="text-brand-600">*</span>
                                </label>
                                <textarea 
                                    name="descripcion" 
                                    rows="3" 
                                    required 
                                    placeholder="Describe los detalles de la falla reportada por el usuario durante la llamada o atención directa..."
                                    class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none shadow-2xs"
                                ></textarea>
                            </div>

                            <!-- Evidencia -->
                            <div class="md:col-span-2">
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                    Adjuntar Captura o Fotografía de Evidencia (Opcional)
                                </label>
                                <input 
                                    type="file" 
                                    name="imagen" 
                                    accept="image/*"
                                    class="block w-full text-xs text-slate-500 file:mr-4 file:py-1 file:px-3 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100 cursor-pointer border border-slate-300 rounded p-1 bg-white shadow-2xs"
                                >
                            </div>

                        </div>

                        <div class="pt-2 flex justify-end">
                            <button 
                                type="submit" 
                                class="inline-flex items-center gap-2 py-2 px-5 rounded-md shadow-xs text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-all cursor-pointer"
                            >
                                Registrar Ticket para este Usuario
                            </button>
                        </div>
                    </form>
                </div>
            </section>

            <!-- MÓDULO 3: GESTIÓN DE CATEGORÍAS Y SUBCATEGORÍAS -->
            <section id="modulo-categorias" class="modulo-admin space-y-4" style="display: none;">
                <div class="bg-white rounded-md shadow-xs border border-slate-200 p-6 border-t-4 border-t-brand-600 space-y-4">
                    <div class="flex justify-between items-center pb-3 border-b border-slate-100 flex-wrap gap-3">
                        <div>
                            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                                
                                <span>Gestión de Tipos de Falla y Áreas Afectadas (Categorías)</span>
                            </h3>
                            <p class="text-xs text-slate-500 mt-0.5">Crea, edita o elimina las categorías y subcategorías para la clasificación de reportes.</p>
                        </div>
                        <button 
                            type="button" 
                            onclick="abrirModalCrearCategoria()" 
                            class="inline-flex items-center gap-1.5 py-1.5 px-3.5 rounded-md text-xs font-bold text-white bg-brand-600 hover:bg-brand-700 shadow-xs transition-all cursor-pointer"
                        >
                            Nueva Categoría
                        </button>
                    </div>

                    <!-- Barra de Búsqueda de Categorías y Subcategorías -->
                    <div class="bg-slate-50/80 border border-slate-200 rounded-md p-3 flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center justify-between">
                        <div class="relative flex-1">
                            <input 
                                type="text" 
                                id="buscarCategoriasAdmin" 
                                oninput="filtrarTablaCategoriasAdmin()" 
                                placeholder="Buscar categoría o subcategoría (ej. Impresora, Red, Hardware, Mouse)..." 
                                class="w-full rounded-md border border-slate-300 pl-8 pr-7 py-1.5 text-xs text-slate-900 placeholder-slate-400 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                            >
                            
                            <button 
                                type="button" 
                                id="btnClearBuscarCategorias" 
                                onclick="document.getElementById('buscarCategoriasAdmin').value=''; filtrarTablaCategoriasAdmin();" 
                                style="display: none;" 
                                class="absolute right-2 top-1.5 text-slate-400 hover:text-slate-600 text-xs font-bold cursor-pointer"
                                title="Limpiar búsqueda"
                            >✕</button>
                        </div>
                        <span id="contadorCategoriasVisibles" class="text-[11px] font-bold text-slate-500 bg-white px-2.5 py-1 rounded border border-slate-200 whitespace-nowrap self-end sm:self-auto">
                            Mostrando <%= (categorias || []).length %> de <%= (categorias || []).length %>
                        </span>
                    </div>

                    <div class="overflow-x-auto w-full rounded-md border border-slate-200">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold uppercase tracking-wider text-slate-600">
                                    <th class="py-3 px-4 w-1/4">Categoría (Tipo de Falla)</th>
                                    <th class="py-3 px-4">Subcategorías / Dispositivos Asignados</th>
                                    <th class="py-3 px-4 w-44 text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (!categorias || categorias.length === 0) { %>
                                    <tr><td colspan="3" class="py-8 text-center text-slate-400 italic">No hay categorías registradas en el sistema.</td></tr>
                                <% } %>
                                <% (categorias || []).forEach(cat => { %>
                                    <tr 
                                        class="fila-categoria-admin hover:bg-slate-50 transition-colors"
                                        data-search="<%= ((cat.nombre || '') + ' ' + (cat.subcategorias || []).map(s => s.nombre).join(' ')).toLowerCase() %>"
                                    >
                                        <td class="py-3 px-4 font-bold text-slate-900 text-sm">
                                            <%= cat.nombre %>
                                        </td>
                                        <td class="py-3 px-4">
                                            <div class="flex flex-wrap items-center gap-1.5">
                                                <% if (cat.subcategorias && cat.subcategorias.length > 0) { %>
                                                    <% cat.subcategorias.forEach(sub => { %>
                                                        <span class="inline-flex items-center gap-1 bg-brand-50 text-brand-700 border border-brand-200 px-2 py-0.5 rounded text-[11px] font-bold">
                                                            <%= sub.nombre %>
                                                            <button 
                                                                type="button" 
                                                                onclick="confirmarEliminarSubcategoria('<%= sub.id %>', '<%= sub.nombre %>', '<%= cat.nombre %>')" 
                                                                title="Eliminar esta subcategoría"
                                                                class="text-brand-500 hover:text-brand-900 font-extrabold cursor-pointer text-xs ml-0.5"
                                                            >
                                                                ✕
                                                            </button>
                                                        </span>
                                                    <% }) %>
                                                <% } else { %>
                                                    <span class="text-slate-400 text-[11px] italic">Sin subcategorías (falla general)</span>
                                                <% } %>
                                                <button 
                                                    type="button" 
                                                    onclick="abrirModalAgregarSubcat('<%= cat.id %>', '<%= cat.nombre %>')" 
                                                    class="inline-flex items-center gap-1 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 border-dashed px-2 py-0.5 rounded text-[11px] font-semibold transition-colors cursor-pointer"
                                                    title="Agregar subcategoría a <%= cat.nombre %>"
                                                >
                                                    Nueva Subcategoría
                                                </button>
                                            </div>
                                        </td>
                                        <td class="py-3 px-4 text-center whitespace-nowrap">
                                            <div class="flex items-center justify-center gap-1.5">
                                                <button 
                                                    type="button" 
                                                    onclick="abrirModalEditarCategoria('<%= cat.id %>', '<%= cat.nombre %>')"
                                                    class="px-2.5 py-1 rounded text-[11px] font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-300 transition-colors cursor-pointer"
                                                >
                                                    Editar
                                                </button>
                                                <button 
                                                    type="button" 
                                                    onclick="abrirModalEliminarCategoria('<%= cat.id %>', '<%= cat.nombre %>')"
                                                    class="px-2.5 py-1 rounded text-[11px] font-bold text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 transition-colors cursor-pointer"
                                                >
                                                    Eliminar
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                                <tr id="filaSinCoincidenciasCategorias" style="display: none;">
                                    <td colspan="3" class="py-8 text-center text-slate-400 italic">
                                        No se encontraron categorías o subcategorías con ese nombre.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- MÓDULO 4: USUARIOS REGISTRADOS -->
            <section id="modulo-usuarios" class="modulo-admin space-y-4" style="display: none;">
                <div class="bg-white rounded-md shadow-xs border border-slate-200 p-6 border-t-4 border-t-brand-600 space-y-4">
                    <div class="flex justify-between items-center pb-3 border-b border-slate-100 flex-wrap gap-3">
                        <div>
                            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                                <span></span>
                                <span>Usuarios Registrados en el Sistema</span>
                            </h3>
                            <p class="text-xs text-slate-500 mt-0.5">Control de cuentas de acceso, roles, contraseñas y equipos asignados.</p>
                        </div>
                        <button 
                            type="button" 
                            onclick="cambiarModuloAdmin('crear-usuario')" 
                            class="inline-flex items-center gap-1.5 py-1.5 px-3.5 rounded-md text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-xs transition-all cursor-pointer"
                        >
                            Nuevo Usuario
                        </button>
                    </div>

                    <!-- Barra de Búsqueda y Filtros de Usuarios -->
                    <div class="bg-slate-50/80 border border-slate-200 rounded-md p-3.5 flex flex-col lg:flex-row gap-2.5 items-stretch lg:items-center justify-between">
                        <div class="flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center flex-1 flex-wrap">
                            <!-- Buscador por nombre, puesto, correo o ID -->
                            <div class="relative flex-1 min-w-[230px]">
                                <input 
                                    type="text" 
                                    id="buscarUsuariosTabla" 
                                    oninput="filtrarTablaUsuariosRegistrados()" 
                                    placeholder="Buscar usuario por nombre, puesto, correo electrónico o #ID..." 
                                    class="w-full rounded-md border border-slate-300 pl-8 pr-7 py-1.5 text-xs text-slate-900 placeholder-slate-400 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                                >
                                
                                <button 
                                    type="button" 
                                    id="btnClearBuscarUsuarios" 
                                    onclick="document.getElementById('buscarUsuariosTabla').value=''; filtrarTablaUsuariosRegistrados();" 
                                    style="display: none;" 
                                    class="absolute right-2 top-1.5 text-slate-400 hover:text-slate-600 text-xs font-bold cursor-pointer"
                                    title="Limpiar búsqueda"
                                >✕</button>
                            </div>

                            <!-- Filtro por Rol -->
                            <div class="min-w-[165px]">
                                <select 
                                    id="filtroUsuariosRol" 
                                    onchange="filtrarTablaUsuariosRegistrados()" 
                                    class="w-full rounded-md border border-slate-300 px-3 py-1.5 text-xs text-slate-900 bg-white font-medium focus:border-brand-600 focus:outline-none shadow-2xs"
                                >
                                    <option value="">Todos los roles</option>
                                    <option value="admin">Administradores</option>
                                    <option value="usuario">Usuarios Estándar</option>
                                </select>
                            </div>

                            <!-- Filtro por Equipos Asignados -->
                            <div class="min-w-[175px]">
                                <select 
                                    id="filtroUsuariosEquipos" 
                                    onchange="filtrarTablaUsuariosRegistrados()" 
                                    class="w-full rounded-md border border-slate-300 px-3 py-1.5 text-xs text-slate-900 bg-white font-medium focus:border-brand-600 focus:outline-none shadow-2xs"
                                >
                                    <option value="">Equipos: Todos</option>
                                    <option value="con">Con equipos asignados</option>
                                    <option value="sin">Sin equipos asignados</option>
                                </select>
                            </div>
                        </div>

                        <div class="flex items-center justify-between sm:justify-end gap-2">
                            <span id="contadorUsuariosVisibles" class="text-[11px] font-bold text-slate-500 bg-white px-2.5 py-1 rounded border border-slate-200 whitespace-nowrap">
                                Mostrando <%= (usuarios || []).length %> de <%= (usuarios || []).length %>
                            </span>
                            <button 
                                type="button" 
                                onclick="limpiarFiltrosUsuariosRegistrados()" 
                                class="px-3 py-1.5 rounded-md bg-white hover:bg-slate-100 text-slate-600 border border-slate-300 text-xs font-bold transition-colors cursor-pointer whitespace-nowrap"
                            >
                                Limpiar Filtros
                            </button>
                        </div>
                    </div>

                    <div class="overflow-x-auto w-full rounded-md border border-slate-200">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold uppercase tracking-wider text-slate-600">
                                    <th class="py-3 px-4 w-16">ID</th>
                                    <th class="py-3 px-4">Nombre</th>
                                    <th class="py-3 px-4">Correo</th>
                                    <th class="py-3 px-4">Puesto</th>
                                    <th class="py-3 px-4">Contraseña</th>
                                    <th class="py-3 px-4">Rol</th>
                                    <th class="py-3 px-4">Equipos Asignados</th>
                                    <th class="py-3 px-4 text-center w-40">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% (usuarios || []).forEach(u => { %>
                                    <% const equiposDeUsuario = (equipos || []).filter(e => e.usuario_id === u.id); %>
                                    <tr 
                                        class="fila-usuario-registrado hover:bg-slate-50 transition-colors"
                                        data-rol="<%= u.rol %>"
                                        data-equipos="<%= equiposDeUsuario.length %>"
                                        data-search="<%= ('#' + u.id + ' ' + u.id + ' ' + (u.nombre || '') + ' ' + (u.email || '') + ' ' + (u.puesto || '') + ' ' + (u.rol === 'admin' ? 'administrador admin' : 'usuario estandar')).toLowerCase() %>"
                                    >
                                        <td class="py-3 px-4 font-bold text-slate-600">#<%= u.id %></td>
                                        <td class="py-3 px-4 font-semibold text-slate-900"><%= u.nombre %></td>
                                        <td class="py-3 px-4 text-slate-600"><%= u.email %></td>
                                        <td class="py-3 px-4">
                                            <% if (u.puesto && u.puesto.trim() !== '') { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-100 text-slate-800 border border-slate-200">
                                                    
                                                    <span><%= u.puesto %></span>
                                                </span>
                                            <% } else { %>
                                                <span class="text-slate-400 italic text-[11px]">Sin especificar</span>
                                            <% } %>
                                        </td>
                                        <td class="py-3 px-4 whitespace-nowrap">
                                            <span id="pass-hidden-<%= u.id %>" class="text-slate-400">••••••••</span>
                                            <span id="pass-shown-<%= u.id %>" style="display: none;" class="font-mono font-bold text-slate-900 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">
                                                <%= u.password_plana || 'N/A' %>
                                            </span>
                                            <button 
                                                type="button" 
                                                onclick="togglePass('<%= u.id %>')" 
                                                title="Ver/Ocultar Contraseña" 
                                                class="ml-1.5 text-slate-400 hover:text-slate-600 text-sm cursor-pointer"
                                            >
                                                Mostrar
                                            </button>
                                        </td>
                                        <td class="py-3 px-4">
                                            <% if (u.rol === 'admin') { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-brand-50 text-brand-700 border border-brand-200">
                                                    Administrador
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                                    Usuario Estándar
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="py-3 px-4 whitespace-nowrap">
                                            <button 
                                                type="button" 
                                                onclick="verEquiposDeUsuario('<%= u.id %>')" 
                                                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-bold <%= equiposDeUsuario.length > 0 ? 'bg-slate-100 text-slate-800 hover:bg-slate-200 border border-slate-300' : 'bg-slate-50 text-slate-400 border border-slate-200 hover:bg-slate-100' %> transition-colors cursor-pointer"
                                                title="Ver equipos y periféricos asignados a <%= u.nombre %>"
                                            >
                                                
                                                <span><%= equiposDeUsuario.length %> componente<%= equiposDeUsuario.length === 1 ? '' : 's' %></span>
                                            </button>
                                        </td>
                                        <td class="py-3 px-4 text-center whitespace-nowrap">
                                            <div class="inline-flex items-center gap-1.5 justify-center">
                                                <button 
                                                    type="button" 
                                                    data-id="<%= u.id %>"
                                                    data-nombre="<%= u.nombre %>"
                                                    data-email="<%= u.email %>"
                                                    data-puesto="<%= u.puesto || '' %>"
                                                    data-rol="<%= u.rol %>"
                                                    data-password="<%= u.password_plana || '' %>"
                                                    onclick="abrirModalEditarUsuario(this)" 
                                                    class="px-2.5 py-1 rounded text-[11px] font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-300 transition-colors cursor-pointer inline-flex items-center gap-1"
                                                    title="Modificar datos de este usuario"
                                                >
                                                    <span>Editar</span>
                                                    <span>Modificar</span>
                                                </button>
                                                <% if (u.id !== adminId) { %>
                                                    <button 
                                                        type="button" 
                                                        onclick="abrirModalEliminar('<%= u.id %>', '<%= u.nombre.replace(/'/g, "\\'") %>')" 
                                                        class="px-2 py-1 rounded text-[11px] font-bold text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 transition-colors cursor-pointer"
                                                        title="Enviar usuario a la papelera"
                                                    >
                                                        Eliminar
                                                    </button>
                                                <% } else { %>
                                                    <span class="text-slate-400 text-[10px] font-medium italic">(Tu cuenta)</span>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                                <tr id="filaSinCoincidenciasUsuarios" style="display: none;">
                                    <td colspan="8" class="py-10 text-center text-slate-400 italic">
                                        No se encontraron usuarios con los criterios de búsqueda seleccionados.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- MÓDULO: EQUIPOS DE CÓMPUTO Y PERIFÉRICOS POR USUARIO -->
            <section id="modulo-equipos" class="modulo-admin space-y-4" style="display: none;">
                <div class="bg-white rounded-md shadow-xs border border-slate-200 p-6 border-t-4 border-t-brand-600 space-y-5">
                    
                    <!-- Encabezado del Módulo -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
                        <div>
                            <div class="flex items-center gap-2.5">
                                <span class="w-8 h-8 rounded-md bg-brand-50 text-brand-600 flex items-center justify-center text-lg font-bold border border-brand-200">
                                    💻
                                </span>
                                <div>
                                    <h3 class="text-base font-bold text-slate-900 tracking-tight">
                                        Inventario de Equipos y Periféricos por Usuario
                                    </h3>
                                    <p class="text-xs text-slate-500 mt-0.5">
                                        Control de componentes, PCs ensambladas, laptops y periféricos asignados a cada colaborador.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <button 
                            type="button" 
                            onclick="abrirModalCrearEquipo()" 
                            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-md bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs shadow-xs transition-colors cursor-pointer self-start sm:self-auto"
                        >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            <span>Asignar Nuevo Componente</span>
                        </button>
                    </div>

                    <!-- Métricas / Resumen rápido -->
                    <% 
                        const totalComponentes = (equipos || []).length;
                        const equiposPC = (equipos || []).filter(e => {
                            const t = (e.tipo || '').toLowerCase();
                            return t.includes('cpu') || t.includes('torre') || t.includes('ensamblad') || t.includes('laptop') || t.includes('computadora');
                        }).length;
                        const monitores = (equipos || []).filter(e => (e.tipo || '').toLowerCase().includes('monitor') || (e.tipo || '').toLowerCase().includes('pantalla')).length;
                        const perifericos = totalComponentes - equiposPC - monitores;
                    %>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <div class="bg-slate-50 border border-slate-200 rounded-md p-3">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 block">Total Componentes</span>
                            <span class="text-xl font-extrabold text-slate-900 mt-0.5 block" id="kpi-total-equipos"><%= totalComponentes %></span>
                        </div>
                        <div class="bg-slate-50 border border-slate-200 rounded-md p-3">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 block">PCs y Laptops</span>
                            <span class="text-xl font-extrabold text-brand-700 mt-0.5 block"><%= equiposPC %></span>
                        </div>
                        <div class="bg-slate-50 border border-slate-200 rounded-md p-3">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 block">Monitores</span>
                            <span class="text-xl font-extrabold text-slate-800 mt-0.5 block"><%= monitores %></span>
                        </div>
                        <div class="bg-slate-50 border border-slate-200 rounded-md p-3">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 block">Otros Periféricos</span>
                            <span class="text-xl font-extrabold text-slate-800 mt-0.5 block"><%= Math.max(0, perifericos) %></span>
                        </div>
                    </div>

                    <!-- Barra de Filtros y Búsqueda -->
                    <div class="bg-slate-50/80 border border-slate-200 rounded-md p-3.5 flex flex-col gap-3">
                        <div class="flex flex-col lg:flex-row gap-2.5 items-stretch lg:items-center justify-between">
                            <div class="flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center flex-1 flex-wrap">
                                <!-- Buscador y Filtro por Usuario -->
                                <div class="flex items-center gap-1.5 min-w-[260px] flex-1 sm:flex-initial">
                                    <div class="relative w-36">
                                        <input 
                                            type="text" 
                                            id="buscarFiltroEquiposUsuario" 
                                            oninput="filtrarOpcionesSelectSimple('buscarFiltroEquiposUsuario', 'filtroEquiposUsuario', true)" 
                                            placeholder="Filtrar usuario..." 
                                            class="w-full rounded-md border border-slate-300 pl-6 pr-2 py-1.5 text-xs text-slate-900 placeholder-slate-400 bg-white focus:border-brand-600 focus:outline-none shadow-xs"
                                            title="Escribe el nombre del usuario para filtrar el selector"
                                        >
                                        
                                    </div>
                                    <select 
                                        id="filtroEquiposUsuario" 
                                        onchange="filtrarTablaEquipos()" 
                                        class="flex-1 rounded-md border border-slate-300 px-2.5 py-1.5 text-xs text-slate-900 bg-white font-medium focus:border-brand-600 focus:outline-none shadow-xs"
                                    >
                                        <option value="">Todos los usuarios (<%= (usuarios || []).length %>)</option>
                                        <% (usuarios || []).forEach(u => { %>
                                            <% const cuentaEq = (equipos || []).filter(e => e.usuario_id === u.id).length; %>
                                            <option value="<%= u.id %>"><%= u.nombre %> (<%= cuentaEq %> comp.)</option>
                                        <% }) %>
                                    </select>
                                </div>

                                <!-- Filtro por Tipo de Componente -->
                                <div class="min-w-[170px]">
                                    <select 
                                        id="filtroEquiposTipo" 
                                        onchange="filtrarTablaEquipos()" 
                                        class="w-full rounded-md border border-slate-300 px-3 py-1.5 text-xs text-slate-900 bg-white font-medium focus:border-brand-600 focus:outline-none shadow-xs"
                                    >
                                        <option value="">Todos los componentes</option>
                                        <option value="Mouse">Mouse</option>
                                        <option value="Teclado">⌨️ Teclado</option>
                                        <option value="Monitor">Monitor</option>
                                        <option value="CPU / PC Torre">CPU / PC Torre</option>
                                        <option value="PC Ensamblada">PC Ensamblada</option>
                                        <option value="Laptop">Laptop</option>
                                        <option value="Diadema / Auriculares">Diadema / Auriculares</option>
                                        <option value="Impresora">Impresora / Escáner</option>
                                        <option value="UPS / No-Break">UPS / No-Break</option>
                                        <option value="Otro">Otro componente</option>
                                    </select>
                                </div>

                                <!-- Búsqueda en texto general -->
                                <div class="flex-1 min-w-[220px] relative">
                                    <input 
                                        type="text" 
                                        id="filtroEquiposBuscar" 
                                        oninput="filtrarTablaEquipos()" 
                                        placeholder="Buscar por usuario, marca, modelo, serie o especificaciones..." 
                                        class="w-full rounded-md border border-slate-300 pl-8 pr-7 py-1.5 text-xs text-slate-900 placeholder-slate-400 bg-white focus:border-brand-600 focus:outline-none shadow-xs"
                                    >
                                    
                                    <button 
                                        type="button" 
                                        id="btnClearBuscarEquipos" 
                                        onclick="document.getElementById('filtroEquiposBuscar').value=''; filtrarTablaEquipos();" 
                                        style="display: none;" 
                                        class="absolute right-2 top-1.5 text-slate-400 hover:text-slate-600 text-xs font-bold cursor-pointer"
                                        title="Limpiar búsqueda"
                                    >✕</button>
                                </div>
                            </div>

                            <div class="flex items-center justify-between sm:justify-end gap-2">
                                <span id="contadorEquiposVisibles" class="text-[11px] font-bold text-slate-500 bg-white px-2.5 py-1 rounded border border-slate-200 whitespace-nowrap">
                                    Mostrando <%= (equipos || []).length %> de <%= (equipos || []).length %>
                                </span>
                                <button 
                                    type="button" 
                                    onclick="limpiarFiltrosEquipos()" 
                                    class="px-3 py-1.5 rounded-md bg-white hover:bg-slate-100 text-slate-600 border border-slate-300 text-xs font-bold transition-colors cursor-pointer whitespace-nowrap"
                                >
                                    Limpiar Filtros
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Tabla de Componentes y Periféricos -->
                    <div class="overflow-x-auto w-full rounded-md border border-slate-200">
                        <table class="w-full text-left border-collapse text-xs" id="tablaEquiposUsuarios">
                            <thead>
                                <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold uppercase tracking-wider text-slate-600">
                                    <th class="py-3 px-4">Usuario Asignado</th>
                                    <th class="py-3 px-4">Componente</th>
                                    <th class="py-3 px-4">Marca</th>
                                    <th class="py-3 px-4">Modelo</th>
                                    <th class="py-3 px-4">Número de Serie</th>
                                    <th class="py-3 px-4">Estado</th>
                                    <th class="py-3 px-4 max-w-xs">Especificaciones / Detalles</th>
                                    <th class="py-3 px-4 whitespace-nowrap">Fecha Registro</th>
                                    <th class="py-3 px-4 text-center w-24">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (!equipos || equipos.length === 0) { %>
                                    <tr id="filaSinEquiposDefault">
                                        <td colspan="9" class="py-12 text-center text-slate-400 italic">
                                            <div class="w-8 h-8 mx-auto mb-2 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 font-bold text-xs">TI</div>
                                            No hay equipos o periféricos registrados todavía.<br>
                                            <button 
                                                type="button" 
                                                onclick="abrirModalCrearEquipo()" 
                                                class="mt-3 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-brand-600 text-white font-bold text-xs hover:bg-brand-700 transition-colors"
                                            >
                                                Registrar Primer Componente
                                            </button>
                                        </td>
                                    </tr>
                                <% } %>
                                <% (equipos || []).forEach(eq => { %>
                                    <tr 
                                        class="fila-equipo hover:bg-slate-50 transition-colors" 
                                        data-usuario-id="<%= eq.usuario_id %>"
                                        data-tipo="<%= (eq.tipo || '').toLowerCase() %>"
                                        data-search="<%= ((eq.usuario_nombre || '') + ' ' + (eq.usuario_puesto || '') + ' ' + (eq.tipo || '') + ' ' + (eq.marca || '') + ' ' + (eq.modelo || '') + ' ' + (eq.numero_serie || '') + ' ' + (eq.detalles || '')).toLowerCase() %>"
                                    >
                                        <!-- Usuario -->
                                        <td class="py-3 px-4 whitespace-nowrap">
                                            <div class="font-bold text-slate-900"><%= eq.usuario_nombre %></div>
                                            <% if (eq.usuario_puesto) { %>
                                                <div class="text-[10px] font-semibold text-slate-600"><%= eq.usuario_puesto %></div>
                                            <% } %>
                                            <div class="text-[11px] text-slate-500"><%= eq.usuario_email %></div>
                                        </td>

                                        <!-- Tipo Componente con Icono Contextual -->
                                        <td class="py-3 px-4 whitespace-nowrap">
                                            <% 
                                                const tLower = (eq.tipo || '').toLowerCase();
                                                let icono = 'Equipo';
                                                if (tLower.includes('mouse') || tLower.includes('raton')) icono = 'Mouse';
                                                else if (tLower.includes('teclado')) icono = '⌨️';
                                                else if (tLower.includes('monitor') || tLower.includes('pantalla')) icono = 'Monitor';
                                                else if (tLower.includes('laptop') || tLower.includes('portatil')) icono = 'Laptop';
                                                else if (tLower.includes('ensamblad')) icono = 'PC';
                                                else if (tLower.includes('cpu') || tLower.includes('torre') || tLower.includes('computadora')) icono = 'CPU';
                                                else if (tLower.includes('diadema') || tLower.includes('auricular') || tLower.includes('audifono')) icono = 'Audio';
                                                else if (tLower.includes('impresora') || tLower.includes('escaner')) icono = 'Impresora';
                                                else if (tLower.includes('ups') || tLower.includes('break') || tLower.includes('regulador')) icono = 'UPS';
                                                else if (tLower.includes('disco') || tLower.includes('memoria') || tLower.includes('usb')) icono = 'Almacenamiento';
                                            %>
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-slate-100 text-slate-800 border border-slate-200">
                                                <span><%= icono %></span>
                                                <span><%= eq.tipo %></span>
                                            </span>
                                        </td>

                                        <!-- Marca -->
                                        <td class="py-3 px-4 font-semibold text-slate-800 whitespace-nowrap">
                                            <%= eq.marca || '-' %>
                                        </td>

                                        <!-- Modelo -->
                                        <td class="py-3 px-4 text-slate-700 whitespace-nowrap">
                                            <%= eq.modelo || '-' %>
                                        </td>

                                        <!-- Número de Serie -->
                                        <td class="py-3 px-4 whitespace-nowrap">
                                            <% if (eq.numero_serie) { %>
                                                <span class="font-mono text-[11px] font-bold text-slate-800 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">
                                                    <%= eq.numero_serie %>
                                                </span>
                                            <% } else { %>
                                                <span class="text-slate-400 italic">Sin serie</span>
                                            <% } %>
                                        </td>

                                        <!-- Estado -->
                                        <td class="py-3 px-4 whitespace-nowrap">
                                            <% const est = eq.estado || 'Operativo'; %>
                                            <% if (est === 'Nuevo' || est === 'Excelente') { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-sky-50 text-sky-700 border border-sky-200">
                                                    <%= est %>
                                                </span>
                                            <% } else if (est === 'Operativo' || est === 'Bueno') { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                    <%= est %>
                                                </span>
                                            <% } else if (est === 'Regular') { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                    <%= est %>
                                                </span>
                                            <% } else if (est === 'En revisión' || est === 'Mantenimiento') { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-purple-50 text-purple-700 border border-purple-200">
                                                    <%= est %>
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                                    <%= est %>
                                                </span>
                                            <% } %>
                                        </td>

                                        <!-- Especificaciones / Detalles -->
                                        <td class="py-3 px-4 max-w-xs text-slate-600">
                                            <% if (eq.detalles) { %>
                                                <p class="line-clamp-2 leading-relaxed" title="<%= eq.detalles %>">
                                                    <%= eq.detalles %>
                                                </p>
                                            <% } else { %>
                                                <span class="text-slate-400 italic text-[11px]">-</span>
                                            <% } %>
                                        </td>

                                        <!-- Fecha -->
                                        <td class="py-3 px-4 whitespace-nowrap text-slate-500 text-[11px]">
                                            <%= new Date(eq.fecha_registro).toLocaleDateString('es-ES') %>
                                        </td>

                                        <!-- Acciones -->
                                        <td class="py-3 px-4 text-center whitespace-nowrap">
                                            <div class="inline-flex items-center gap-1">
                                                <button 
                                                    type="button" 
                                                    onclick='abrirModalEditarEquipo(<%- JSON.stringify(eq) %>)' 
                                                    class="p-1.5 rounded hover:bg-slate-100 text-slate-600 hover:text-slate-900 border border-transparent hover:border-slate-300 transition-colors cursor-pointer"
                                                    title="Editar componente"
                                                >
                                                    Editar
                                                </button>
                                                <button 
                                                    type="button" 
                                                    onclick="abrirModalEliminarEquipo('<%= eq.id %>', '<%= eq.tipo %>', '<%= eq.usuario_nombre %>', '<%= eq.marca %>', '<%= eq.modelo %>')" 
                                                    class="p-1.5 rounded hover:bg-brand-50 text-slate-400 hover:text-brand-600 border border-transparent hover:border-brand-200 transition-colors cursor-pointer"
                                                    title="Eliminar de inventario"
                                                >
                                                    Eliminar
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                                <tr id="filaSinCoincidenciasEquipos" style="display: none;">
                                    <td colspan="9" class="py-10 text-center text-slate-400 italic">
                                        No se encontraron componentes con los filtros seleccionados.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- MÓDULO 5: CREAR NUEVO USUARIO -->
            <section id="modulo-crear-usuario" class="modulo-admin space-y-4" style="display: none;">
                <div class="bg-white rounded-md shadow-xs border border-slate-200 p-6 border-t-4 border-t-emerald-600 space-y-4 max-w-2xl">
                    <div class="border-b border-slate-100 pb-3">
                        <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                            
                            <span>Crear Nuevo Usuario</span>
                        </h3>
                        <p class="text-xs text-slate-500 mt-0.5">Ingresa los datos del empleado o técnico a dar de alta.</p>
                    </div>

                    <form action="/admin/crear-usuario" method="POST" class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                Nombre Completo <span class="text-brand-600">*</span>
                            </label>
                            <input 
                                type="text" 
                                name="nombre" 
                                required 
                                placeholder="Ej. Juan Pérez"
                                class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none shadow-2xs"
                            >
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                Correo Electrónico <span class="text-brand-600">*</span>
                            </label>
                            <input 
                                type="email" 
                                name="email" 
                                required 
                                placeholder="correo@grupocdm.mx"
                                class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none shadow-2xs"
                            >
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                Puesto / Cargo
                            </label>
                            <input 
                                type="text" 
                                name="puesto" 
                                placeholder="Ej. Especialista en compras, Contador general, Ventas..."
                                class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none shadow-2xs"
                            >
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                Contraseña Inicial <span class="text-brand-600">*</span>
                            </label>
                            <div class="relative">
                                <input 
                                    type="password" 
                                    id="crearUsuarioPassword"
                                    name="password" 
                                    required
                                    placeholder="••••••••"
                                    class="w-full rounded border border-slate-300 pl-3 pr-10 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none shadow-2xs"
                                >
                                <button 
                                    type="button" 
                                    onclick="toggleVerPassword('crearUsuarioPassword', this)" 
                                    title="Mostrar / Ocultar contraseña"
                                    class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600 focus:outline-none text-sm cursor-pointer"
                                >
                                    Mostrar
                                </button>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                Rol en la plataforma <span class="text-brand-600">*</span>
                            </label>
                            <select 
                                name="rol"
                                class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none shadow-2xs bg-white"
                            >
                                <option value="usuario">Usuario Estándar (Reporta fallas)</option>
                                <option value="admin">Administrador (Atención y resolución TI)</option>
                            </select>
                        </div>

                        <div class="pt-2">
                            <button 
                                type="submit" 
                                class="inline-flex items-center gap-2 py-2 px-5 rounded-md shadow-xs text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-all cursor-pointer"
                            >
                                Guardar y Crear Usuario
                            </button>
                        </div>
                    </form>
                </div>
            </section>

            <!-- MÓDULO 6: PAPELERA DE RECICLAJE (TICKETS Y USUARIOS) -->
            <section id="modulo-papelera" class="modulo-admin space-y-4" style="display: none;">
                <div class="bg-white rounded-md shadow-xs border border-slate-200 p-6 border-t-4 border-t-amber-500 space-y-5">
                    <div class="border-b border-slate-100 pb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                        <div>
                            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                                <span>Eliminar</span>
                                <span>Papelera de Reciclaje</span>
                            </h3>
                            <p class="text-xs text-slate-500 mt-0.5">Los tickets y usuarios eliminados se resguardan aquí. Puedes recuperarlos en cualquier momento conservando todo su historial y comentarios.</p>
                        </div>
                        
                        <!-- Selector de Sub-pestañas: Tickets vs Usuarios -->
                        <div class="inline-flex rounded-lg border border-slate-200 bg-slate-100 p-0.5 text-xs font-semibold self-start sm:self-auto">
                            <button 
                                type="button" 
                                id="btnTabPapeleraTickets"
                                onclick="mostrarSubtabPapelera('tickets')" 
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-bold transition-all shadow-xs bg-white text-slate-900 cursor-pointer"
                            >
                                <span> Tickets Eliminados</span>
                                <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                                    <%= (typeof ticketsEliminados !== 'undefined' ? ticketsEliminados.length : 0) %>
                                </span>
                            </button>
                            <button 
                                type="button" 
                                id="btnTabPapeleraUsuarios"
                                onclick="mostrarSubtabPapelera('usuarios')" 
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 cursor-pointer"
                            >
                                <span> Usuarios Eliminados</span>
                                <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-slate-200 text-slate-700">
                                    <%= (typeof usuariosEliminados !== 'undefined' ? usuariosEliminados.length : 0) %>
                                </span>
                            </button>
                        </div>
                    </div>

                    <!-- SUBTAB 1: TICKETS EN PAPELERA -->
                    <div id="subtabPapeleraTickets" class="space-y-4">
                        <!-- Barra de Búsqueda de Tickets en Papelera -->
                        <div class="bg-slate-50/80 border border-slate-200 rounded-md p-3 flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center justify-between">
                            <div class="relative flex-1">
                                <input 
                                    type="text" 
                                    id="buscarTicketsPapelera" 
                                    oninput="filtrarTablaTicketsPapelera()" 
                                    placeholder="Buscar ticket en papelera por #ID, título, categoría, solicitante o estatus..." 
                                    class="w-full rounded-md border border-slate-300 pl-8 pr-7 py-1.5 text-xs text-slate-900 placeholder-slate-400 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                                >
                                
                                <button 
                                    type="button" 
                                    id="btnClearBuscarTicketsPapelera" 
                                    onclick="document.getElementById('buscarTicketsPapelera').value=''; filtrarTablaTicketsPapelera();" 
                                    style="display: none;" 
                                    class="absolute right-2 top-1.5 text-slate-400 hover:text-slate-600 text-xs font-bold cursor-pointer"
                                    title="Limpiar búsqueda"
                                >✕</button>
                            </div>
                            <span id="contadorTicketsPapeleraVisibles" class="text-[11px] font-bold text-slate-500 bg-white px-2.5 py-1 rounded border border-slate-200 whitespace-nowrap self-end sm:self-auto">
                                Mostrando <%= (typeof ticketsEliminados !== 'undefined' ? ticketsEliminados.length : 0) %> de <%= (typeof ticketsEliminados !== 'undefined' ? ticketsEliminados.length : 0) %>
                            </span>
                        </div>

                        <div class="overflow-x-auto w-full rounded-md border border-slate-200">
                            <table class="w-full text-left border-collapse text-xs">
                                <thead>
                                    <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold uppercase tracking-wider text-slate-600">
                                        <th class="py-3 px-4 w-16">ID</th>
                                        <th class="py-3 px-4">Ticket / Falla</th>
                                        <th class="py-3 px-4">Solicitante</th>
                                        <th class="py-3 px-4 text-center">Prioridad</th>
                                        <th class="py-3 px-4 text-center">Estatus Previo</th>
                                        <th class="py-3 px-4">Fecha de Eliminación</th>
                                        <th class="py-3 px-4">Eliminado Por</th>
                                        <th class="py-3 px-4 text-center w-48">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    <% if (!ticketsEliminados || ticketsEliminados.length === 0) { %>
                                        <tr><td colspan="8" class="py-8 text-center text-slate-400 italic">No hay tickets en la papelera de reciclaje actualmente.</td></tr>
                                    <% } %>
                                    <% (ticketsEliminados || []).forEach(t => { %>
                                        <tr 
                                            class="fila-ticket-papelera hover:bg-slate-50 transition-colors"
                                            data-search="<%= ('#' + t.id + ' ' + t.id + ' ' + (t.titulo || '') + ' ' + (t.tipo_falla || '') + ' ' + (t.subcategoria || '') + ' ' + (t.usuario_nombre || '') + ' ' + (t.usuario_puesto || '') + ' ' + (t.estatus || '')).toLowerCase() %>"
                                        >
                                            <td class="py-3 px-4 font-bold text-slate-500">#<%= t.id %></td>
                                            <td class="py-3 px-4">
                                                <div class="font-bold text-slate-800 flex items-center gap-1.5 flex-wrap">
                                                    <span><%= t.titulo %></span>
                                                    <% if (t.editado) { %>
                                                        <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded text-[10px] font-bold bg-amber-50 text-amber-800 border border-amber-300">
                                                            Editado
                                                        </span>
                                                    <% } %>
                                                </div>
                                                <div class="text-[11px] text-slate-500"><%= t.tipo_falla %><%= t.subcategoria ? ' • ' + t.subcategoria : '' %></div>
                                            </td>
                                            <td class="py-3 px-4">
                                                <div class="font-semibold text-slate-700"><%= t.usuario_nombre %></div>
                                                <div class="text-[11px] text-slate-400"><%= t.usuario_puesto || '-' %></div>
                                            </td>
                                            <td class="py-3 px-4 text-center whitespace-nowrap">
                                                <span class="inline-block px-2 py-0.5 rounded text-[11px] font-bold 
                                                    <%= t.prioridad === 'Alta' ? 'bg-rose-100 text-rose-800' : (t.prioridad === 'Media' ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-700') %>">
                                                    <%= t.prioridad || 'Media' %>
                                                </span>
                                            </td>
                                            <td class="py-3 px-4 text-center whitespace-nowrap">
                                                <span class="inline-block px-2 py-0.5 rounded text-[11px] font-bold 
                                                    <%= t.estatus === 'Resuelto' ? 'bg-emerald-100 text-emerald-800' : (t.estatus === 'En Proceso' ? 'bg-sky-100 text-sky-800' : (t.estatus === 'En Espera de Refacción' ? 'bg-amber-100 text-amber-800' : (t.estatus === 'Por Confirmar' ? 'bg-purple-100 text-purple-800' : 'bg-rose-100 text-rose-800'))) %>">
                                                    <%= t.estatus %>
                                                </span>
                                            </td>
                                            <td class="py-3 px-4 text-slate-500 whitespace-nowrap">
                                                <%= new Date(t.deleted_at).toLocaleDateString('es-ES') %>
                                                ⏰ <%= new Date(t.deleted_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) %>
                                            </td>
                                            <td class="py-3 px-4 whitespace-nowrap">
                                                <% if (t.eliminado_por === 'usuario') { %>
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-purple-50 text-purple-700 border border-purple-200 text-[11px] font-bold" title="Cancelado y eliminado directamente por el usuario solicitante">
                                                        
                                                        <span>Usuario: <%= t.eliminado_por_nombre || t.usuario_nombre %></span>
                                                    </span>
                                                <% } else { %>
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-slate-100 text-slate-700 border border-slate-200 text-[11px] font-semibold" title="Eliminado por personal de soporte">
                                                        
                                                        <span>Administrador</span>
                                                    </span>
                                                <% } %>
                                            </td>
                                            <td class="py-3 px-4 text-center whitespace-nowrap">
                                                <div class="flex items-center justify-center gap-1.5">
                                                    <form action="/admin/tickets/recuperar" method="POST" style="display:inline;">
                                                        <input type="hidden" name="ticket_id" value="<%= t.id %>">
                                                        <button 
                                                            type="submit" 
                                                            class="inline-flex items-center gap-1 px-3 py-1 rounded text-[11px] font-bold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-colors cursor-pointer"
                                                            title="Recuperar ticket y devolverlo a la lista activa"
                                                        >
                                                            
                                                            <span>Restaurar Ticket</span>
                                                        </button>
                                                    </form>
                                                    <button 
                                                        type="button" 
                                                        onclick="abrirModalEliminarTicketDefinitivo(<%= t.id %>, '<%= (t.titulo || '').replace(/'/g, "\\'") %>')" 
                                                        class="p-1 px-2 rounded text-[11px] font-bold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-colors cursor-pointer"
                                                        title="Eliminar definitivamente del sistema"
                                                    >
                                                        Eliminar
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                    <tr id="filaSinCoincidenciasTicketsPapelera" style="display: none;">
                                        <td colspan="8" class="py-8 text-center text-slate-400 italic">
                                            No se encontraron tickets en papelera con ese criterio de búsqueda.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- SUBTAB 2: USUARIOS EN PAPELERA -->
                    <div id="subtabPapeleraUsuarios" class="space-y-4" style="display: none;">
                        <!-- Barra de Búsqueda en Papelera de Usuarios -->
                        <div class="bg-slate-50/80 border border-slate-200 rounded-md p-3 flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center justify-between">
                            <div class="relative flex-1">
                                <input 
                                    type="text" 
                                    id="buscarUsuariosPapelera" 
                                    oninput="filtrarTablaPapelera()" 
                                    placeholder="Buscar usuario en papelera por nombre, correo, puesto o #ID..." 
                                    class="w-full rounded-md border border-slate-300 pl-8 pr-7 py-1.5 text-xs text-slate-900 placeholder-slate-400 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                                >
                                
                                <button 
                                    type="button" 
                                    id="btnClearBuscarPapelera" 
                                    onclick="document.getElementById('buscarUsuariosPapelera').value=''; filtrarTablaPapelera();" 
                                    style="display: none;" 
                                    class="absolute right-2 top-1.5 text-slate-400 hover:text-slate-600 text-xs font-bold cursor-pointer"
                                    title="Limpiar búsqueda"
                                >✕</button>
                            </div>
                            <span id="contadorPapeleraVisibles" class="text-[11px] font-bold text-slate-500 bg-white px-2.5 py-1 rounded border border-slate-200 whitespace-nowrap self-end sm:self-auto">
                                Mostrando <%= (typeof usuariosEliminados !== 'undefined' ? usuariosEliminados.length : 0) %> de <%= (typeof usuariosEliminados !== 'undefined' ? usuariosEliminados.length : 0) %>
                            </span>
                        </div>

                        <div class="overflow-x-auto w-full rounded-md border border-slate-200">
                            <table class="w-full text-left border-collapse text-xs">
                                <thead>
                                    <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold uppercase tracking-wider text-slate-600">
                                        <th class="py-3 px-4 w-16">ID</th>
                                        <th class="py-3 px-4">Nombre</th>
                                        <th class="py-3 px-4">Correo</th>
                                        <th class="py-3 px-4">Puesto</th>
                                        <th class="py-3 px-4">Rol</th>
                                        <th class="py-3 px-4">Fecha de Eliminación</th>
                                        <th class="py-3 px-4 text-center w-36">Acción</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    <% if (!usuariosEliminados || usuariosEliminados.length === 0) { %>
                                        <tr><td colspan="7" class="py-8 text-center text-slate-400 italic">La papelera de usuarios está vacía actualmente.</td></tr>
                                    <% } %>
                                    <% (usuariosEliminados || []).forEach(u => { %>
                                        <tr 
                                            class="fila-usuario-papelera hover:bg-slate-50 transition-colors"
                                            data-search="<%= ('#' + u.id + ' ' + u.id + ' ' + (u.nombre || '') + ' ' + (u.email || '') + ' ' + (u.puesto || '') + ' ' + (u.rol || '')).toLowerCase() %>"
                                        >
                                            <td class="py-3 px-4 font-bold text-slate-500">#<%= u.id %></td>
                                            <td class="py-3 px-4 font-semibold text-slate-700"><%= u.nombre %></td>
                                            <td class="py-3 px-4 text-slate-500"><%= u.email %></td>
                                            <td class="py-3 px-4 text-slate-600"><%= u.puesto || '-' %></td>
                                            <td class="py-3 px-4 text-slate-500"><%= u.rol %></td>
                                            <td class="py-3 px-4 text-slate-500">
                                                <%= new Date(u.deleted_at).toLocaleDateString('es-ES') %>
                                                ⏰ <%= new Date(u.deleted_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) %>
                                            </td>
                                            <td class="py-3 px-4 text-center whitespace-nowrap">
                                                <div class="flex items-center justify-center gap-1.5">
                                                    <form action="/admin/recuperar-usuario" method="POST" style="display:inline;">
                                                        <input type="hidden" name="usuario_id" value="<%= u.id %>">
                                                        <button 
                                                            type="submit" 
                                                            class="inline-flex items-center gap-1 px-3 py-1 rounded text-[11px] font-bold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-colors cursor-pointer"
                                                            title="Restaurar cuenta de usuario a la lista activa"
                                                        >
                                                            
                                                            <span>Restaurar Cuenta</span>
                                                        </button>
                                                    </form>
                                                    <button 
                                                        type="button" 
                                                        onclick="abrirModalEliminarUsuarioDefinitivo(<%= u.id %>, '<%= (u.nombre || '').replace(/'/g, "\\'") %>', '<%= (u.email || '').replace(/'/g, "\\'") %>')" 
                                                        class="p-1 px-2 rounded text-[11px] font-bold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-colors cursor-pointer"
                                                        title="Eliminar usuario definitivamente del sistema"
                                                    >
                                                        Eliminar
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                    <tr id="filaSinCoincidenciasPapelera" style="display: none;">
                                        <td colspan="7" class="py-8 text-center text-slate-400 italic">
                                            No se encontraron usuarios eliminados con ese criterio.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>

            <!-- MÓDULO 7: CONFIGURACIÓN DE CORREO OUTLOOK Y PLANTILLAS -->
            <section id="modulo-correo" class="modulo-admin space-y-4" style="display: none;">
                <div class="bg-white rounded-md shadow-xs border border-slate-200 p-6 border-t-4 border-t-brand-600 space-y-6">
                    <div class="border-b border-slate-100 pb-3 flex flex-wrap items-center justify-between gap-2">
                        <div>
                            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                                
                                <span>Configuración de Correo Outlook y Plantillas Automáticas</span>
                            </h3>
                            <p class="text-xs text-slate-500 mt-0.5">Control de notificaciones por correo SMTP y personalización de mensajes.</p>
                        </div>
                        <button 
                            type="button" 
                            onclick="document.querySelector('[name=email_prueba]')?.scrollIntoView({ behavior: 'smooth', block: 'center' }); document.querySelector('[name=email_prueba]')?.focus();"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-2xs transition-all cursor-pointer"
                        >
                            
                            <span>Probar Envío de Correo</span>
                        </button>
                    </div>

                    <!-- SMTP Config -->
                    <div class="bg-slate-50 border border-slate-200 rounded-md p-5 space-y-4">
                        <strong class="text-sm font-bold text-slate-900 block">
                            Cuenta Remitente de Microsoft Outlook / Office 365
                        </strong>

                        <form action="/admin/config-correo/guardar" method="POST" class="space-y-4">
                            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                                <div class="sm:col-span-2">
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                        Correo Remitente <span class="text-brand-600">*</span>
                                    </label>
                                    <input 
                                        type="email" 
                                        name="email_remitente" 
                                        value="<%= (typeof configCorreo !== 'undefined' && configCorreo.email_remitente) ? configCorreo.email_remitente : '' %>" 
                                        required 
                                        placeholder="soporte@empresa.com"
                                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none bg-white shadow-2xs"
                                    >
                                </div>

                                <div>
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                        Contraseña / App Password
                                    </label>
                                    <div class="relative">
                                        <input 
                                            type="password" 
                                            id="smtpPassInput" 
                                            name="password_remitente" 
                                            value="<%= (typeof configCorreo !== 'undefined' && configCorreo.password_remitente) ? configCorreo.password_remitente : '' %>" 
                                            placeholder="Contraseña de aplicación"
                                            class="w-full rounded border border-slate-300 pl-3 pr-8 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none bg-white shadow-2xs"
                                        >
                                        <button 
                                            type="button" 
                                            onclick="togglePassSmtp()" 
                                            title="Ver/Ocultar contraseña"
                                            class="absolute inset-y-0 right-0 pr-2 flex items-center text-slate-400 hover:text-slate-600 cursor-pointer text-sm"
                                        >
                                            Mostrar
                                        </button>
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                        Servidor SMTP <span class="text-brand-600">*</span>
                                    </label>
                                    <input 
                                        type="text" 
                                        name="smtp_host" 
                                        value="<%= (typeof configCorreo !== 'undefined' && configCorreo.smtp_host) ? configCorreo.smtp_host : 'smtp-mail.outlook.com' %>" 
                                        required
                                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none bg-white shadow-2xs"
                                    >
                                </div>

                                <div>
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                        Puerto SMTP <span class="text-brand-600">*</span>
                                    </label>
                                    <input 
                                        type="number" 
                                        name="smtp_port" 
                                        value="<%= (typeof configCorreo !== 'undefined' && configCorreo.smtp_port) ? configCorreo.smtp_port : 587 %>" 
                                        required
                                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none bg-white shadow-2xs"
                                    >
                                </div>

                                <div>
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                        Nombre para Mostrar <span class="text-brand-600">*</span>
                                    </label>
                                    <input 
                                        type="text" 
                                        name="nombre_remitente" 
                                        value="<%= (typeof configCorreo !== 'undefined' && configCorreo.nombre_remitente) ? configCorreo.nombre_remitente : 'Sistema de Tickets' %>" 
                                        required 
                                        placeholder="Ej. Mesa de Ayuda TI"
                                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none bg-white shadow-2xs"
                                    >
                                </div>

                                <div class="sm:col-span-2 md:col-span-3 flex items-center gap-2 pt-1">
                                    <input 
                                        type="checkbox" 
                                        name="activo" 
                                        id="checkActivoCorreo" 
                                        value="1" 
                                        <%= (typeof configCorreo === 'undefined' || configCorreo.activo !== 0) ? 'checked' : '' %>
                                        class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 border-slate-300"
                                    >
                                    <label for="checkActivoCorreo" class="text-xs font-bold text-slate-700 cursor-pointer">
                                        Habilitar envío automático de correos electrónicos
                                    </label>
                                </div>
                            </div>

                            <div class="pt-1 flex flex-wrap items-center gap-2.5">
                                <button 
                                    type="submit" 
                                    class="inline-flex items-center gap-1.5 py-2 px-4 rounded-md shadow-xs text-xs font-bold text-white bg-brand-600 hover:bg-brand-700 transition-all cursor-pointer"
                                >
                                    Guardar Configuración de Correo
                                </button>
                                <button 
                                    type="button" 
                                    onclick="document.querySelector('[name=email_prueba]')?.scrollIntoView({ behavior: 'smooth', block: 'center' }); document.querySelector('[name=email_prueba]')?.focus();"
                                    class="inline-flex items-center gap-1.5 py-2 px-3.5 rounded-md border border-emerald-300 text-xs font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 transition-all cursor-pointer"
                                >
                                    Probar Envío de Correo
                                </button>
                            </div>
                        </form>

                        <!-- ========================================== -->
                        <!-- CARD DESTACADA: PROBAR ENVÍO DE CORREO SMTP -->
                        <!-- ========================================== -->
                        <div class="bg-gradient-to-r from-emerald-50 via-teal-50 to-emerald-50 border-2 border-emerald-400 rounded-lg p-5 shadow-xs space-y-4">
                            <div class="flex items-center justify-between flex-wrap gap-2">
                                <div class="flex items-center gap-2.5">
                                    
                                    <div>
                                        <h4 class="text-sm font-bold text-emerald-950 flex items-center gap-2">
                                            <span>Probar Envío de Correo y Conexión SMTP</span>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-extrabold bg-emerald-600 text-white tracking-wider uppercase">Diagnóstico en Vivo</span>
                                        </h4>
                                        <p class="text-xs text-emerald-800 mt-0.5">
                                            Envía un correo de prueba de inmediato para verificar que el servidor entrega correctamente las notificaciones.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <form action="/admin/config-correo/probar" method="POST" class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end bg-white p-3.5 rounded-md border border-emerald-200 shadow-2xs">
                                <div class="sm:col-span-5">
                                    <label class="block text-xs font-bold text-slate-700 mb-1">
                                        Enviar desde (Remitente):
                                    </label>
                                    <select 
                                        name="remitente_email" 
                                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-emerald-600 focus:outline-none bg-white shadow-2xs font-medium"
                                        title="Selecciona el remitente para la prueba"
                                    >
                                        <% 
                                            const adminsRemitentes = (typeof usuarios !== 'undefined' ? usuarios : []).filter(u => u.rol === 'admin');
                                            adminsRemitentes.forEach(adm => { 
                                        %>
                                            <option value="<%= adm.email %>" <%= ((typeof adminId !== 'undefined' && adminId === adm.id) || (typeof adminEmail !== 'undefined' && adminEmail === adm.email)) ? 'selected' : '' %>>
                                                <%= adm.nombre %> (<%= adm.email %>)
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="sm:col-span-4">
                                    <label class="block text-xs font-bold text-slate-700 mb-1">
                                        Enviar a (Destinatario):
                                    </label>
                                    <input 
                                        type="email" 
                                        name="email_prueba" 
                                        placeholder="tu_correo@grupo-cdm.mx" 
                                        value="<%= (typeof adminEmail !== 'undefined' && adminEmail) ? adminEmail : ((typeof configCorreo !== 'undefined' && configCorreo.email_remitente) ? configCorreo.email_remitente : '') %>"
                                        required 
                                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-emerald-600 focus:outline-none bg-white shadow-2xs font-medium"
                                    >
                                </div>

                                <div class="sm:col-span-3">
                                    <button 
                                        type="submit" 
                                        class="w-full inline-flex items-center justify-center gap-1.5 py-2 px-4 rounded-md text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 shadow-xs transition-all cursor-pointer whitespace-nowrap"
                                        title="Enviar correo de prueba ahora"
                                    >
                                        
                                        <span>Enviar Prueba Ahora</span>
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Panel de Administradores Habilitados como Remitentes -->
                        <div class="bg-slate-100/90 border border-slate-200 rounded-md p-4 space-y-2">
                            <div class="flex items-center gap-2">
                                
                                <strong class="text-xs font-bold text-slate-900 uppercase tracking-wide">
                                    Todos los Administradores están habilitados como Remitentes de Correo:
                                </strong>
                            </div>
                            <p class="text-[11px] text-slate-600 leading-relaxed">
                                Cualquier administrador que atienda, cambie el estatus o responda a un ticket enviará las notificaciones al usuario con <strong>su propio nombre y correo institucional</strong> como remitente automático.
                            </p>
                            <div class="flex flex-wrap gap-2 pt-1">
                                <% adminsRemitentes.forEach(adm => { %>
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-white border border-slate-300 text-[11px] font-semibold text-slate-800 shadow-2xs">
                                        
                                        <span><%= adm.nombre %></span>
                                        <span class="text-slate-500 font-mono text-[10px]">&lt;<%= adm.email %>&gt;</span>
                                    </span>
                                <% }) %>
                            </div>
                        </div>
                    </div>

                    <!-- Plantillas Editables -->
                    <div class="space-y-4">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                            <strong class="text-sm font-bold text-slate-900 block">
                                Plantillas de Correo Electrónico Editables
                            </strong>
                            <div class="relative w-full sm:w-72">
                                <input 
                                    type="text" 
                                    id="buscarPlantillasCorreo" 
                                    oninput="filtrarPlantillasCorreo()" 
                                    placeholder="Buscar plantilla por título o asunto..." 
                                    class="w-full rounded-md border border-slate-300 pl-8 pr-7 py-1.5 text-xs text-slate-900 placeholder-slate-400 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                                >
                                
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <% if (typeof plantillasCorreo !== 'undefined' && plantillasCorreo) { %>
                                <% plantillasCorreo.forEach(p => { %>
                                    <div 
                                        class="tarjeta-plantilla-correo bg-white border border-slate-200 rounded-md p-4 border-l-4 border-l-brand-600 shadow-2xs space-y-3"
                                        data-search="<%= ((p.titulo_seccion || '') + ' ' + (p.destinatario_tipo || '') + ' ' + (p.asunto || '') + ' ' + (p.cuerpo || '')).toLowerCase() %>"
                                    >
                                        <form action="/admin/plantillas-correo/guardar" method="POST" class="space-y-3">
                                            <input type="hidden" name="clave" value="<%= p.clave %>">
                                            
                                            <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-2">
                                                <div>
                                                    <strong class="text-xs font-bold text-brand-700 block">
                                                        <%= p.titulo_seccion %>
                                                    </strong>
                                                    <span class="text-[10px] text-slate-400">
                                                        Destinatario: <strong><%= p.destinatario_tipo %></strong>
                                                    </span>
                                                </div>
                                                <button 
                                                    type="submit" 
                                                    class="px-2.5 py-1 rounded text-[11px] font-bold text-white bg-brand-600 hover:bg-brand-700 transition-colors shadow-2xs cursor-pointer"
                                                >
                                                    Guardar
                                                </button>
                                            </div>

                                            <div>
                                                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">
                                                    Asunto:
                                                </label>
                                                <input 
                                                    type="text" 
                                                    name="asunto" 
                                                    value="<%= p.asunto %>" 
                                                    required 
                                                    class="w-full rounded border border-slate-300 px-3 py-1.5 text-xs text-slate-900 focus:border-brand-600 focus:outline-none bg-white font-medium"
                                                >
                                            </div>

                                            <div>
                                                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">
                                                    Cuerpo del Mensaje:
                                                </label>
                                                <textarea 
                                                    name="cuerpo" 
                                                    rows="5" 
                                                    required 
                                                    class="w-full rounded border border-slate-300 px-3 py-1.5 text-xs text-slate-900 focus:border-brand-600 focus:outline-none bg-white font-mono leading-relaxed"
                                                ><%= p.cuerpo %></textarea>
                                            </div>
                                        </form>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>

                </div>
            </section>

            <!-- MÓDULO 10: INTEGRACIÓN CON DISCORD TI (GRUPO CDM) -->
            <section id="modulo-discord" class="modulo-admin space-y-4" style="display: none;">
                <div class="bg-white rounded-md shadow-xs border border-slate-200 p-6 border-t-4 border-t-indigo-600 space-y-6">
                    <div class="border-b border-slate-100 pb-3 flex flex-wrap items-center justify-between gap-2">
                        <div>
                            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                                <svg class="w-5 h-5 text-indigo-600" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                                <span>Integración y Chat en Tiempo Real con Discord</span>
                            </h3>
                            <p class="text-xs text-slate-500 mt-0.5">Atención directa a usuarios desde el servidor corporativo de Discord sin salir de la plataforma de tickets.</p>
                        </div>
                        <a href="https://discord.com/channels/1367915238258774016/1563252393389465600" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-bold bg-indigo-600 text-white hover:bg-indigo-700 transition shadow-2xs">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                            <span>Abrir Canal #tickets-soporte</span>
                        </a>
                    </div>

                    <!-- Estado del Sistema -->
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="p-4 rounded-md border border-emerald-200 bg-emerald-50/50">
                            <span class="text-[11px] font-bold text-emerald-800 uppercase tracking-wider block">Estado del Bot</span>
                            <div class="mt-1 flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span class="text-sm font-black text-slate-800"><%= (typeof discordInfo !== 'undefined' && discordInfo.nombreBot) ? discordInfo.nombreBot : 'SISTEMA TICKETS#9698' %></span>
                            </div>
                            <span class="text-[10px] text-emerald-700 font-semibold block mt-1">Conectado y Escuchando</span>
                        </div>

                        <div class="p-4 rounded-md border border-slate-200 bg-slate-50">
                            <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block">Servidor Vinculado</span>
                            <span class="text-sm font-black text-slate-800 block mt-1"><%= (typeof discordInfo !== 'undefined' && discordInfo.servidor) ? discordInfo.servidor : 'Grupo CDM' %></span>
                            <span class="text-[10px] text-slate-500 block mt-1">ID: 1367915238258774016</span>
                        </div>

                        <div class="p-4 rounded-md border border-indigo-200 bg-indigo-50/50">
                            <span class="text-[11px] font-bold text-indigo-800 uppercase tracking-wider block">Canal Oficial de Tickets</span>
                            <span class="text-sm font-black text-indigo-900 block mt-1">#tickets-soporte</span>
                            <span class="text-[10px] text-indigo-700 block mt-1">ID: 1563252393389465600</span>
                        </div>

                        <div class="p-4 rounded-md border border-sky-200 bg-sky-50/50">
                            <span class="text-[11px] font-bold text-sky-800 uppercase tracking-wider block">Modo de Operación</span>
                            <span class="text-sm font-black text-sky-900 block mt-1">Opción A (Hilos Dedicados)</span>
                            <span class="text-[10px] text-sky-700 block mt-1">Sincronización WebSockets 100%</span>
                        </div>
                    </div>

                    <!-- Flujo de Trabajo y Características -->
                    <div class="border border-slate-200 rounded-md p-4 bg-slate-50/50 space-y-3">
                        <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider">¿Cómo funciona la integración automática?</h4>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs text-slate-600">
                            <div class="bg-white p-3 rounded border border-slate-200 shadow-2xs">
                                <span class="font-bold text-slate-900 block mb-1">1. Creación de Ticket</span>
                                <p>Cada ticket nuevo genera automáticamente un Hilo en Discord (<code>#ticket-[ID]-[título]</code>), publica la tarjeta técnica y menciona al usuario para que reciba una alerta en su celular y PC.</p>
                            </div>
                            <div class="bg-white p-3 rounded border border-slate-200 shadow-2xs">
                                <span class="font-bold text-slate-900 block mb-1">2. Chat Bidireccional</span>
                                <p>Cualquier mensaje que envíes desde el portal web le llega al usuario a su Discord. Las respuestas que el usuario dé en Discord entran al instante a tu pantalla web en tiempo real.</p>
                            </div>
                            <div class="bg-white p-3 rounded border border-slate-200 shadow-2xs">
                                <span class="font-bold text-slate-900 block mb-1">3. Cierre y Estatus</span>
                                <p>Al actualizar el estatus o resolver el ticket, el bot notifica en el hilo la solución aplicada y archiva la conversación para mantener el canal organizado.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- MÓDULO 8: GUÍAS RÁPIDAS Y SOLUCIONES FRECUENTES (FAQ / BASE DE CONOCIMIENTO) -->
            <section id="modulo-guias" class="modulo-admin space-y-4" style="display: none;">
                <div class="bg-white rounded-md shadow-xs border border-slate-200 p-6 border-t-4 border-t-brand-600 space-y-6">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
                        <div>
                            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                                
                                <span>Guías Rápidas y Soluciones Frecuentes (FAQ / Base de Conocimiento)</span>
                            </h3>
                            <p class="text-xs text-slate-500 mt-0.5">
                                Crea y administra manuales paso a paso para que los usuarios resuelvan dudas frecuentes o para uso interno de Sistemas.
                            </p>
                        </div>
                        <button 
                            type="button" 
                            onclick="toggleFormularioCrearGuia()"
                            class="inline-flex items-center gap-1.5 py-2 px-4 rounded-md shadow-xs text-xs font-extrabold text-white bg-brand-600 hover:bg-brand-700 transition-all cursor-pointer self-start sm:self-auto"
                        >
                            <span>Crear Nueva Guía Rápida</span>
                        </button>
                    </div>

                    <!-- Formulario Desplegable para Crear Nueva Guía -->
                    <div id="bloqueFormularioCrearGuia" style="display: none;" class="bg-slate-50 border border-slate-200 rounded-md p-5 space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-200 pb-2.5">
                            <strong class="text-sm font-bold text-slate-900 flex items-center gap-1.5">
                                
                                <span>Registrar Nueva Guía Paso a Paso</span>
                            </strong>
                            <button type="button" onclick="toggleFormularioCrearGuia()" class="text-xs font-bold text-slate-400 hover:text-slate-700 cursor-pointer">✕ Cerrar</button>
                        </div>

                        <form action="/admin/guias/crear" method="POST" enctype="multipart/form-data" class="space-y-4">
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                        Título de la Guía / Problema <span class="text-brand-600">*</span>
                                    </label>
                                    <input 
                                        type="text" 
                                        name="titulo" 
                                        required 
                                        placeholder="Ej. Cómo configurar la firma corporativa en Outlook o qué hacer si no imprime"
                                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                                    >
                                </div>

                                <div>
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                        Categoría <span class="text-brand-600">*</span>
                                    </label>
                                    <select 
                                        name="categoria" 
                                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                                    >
                                        <option value="Impresoras">Impresoras y Escáner</option>
                                        <option value="Conectividad e Internet">Conectividad, Red y VPN</option>
                                        <option value="Correo Outlook">Correo Outlook / Office 365</option>
                                        <option value="Lentitud en PC">Lentitud en PC / Windows</option>
                                        <option value="Periféricos y Audio">Periféricos, Monitores y Audio</option>
                                        <option value="Accesos y Contraseñas">Accesos, Carpetas y Contraseñas</option>
                                        <% (categorias || []).forEach(cat => { %>
                                            <option value="<%= cat.nombre %>"><%= cat.nombre %></option>
                                        <% }) %>
                                        <option value="General">General</option>
                                    </select>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                        Resumen Corto (Cuándo usar esta guía)
                                    </label>
                                    <input 
                                        type="text" 
                                        name="resumen" 
                                        placeholder="Ej. Aplica cuando la cola de impresión se queda trabada o marca sin conexión."
                                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                                    >
                                </div>

                                <div>
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                        Visibilidad de la Guía
                                    </label>
                                    <select 
                                        name="visible_para" 
                                        class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                                    >
                                        <option value="todos">Todos los Usuarios y Sistemas (Pública)</option>
                                        <option value="admin">Solo Equipo de Sistemas TI (Uso Interno)</option>
                                    </select>
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                    Pasos de Solución Detallados <span class="text-brand-600">*</span>
                                </label>
                                <textarea 
                                    name="pasos" 
                                    rows="5" 
                                    required 
                                    placeholder="1. Verifica que el cable esté conectado...&#10;2. Abre el menú de configuración...&#10;3. Reinicia el servicio o aplicación..."
                                    class="w-full rounded border border-slate-300 px-3 py-2 text-xs text-slate-900 bg-white focus:border-brand-600 focus:outline-none shadow-2xs leading-relaxed"
                                ></textarea>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
                                <div>
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                        Imagen o Diagrama de Apoyo (Opcional)
                                    </label>
                                    <input 
                                        type="file" 
                                        name="imagen" 
                                        accept="image/*"
                                        class="w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-xs file:font-bold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100 cursor-pointer"
                                    >
                                </div>

                                <div class="flex items-center gap-2 pt-3">
                                    <input 
                                        type="checkbox" 
                                        name="destacada" 
                                        id="checkGuiaDestacadaNueva" 
                                        value="1" 
                                        class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 border-slate-300"
                                    >
                                    <label for="checkGuiaDestacadaNueva" class="text-xs font-bold text-slate-700 cursor-pointer">
                                        ⭐ Marcar como Guía Destacada (Aparecerá al inicio)
                                    </label>
                                </div>
                            </div>

                            <div class="flex justify-end gap-2 pt-2">
                                <button 
                                    type="button" 
                                    onclick="toggleFormularioCrearGuia()" 
                                    class="px-4 py-2 rounded text-xs font-bold text-slate-600 bg-slate-200 hover:bg-slate-300 transition-colors cursor-pointer"
                                >
                                    Cancelar
                                </button>
                                <button 
                                    type="submit" 
                                    class="px-5 py-2 rounded text-xs font-bold text-white bg-brand-600 hover:bg-brand-700 transition-colors shadow-xs cursor-pointer"
                                >
                                    Publicar Guía
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Barra de Búsqueda y Filtros de Guías -->
                    <div class="flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between bg-slate-50 p-3.5 rounded-md border border-slate-200">
                        <div class="flex flex-col sm:flex-row gap-2.5 flex-1">
                            <div class="relative flex-1">
                                <input 
                                    type="text" 
                                    id="buscarGuiasAdmin" 
                                    oninput="filtrarGuiasAdmin()" 
                                    placeholder="Buscar guía por título, palabra clave, falla o pasos..." 
                                    class="w-full rounded-md border border-slate-300 pl-8 pr-7 py-1.5 text-xs text-slate-900 placeholder-slate-400 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                                >
                                
                            </div>

                            <select 
                                id="filtroCategoriaGuiasAdmin" 
                                onchange="filtrarGuiasAdmin()" 
                                class="rounded-md border border-slate-300 px-3 py-1.5 text-xs text-slate-900 bg-white font-medium focus:border-brand-600 focus:outline-none shadow-2xs"
                            >
                                <option value="">Todas las categorías</option>
                                <% 
                                    const catsGuiasUnicas = [];
                                    (typeof guias !== 'undefined' ? guias : []).forEach(g => {
                                        if (g.categoria && !catsGuiasUnicas.includes(g.categoria)) catsGuiasUnicas.push(g.categoria);
                                    });
                                %>
                                <% catsGuiasUnicas.forEach(cg => { %>
                                    <option value="<%= cg.toLowerCase() %>"><%= cg %></option>
                                <% }) %>
                            </select>

                            <select 
                                id="filtroVisibilidadGuiasAdmin" 
                                onchange="filtrarGuiasAdmin()" 
                                class="rounded-md border border-slate-300 px-3 py-1.5 text-xs text-slate-900 bg-white font-medium focus:border-brand-600 focus:outline-none shadow-2xs"
                            >
                                <option value="">Mostrar Visibilidad: Todas</option>
                                <option value="todos">Públicas (Usuarios y TI)</option>
                                <option value="admin">Internas (Solo TI)</option>
                            </select>
                        </div>

                        <div class="flex items-center gap-2">
                            <span id="contadorGuiasAdmin" class="text-[11px] font-bold text-slate-500 bg-white px-2.5 py-1 rounded border border-slate-200">
                                Mostrando <%= (typeof guias !== 'undefined' && guias) ? guias.length : 0 %> guías
                            </span>
                        </div>
                    </div>

                    <!-- Grid de Tarjetas de Guías Rápidas -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="gridGuiasAdmin">
                        <% if (typeof guias === 'undefined' || !guias || guias.length === 0) { %>
                            <div class="col-span-2 py-12 text-center text-slate-400 italic">
                                No hay guías registradas todavía. Haz clic en "Crear Nueva Guía Rápida" para comenzar.
                            </div>
                        <% } else { %>
                            <% guias.forEach(g => { %>
                                <div 
                                    class="tarjeta-guia-admin bg-white rounded-md border <%= g.destacada ? 'border-amber-300 ring-1 ring-amber-100' : 'border-slate-200' %> p-4 shadow-2xs flex flex-col justify-between space-y-3 hover:border-brand-300 transition-all"
                                    data-categoria="<%= (g.categoria || '').toLowerCase() %>"
                                    data-visibilidad="<%= (g.visible_para || 'todos').toLowerCase() %>"
                                    data-search="<%= ((g.titulo || '') + ' ' + (g.categoria || '') + ' ' + (g.resumen || '') + ' ' + (g.pasos || '')).toLowerCase() %>"
                                >
                                    <div class="space-y-2.5">
                                        <div class="flex items-start justify-between gap-2">
                                            <div class="flex flex-wrap items-center gap-1.5">
                                                <span class="px-2 py-0.5 rounded text-[10px] font-extrabold bg-brand-50 text-brand-700 border border-brand-200">
                                                    <%= g.categoria || 'General' %>
                                                </span>
                                                <% if (g.destacada) { %>
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-extrabold bg-amber-50 text-amber-800 border border-amber-200">
                                                        ⭐ Destacada
                                                    </span>
                                                <% } %>
                                                <% if (g.visible_para === 'admin') { %>
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-white">
                                                        Solo Sistemas TI
                                                    </span>
                                                <% } else { %>
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                        Visible a Usuarios
                                                    </span>
                                                <% } %>
                                            </div>

                                            <div class="flex items-center gap-1">
                                                <button 
                                                    type="button" 
                                                    data-id="<%= g.id %>"
                                                    data-titulo="<%= g.titulo %>"
                                                    data-categoria="<%= g.categoria || 'General' %>"
                                                    data-resumen="<%= g.resumen || '' %>"
                                                    data-pasos="<%= g.pasos || '' %>"
                                                    data-destacada="<%= g.destacada ? '1' : '0' %>"
                                                    data-visible="<%= g.visible_para || 'todos' %>"
                                                    onclick="abrirModalEditarGuia(this)"
                                                    class="px-2 py-1 rounded text-[11px] font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors cursor-pointer"
                                                    title="Editar guía"
                                                >
                                                    Editar
                                                </button>
                                                <button 
                                                    type="button" 
                                                    onclick="abrirModalEliminarGuia('<%= g.id %>', '<%= g.titulo.replace(/'/g, "\\'") %>')"
                                                    class="px-2 py-1 rounded text-[11px] font-bold text-brand-700 bg-brand-50 hover:bg-brand-100 transition-colors cursor-pointer"
                                                    title="Eliminar guía"
                                                >
                                                    Eliminar
                                                </button>
                                            </div>
                                        </div>

                                        <h4 class="text-sm font-extrabold text-slate-900 leading-snug">
                                            <%= g.titulo %>
                                        </h4>

                                        <% if (g.resumen) { %>
                                            <p class="text-xs text-slate-600 italic bg-slate-50 px-2.5 py-1.5 rounded border-l-2 border-brand-500">
                                                <%= g.resumen %>
                                            </p>
                                        <% } %>

                                        <div class="bg-slate-50 rounded p-3 border border-slate-200 text-xs text-slate-700 whitespace-pre-line leading-relaxed font-medium"><%= g.pasos %></div>

                                        <% if (g.imagen) { %>
                                            <div class="pt-1">
                                                <a href="/uploads/<%= g.imagen %>" target="_blank" class="inline-flex items-center gap-2 text-xs font-bold text-brand-600 hover:underline">
                                                    <img src="/uploads/<%= g.imagen %>" alt="Guía" class="w-16 h-12 object-cover rounded border border-slate-200">
                                                    <span>Ver imagen ilustrativa completa</span>
                                                </a>
                                            </div>
                                        <% } %>
                                    </div>

                                    <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-400">
                                        <span>Por: <strong><%= g.autor_nombre || 'Sistemas TI' %></strong></span>
                                        <span><%= g.updated_at ? new Date(g.updated_at).toLocaleDateString('es-ES') : '' %></span>
                                    </div>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>
                </div>
            </section>

        </main>
    </div>

