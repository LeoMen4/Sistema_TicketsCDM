                        <button 
                            type="button" 
                            id="btnClearCrearEquipoUsuarioSelect" 
                            onclick="limpiarBuscadorSelectorUsuario('buscarCrearEquipoUsuarioSelect', 'crearEquipoUsuarioSelect', 'badgeCrearEquipoUsuarioSelect', 'btnClearCrearEquipoUsuarioSelect', 'sugerenciasCrearEquipoUsuarioSelect')" 
