        function filtrarTablaEquipos() {
            const userVal = document.getElementById('filtroEquiposUsuario')?.value || '';
            const tipoVal = (document.getElementById('filtroEquiposTipo')?.value || '').toLowerCase();
            const busqVal = (document.getElementById('filtroEquiposBuscar')?.value || '').toLowerCase().trim();

            const btnClear = document.getElementById('btnClearBuscarEquipos');
            if (btnClear) btnClear.style.display = busqVal.length > 0 ? 'block' : 'none';

            const filas = document.querySelectorAll('.fila-equipo');
            let visCount = 0;

            filas.forEach(fila => {
                const filaUser = fila.dataset.usuarioId;
                const filaTipo = fila.dataset.tipo;
                const filaSearch = fila.dataset.search;

                let coincideUser = !userVal || filaUser === userVal;
                let coincideTipo = true;

                if (tipoVal) {
                    if (tipoVal === 'impresora') {
                        coincideTipo = filaTipo.includes('impresora') || filaTipo.includes('escaner');
                    } else if (tipoVal === 'cpu / pc torre') {
                        coincideTipo = filaTipo.includes('cpu') || filaTipo.includes('torre');
                    } else if (tipoVal === 'pc ensamblada') {
                        coincideTipo = filaTipo.includes('ensamblad');
                    } else if (tipoVal === 'diadema / auriculares') {
                        coincideTipo = filaTipo.includes('diadema') || filaTipo.includes('auricular') || filaTipo.includes('audifono');
                    } else if (tipoVal === 'ups / no-break') {
                        coincideTipo = filaTipo.includes('ups') || filaTipo.includes('break') || filaTipo.includes('regulador');
                    } else if (tipoVal === 'otro') {
                        const conocidos = ['mouse', 'teclado', 'monitor', 'cpu', 'torre', 'ensamblad', 'laptop', 'portatil', 'diadema', 'auricular', 'audifono', 'impresora', 'escaner', 'ups', 'break', 'disco', 'memoria'];
                        coincideTipo = !conocidos.some(c => filaTipo.includes(c));
                    } else {
                        coincideTipo = filaTipo.includes(tipoVal);
                    }
                }

                let coincideBusq = !busqVal || filaSearch.includes(busqVal);

                if (coincideUser && coincideTipo && coincideBusq) {
                    fila.style.display = '';
                    visCount++;
                } else {
                    fila.style.display = 'none';
                }
            });

            const contador = document.getElementById('contadorEquiposVisibles');
            if (contador) {
                contador.textContent = `Mostrando ${visCount} de ${filas.length}`;
            }

            const filaSin = document.getElementById('filaSinCoincidenciasEquipos');
            if (filaSin) {
                filaSin.style.display = (filas.length > 0 && visCount === 0) ? '' : 'none';
            }
        }

