<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ticket #<%= ticket.id %> - <%= ticket.titulo %> | Sistema de Tickets</title>
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        // Protección contra el botón atrás del navegador tras cerrar sesión (bfcache)
        window.addEventListener('pageshow', function (event) {
            if (event.persisted || (window.performance && window.performance.navigation && window.performance.navigation.type === 2) || (window.performance && window.performance.getEntriesByType && window.performance.getEntriesByType('navigation')[0]?.type === 'back_forward')) {
                window.location.replace('/');
            }
        });
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#fef2f2',
                            100: '#fee2e2',
                            200: '#fecaca',
                            300: '#fca5a5',
                            400: '#f87171',
                            500: '#ef4444',
                            600: '#dc2626',
                            700: '#b91c1c',
                            800: '#991b1b',
                            900: '#7f1d1d',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(2px);
            overflow-y: auto;
            padding: 20px;
            box-sizing: border-box;
        }
        .modal-content {
            background-color: #ffffff;
            margin: 50px auto;
            padding: 24px;
            border-radius: 8px;
            width: 100%;
            max-width: 460px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            border: 1px solid #cbd5e1;
        }

        /* Timeline vertical */
        .timeline {
            position: relative;
            padding-left: 20px;
        }
        .timeline::before {
            content: "";
            position: absolute;
            left: 6px;
            top: 6px;
            bottom: 6px;
            width: 2px;
            background: #e2e8f0;
        }
        .timeline-item {
            position: relative;
            margin-bottom: 16px;
        }
        .timeline-item:last-child {
            margin-bottom: 0;
        }
        .timeline-dot {
            position: absolute;
            left: -20px;
            top: 5px;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: white;
            border: 3px solid #dc2626;
            box-sizing: border-box;
        }
        .timeline-item.resuelto .timeline-dot {
            border-color: #10b981;
            background: #10b981;
        }

        @media print {
            body { background: white !important; padding: 0 !important; }
            .no-print { display: none !important; }
            .shadow-sm, .shadow-md, .shadow-xl { box-shadow: none !important; }
            .border { border-color: #cbd5e1 !important; }
        }
    </style>
</head>
<body class="min-h-full bg-slate-50 font-sans text-slate-800 antialiased flex flex-col">

    <!-- BARRA SUPERIOR DE ACCIONES CORPORATIVA -->
    <header class="bg-white border-b border-slate-200 border-t-4 border-brand-600 sticky top-0 z-30 shadow-xs no-print">
        <div class="w-full px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
            
            <div class="flex items-center gap-3.5">
                <!-- Logo Corporativo CDM -->
                <a href="<%= (typeof esAdmin !== 'undefined' && esAdmin) ? '/admin' : '/usuario' %>" onclick="volverAlPanelPrincipal(event, this.href)" class="flex items-center pr-3 border-r border-slate-200 cursor-pointer" title="Sistema de Tickets CDM">
                    <img 
                        src="/img/logo-cdm.png" 
                        alt="CDM" 
                        class="h-8 sm:h-9 w-auto object-contain select-none"
                    >
                </a>
                <a 
                    href="<%= (typeof esAdmin !== 'undefined' && esAdmin) ? '/admin' : '/usuario' %>" 
                    id="btnVolverAlPanelDetalle"
                    onclick="volverAlPanelPrincipal(event, this.href)"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors cursor-pointer"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    <span>Volver al Panel</span>
                </a>
                <span class="hidden sm:inline-block text-slate-300">|</span>
                <span class="hidden sm:inline-block text-xs text-slate-500">
                    <%= (typeof esAdmin !== 'undefined' && esAdmin) ? 'Administrador' : 'Usuario' %>: 
                    <strong class="text-slate-800"><%= (typeof usuarioActualNombre !== 'undefined' && usuarioActualNombre) ? usuarioActualNombre : (typeof adminNombre !== 'undefined' ? adminNombre : '') %></strong>
                </span>
            </div>

            <div class="flex items-center gap-2">
                <button 
                    type="button" 
                    onclick="window.print()" 
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-300 transition-colors cursor-pointer"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                    </svg>
                    <span>Imprimir / PDF</span>
                </button>

                <% if (typeof esAdmin !== 'undefined' && esAdmin) { %>
                    <button 
                        type="button" 
                        onclick="abrirModalEliminarTicketDetalle()" 
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-bold text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 transition-colors cursor-pointer"
                        title="Eliminar este ticket permanentemente"
                    >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        <span>Eliminar Ticket</span>
                    </button>
                <% } %>

                <button 
                    type="button" 
                    onclick="window.close()" 
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-bold text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition-colors cursor-pointer"
                >
                    ✕ Cerrar
                </button>
            </div>
        </div>
    </header>

    <!-- CONTENIDO DEL TICKET (PANTALLA COMPLETA) -->
    <main class="w-full px-4 sm:px-6 lg:px-8 py-6 flex-1 space-y-6">

        <% if (mensaje) { %>
            <div id="alertaMensajeDetalle" class="rounded-md bg-emerald-50 border border-emerald-200 p-3.5 text-sm text-emerald-800 flex items-start justify-between gap-3 shadow-xs transition-opacity duration-300">
                <div class="flex items-start gap-2.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 mt-1"></span>
                    <div class="font-medium text-xs sm:text-sm leading-snug"><%= mensaje %></div>
                </div>
                <button type="button" onclick="const a=document.getElementById('alertaMensajeDetalle'); if(a) a.remove();" class="text-emerald-500 hover:text-emerald-800 hover:bg-emerald-100 p-1 rounded transition-colors text-xs font-bold leading-none cursor-pointer flex-shrink-0" title="Cerrar notificación">
                    ✕
                </button>
            </div>
        <% } %>
        <% if (error) { %>
            <div id="alertaErrorDetalle" class="rounded-md bg-rose-50 border border-rose-200 p-3.5 text-sm text-rose-800 flex items-start justify-between gap-3 shadow-xs transition-opacity duration-300">
                <div class="flex items-start gap-2.5">
                    <span class="w-2 h-2 rounded-full bg-rose-500 mt-1"></span>
                    <div class="font-medium text-xs sm:text-sm leading-snug"><%= error %></div>
                </div>
                <button type="button" onclick="const a=document.getElementById('alertaErrorDetalle'); if(a) a.remove();" class="text-rose-500 hover:text-rose-800 hover:bg-rose-100 p-1 rounded transition-colors text-xs font-bold leading-none cursor-pointer flex-shrink-0" title="Cerrar notificación">
                    ✕
                </button>
            </div>
        <% } %>

        <!-- TARJETA CABECERA DEL TICKET -->
        <section class="bg-white rounded-md shadow-xs border border-slate-200 p-6 border-l-6 border-l-brand-600">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-extrabold bg-brand-50 text-brand-700 border border-brand-200 tracking-wider">
                    TICKET #<%= ticket.id %>
                </span>
                <% if (ticket.participantes_ti || ticket.atendido_por || ticket.entregado_por) { %>
                    <div class="flex flex-wrap items-center gap-2 text-xs">
                        <% if (ticket.atendido_por) { %>
                            <span class="px-2.5 py-1 rounded-md bg-amber-50 text-amber-800 border border-amber-200 font-bold">
                                Diagnóstico / Avance TI: <%= ticket.atendido_por %>
                            </span>
                        <% } %>
                        <% if (ticket.entregado_por || ticket.tecnico_resolvio) { %>
                            <span class="px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold">
                                Entrega / Cierre: <%= ticket.entregado_por || ticket.tecnico_resolvio %>
                            </span>
                        <% } %>
                    </div>
                <% } %>
            </div>
            
            <div class="flex items-center gap-3 flex-wrap mb-4">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-snug">
                    <%= ticket.titulo %>
                </h1>
                <% if (ticket.editado) { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-bold bg-amber-50 text-amber-800 border border-amber-300 shadow-2xs" title="Modificado por el usuario solicitante <%= ticket.editado_at ? 'el ' + new Date(ticket.editado_at).toLocaleString('es-ES') : '' %>">
                        
                        <span>Editado por el usuario</span>
                    </span>
                <% } %>
            </div>

            <div class="flex flex-wrap items-center gap-2" id="contenedorBadgeEstatusDetalle">
                <!-- Estatus Actual -->
                <% if (ticket.estatus === 'Nuevo ticket') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200">
                        <span class="w-2 h-2 rounded-full bg-sky-500"></span>
                        <%= ticket.estatus %>
                    </span>
                <% } else if (ticket.estatus === 'En proceso') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                        <%= ticket.estatus %>
                    </span>
                <% } else if (ticket.estatus === 'Pendiente') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                        <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                        <%= ticket.estatus %>
                    </span>
                <% } else if (ticket.estatus === 'Pendiente por cliente') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-orange-100 text-orange-800 border border-orange-300 shadow-2xs">
                        <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
                        <%= ticket.estatus %>
                    </span>
                <% } else if (ticket.estatus === 'Resuelto') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <%= ticket.estatus %>
                    </span>
                <% } %>

                <% if (ticket.discord_thread_id) { %>
                    <a href="https://discord.com/channels/1367915238258774016/<%= ticket.discord_thread_id %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 hover:bg-indigo-100 transition shadow-2xs" title="Abrir hilo de este ticket en Discord">
                        <svg class="w-3.5 h-3.5 text-indigo-600" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                        <span>Chat en Discord</span>
                    </a>
                <% } %>

                <% if (ticket.estatus === 'Pendiente por cliente' && (ticket.fecha_programada_cliente || ticket.motivo_pendiente_cliente)) { %>
                    <div class="w-full bg-amber-50 border border-amber-300 rounded-md p-3 text-xs text-amber-950 mt-2 space-y-1">
                        <div class="font-bold flex items-center gap-1.5 text-amber-900">
                            <span>Detalle de Espera por Disponibilidad del Cliente:</span>
                        </div>
                        <% if (ticket.fecha_programada_cliente) { %>
                            <div><strong>Cita / Contacto acordado:</strong> <%= ticket.fecha_programada_cliente %></div>
                        <% } %>
                        <% if (ticket.motivo_pendiente_cliente) { %>
                            <div><strong>Motivo:</strong> <%= ticket.motivo_pendiente_cliente %></div>
                        <% } %>
                        <div class="text-[10px] text-amber-700 italic">El conteo de tiempo para mediciones y reportes de TI se encuentra pausado.</div>
                    </div>
                <% } %>

                <!-- Prioridad -->
                <% if (ticket.prioridad === 'Alta') { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-brand-50 text-brand-700 border border-brand-200">
                        Prioridad: Alta
                    </span>
                <% } else if (ticket.prioridad === 'Media') { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                        Prioridad: Media
                    </span>
                <% } else { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        Prioridad: Baja
                    </span>
                <% } %>

                <!-- Categoría / Subcategoría -->
                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                    <%= ticket.tipo_falla %>
                    <% if (ticket.subcategoria) { %>
                        <strong class="text-brand-600 ml-1">› <%= ticket.subcategoria %></strong>
                    <% } %>
                </span>

                <!-- Fecha y hora -->
                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs text-slate-500 bg-slate-50 border border-slate-200">
                    <%= new Date(ticket.fecha).toLocaleDateString('es-ES') %> - <%= new Date(ticket.fecha).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) %>
                </span>

                <!-- Creado por admin -->
                <% if (ticket.creado_por_admin) { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-200">
                        Levantado por Admin: <strong><%= ticket.creado_por_admin %></strong>
                    </span>
                <% } %>
            </div>
        </section>

        <!-- GRID DE 2 COLUMNAS -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- COLUMNA IZQUIERDA (2 COLS EN LG) -->
            <div class="lg:col-span-2 space-y-6">

                <!-- DESCRIPCIÓN DETALLADA -->
                <div class="bg-white rounded-md shadow-xs border border-slate-200 p-6 space-y-3">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-3">
                        
                        <span>Descripción Detallada del Problema</span>
                    </h3>
                    <div class="bg-slate-50 border border-slate-200 rounded-md p-4 text-sm text-slate-800 leading-relaxed whitespace-pre-wrap font-sans">
                        <%= ticket.descripcion %>
                    </div>
                </div>

                <!-- EVIDENCIA FOTOGRÁFICA -->
                <div class="bg-white rounded-md shadow-xs border border-slate-200 p-6 space-y-4">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-3">
                        
                        <span>Evidencia Fotográfica / Captura de Pantalla</span>
                    </h3>

                    <% if (ticket.imagen) { %>
                        <div class="bg-slate-50/70 border border-slate-200 rounded-md p-4 flex flex-col items-center justify-center">
                            <a href="/uploads/<%= ticket.imagen %>" target="_blank" title="Haz clic para abrir imagen en tamaño original" class="group block">
                                <img 
                                    src="/uploads/<%= ticket.imagen %>" 
                                    alt="Evidencia Ticket #<%= ticket.id %>" 
                                    class="max-h-[500px] w-auto rounded-md shadow-xs border border-slate-200 group-hover:shadow-md transition-all"
                                >
                            </a>
                            <div class="mt-4 flex items-center gap-3 flex-wrap justify-center no-print">
                                <a 
                                    href="/uploads/<%= ticket.imagen %>" 
                                    target="_blank" 
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-bold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 shadow-xs"
                                >
                                    Abrir en Pestaña Nueva
                                </a>
                                <a 
                                    href="/uploads/<%= ticket.imagen %>" 
                                    download="Evidencia-Ticket-<%= ticket.id %>" 
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 hover:bg-emerald-100 shadow-xs"
                                >
                                    ⬇️ Descargar Imagen
                                </a>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="rounded-md border border-dashed border-slate-300 p-8 text-center text-slate-400 text-xs italic bg-slate-50/50">
                            No se adjuntó archivo de imagen de evidencia para este reporte.
                        </div>
                    <% } %>
                </div>

                <!-- CHAT Y SEGUIMIENTO REMOTO (OPCIÓN 2) -->
                <div class="bg-white rounded-md shadow-xs border border-slate-200 p-6 space-y-4 border-t-4 border-t-brand-600 no-print">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                        <div>
                            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 flex items-center gap-2">
                                
                                <span>Chat y Seguimiento Remoto (Usuario ↔ Sistemas TI)</span>
                            </h3>
                            <p class="text-xs text-slate-500 mt-0.5">
                                Envía mensajes, indicaciones remotas o capturas de pantalla sobre el avance de este ticket.
                            </p>
                        </div>
                    </div>

                    <div id="contenedorChatDetalle" class="bg-slate-50 border border-slate-200 rounded-md p-4 max-h-96 overflow-y-auto space-y-3">
                        <% if (typeof comentarios === 'undefined' || !comentarios || comentarios.length === 0) { %>
                            <div class="text-center py-8 text-xs text-slate-400 italic">
                                No hay mensajes de seguimiento en este ticket todavía.
                            </div>
                        <% } else { %>
                            <% comentarios.forEach(c => { %>
                                <% 
                                    const esAutorAdmin = c.autor_rol === 'admin'; 
                                    const esMioDetalle = (typeof usuarioActual !== 'undefined' && usuarioActual && c.usuario_id === usuarioActual.id);
                                    const fechaCreacionDetalle = new Date(String(c.fecha).replace(' ', 'T')).getTime();
                                    const diffMsDetalle = Date.now() - fechaCreacionDetalle;
                                    const puedeEditarDetalle = esMioDetalle && (diffMsDetalle <= 5 * 60 * 1000);
                                    const puedeEliminarDetalle = esMioDetalle;
                                %>
                                <div class="flex <%= esAutorAdmin ? 'justify-end' : 'justify-start' %>" id="bloqueComentarioDetalle-<%= c.id %>">
                                    <div class="max-w-[85%] rounded-md p-3 shadow-2xs border <%= esAutorAdmin ? 'bg-brand-50/80 border-brand-200 text-slate-900' : 'bg-white border-slate-200 text-slate-800' %>">
                                        <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5 border-b border-slate-200/60 pb-1">
                                            <div class="flex items-center gap-1.5">
                                                <span class="text-xs font-extrabold <%= esAutorAdmin ? 'text-brand-700' : 'text-slate-900' %>">
                                                    <%= esAutorAdmin ? '[TI] ' : '' %><%= c.autor_nombre %>
                                                </span>
                                                <% if (c.autor_puesto) { %>
                                                    <span class="text-[10px] text-slate-500">(<%= c.autor_puesto %>)</span>
                                                <% } %>
                                                <% if (c.tipo_intervencion === 'diagnostico') { %>
                                                    <span class="px-1.5 py-0.2 rounded text-[9px] font-extrabold bg-amber-100 text-amber-800">DIAGNÓSTICO</span>
                                                <% } else if (c.tipo_intervencion === 'avance') { %>
                                                    <span class="px-1.5 py-0.2 rounded text-[9px] font-extrabold bg-sky-100 text-sky-800">AVANCE TI</span>
                                                <% } else if (c.tipo_intervencion === 'entrega') { %>
                                                    <span class="px-1.5 py-0.2 rounded text-[9px] font-extrabold bg-emerald-100 text-emerald-800">ENTREGA</span>
                                                <% } %>
                                            </div>
                                            <div class="flex items-center gap-1.5">
                                                <span class="text-[10px] text-slate-400">
                                                    <%= new Date(c.fecha).toLocaleString('es-ES', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) %>
                                                </span>
                                                <% if (puedeEditarDetalle) { %>
                                                    <button 
                                                        type="button" 
                                                        onclick='iniciarEdicionMensajeDetalle(<%= c.id %>, <%- JSON.stringify(c.mensaje || "") %>)' 
                                                        class="text-[10px] text-slate-400 hover:text-brand-600 px-1 py-0.5 rounded hover:bg-slate-200 transition-colors cursor-pointer"
                                                        title="Editar este mensaje (disponible durante 5 min)"
                                                    >
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                                    </button>
                                                <% } %>
                                                <% if (puedeEliminarDetalle) { %>
                                                    <button 
                                                        type="button" 
                                                        onclick="eliminarMensajeDetalle(<%= c.id %>)" 
                                                        class="text-[10px] text-slate-400 hover:text-red-600 px-1 py-0.5 rounded hover:bg-red-50 transition-colors cursor-pointer"
                                                        title="Eliminar este mensaje"
                                                    >
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                    </button>
                                                <% } %>
                                            </div>
                                        </div>

                                        <div id="cuerpoMensajeDetalle-<%= c.id %>">
                                            <% if (c.mensaje) { %>
                                                <div class="text-xs leading-relaxed whitespace-pre-line"><%= c.mensaje %></div>
                                            <% } %>
                                            <% if (c.editado == 1) { %>
                                                <div class="flex items-center gap-1 text-[10px] text-slate-400 mt-1 italic select-none">
                                                    
                                                    <span>editado</span>
                                                </div>
                                            <% } %>
                                        </div>

                                        <!-- Formulario inline para editar el mensaje -->
                                        <div id="formEdicionMensajeDetalle-<%= c.id %>" style="display: none;" class="mt-2 space-y-2 bg-white p-2 rounded border border-brand-300 shadow-2xs">
                                            <textarea 
                                                id="inputEdicionMensajeDetalle-<%= c.id %>" 
                                                rows="2" 
                                                onkeydown="if(event.key === 'Escape') { cancelarEdicionMensajeDetalle(<%= c.id %>); } else if(event.key === 'Enter' && (event.ctrlKey || event.metaKey)) { guardarEdicionMensajeDetalle(<%= c.id %>); }"
                                                class="w-full text-xs rounded border border-slate-300 p-2 text-slate-800 focus:border-brand-600 focus:outline-none"
                                                placeholder="Escribe el nuevo texto del mensaje..."
                                            ></textarea>
                                            <div class="flex items-center justify-between gap-1.5">
                                                <span class="text-[10px] text-slate-400 hidden sm:inline">Ctrl+Enter para guardar · Esc para cancelar</span>
                                                <div class="flex items-center gap-1.5 ml-auto">
                                                    <button 
                                                        type="button" 
                                                        onclick="cancelarEdicionMensajeDetalle(<%= c.id %>)" 
                                                        class="px-2 py-1 rounded text-[11px] font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 cursor-pointer"
                                                    >
                                                        Cancelar
                                                    </button>
                                                    <button 
                                                        type="button" 
                                                        onclick="guardarEdicionMensajeDetalle(<%= c.id %>)" 
                                                        class="px-2.5 py-1 rounded text-[11px] font-bold text-white bg-brand-600 hover:bg-brand-700 shadow-2xs cursor-pointer"
                                                    >
                                                        Guardar
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <% if (c.imagen) { %>
                                            <div class="mt-2">
                                                <a href="/uploads/<%= c.imagen %>" target="_blank">
                                                    <img src="/uploads/<%= c.imagen %>" alt="Adjunto" class="max-h-44 rounded border border-slate-300 bg-white p-0.5">
                                                </a>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>

                    <form onsubmit="enviarComentarioDetalle(event)" class="space-y-2.5 pt-1">
                        <% if (typeof esAdmin !== 'undefined' && esAdmin) { %>
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <div class="flex items-center gap-2">
                                    <label class="text-xs font-bold text-slate-700">Tipo de nota:</label>
                                    <select id="detalleChatTipo" class="rounded border border-slate-300 px-2.5 py-1 text-xs bg-white font-semibold">
                                        <option value="comentario">Mensaje al Usuario</option>
                                        <option value="diagnostico">Diagnóstico Inicial</option>
                                        <option value="avance">Avance Técnico</option>
                                        <option value="entrega">Nota de Entrega</option>
                                    </select>
                                </div>
                                <label class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 hover:text-brand-800 cursor-pointer">
                                    <span>Adjuntar captura o foto</span>
                                    <input type="file" id="detalleChatImagen" accept="image/*" class="hidden" onchange="manejarSeleccionImagenDetalle(event)">
                                    <span id="detalleNombreArchivo" class="text-[11px] text-slate-500 font-normal"></span>
                                </label>
                            </div>
                        <% } else { %>
                            <div class="flex justify-end">
                                <label class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 hover:text-brand-800 cursor-pointer">
                                    <span>Adjuntar captura o foto</span>
                                    <input type="file" id="detalleChatImagen" accept="image/*" class="hidden" onchange="manejarSeleccionImagenDetalle(event)">
                                    <span id="detalleNombreArchivo" class="text-[11px] text-slate-500 font-normal"></span>
                                </label>
                            </div>
                        <% } %>

                        <!-- Vista previa de imagen adjunta con botón para quitarla antes de enviar -->
                        <div id="detalleChatPreviewContenedor" style="display: none;" class="p-2.5 bg-slate-100 rounded-md border border-slate-200 flex items-center justify-between gap-3">
                            <div class="flex items-center gap-2.5 overflow-hidden">
                                <img id="detalleChatImgPreview" src="" alt="Vista previa" class="w-12 h-12 object-cover rounded border border-slate-300 bg-white shadow-2xs">
                                <div class="text-[11px] min-w-0">
                                    <span id="detalleChatNombreImagenPreview" class="font-bold text-slate-800 block truncate max-w-xs"></span>
                                    <span id="detalleChatSizeImagenPreview" class="text-slate-500 text-[10px]"></span>
                                </div>
                            </div>
                            <button 
                                type="button" 
                                onclick="quitarImagenAdjuntaDetalle()" 
                                class="px-2.5 py-1 text-xs font-bold text-red-600 hover:text-white bg-red-50 hover:bg-red-600 rounded border border-red-200 transition-colors cursor-pointer whitespace-nowrap shadow-2xs"
                                title="Quitar esta imagen antes de enviar"
                            >
                                ✕ Quitar imagen
                            </button>
                        </div>

                        <div class="flex gap-2">
                            <textarea 
                                id="detalleChatMensaje" 
                                rows="2" 
                                placeholder="Escribe un mensaje o seguimiento..."
                                class="flex-1 rounded-md border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none resize-none"
                            ></textarea>
                            <button 
                                type="submit" 
                                id="btnEnviarChatDetalle"
                                class="px-4 py-2 rounded-md text-xs font-extrabold text-white bg-brand-600 hover:bg-brand-700 shadow-xs cursor-pointer self-end flex items-center gap-1.5"
                            >
                                <span>Enviar Mensaje</span>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- RESOLUCIÓN Y CIERRE DEL TICKET (SI YA ESTÁ RESUELTO) -->
                <% if (ticket.estatus === 'Resuelto') { %>
                    <div class="bg-emerald-50/60 rounded-md shadow-xs border border-emerald-200 p-6 border-l-6 border-l-emerald-600 space-y-4">
                        <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-900 flex items-center gap-2 border-b border-emerald-200/80 pb-3">
                            
                            <span>Solución y Cierre del Ticket (Bitácora por Etapas)</span>
                        </h3>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <span class="text-xs font-bold uppercase text-emerald-800 block">Diagnóstico / Avance TI:</span>
                                <span class="text-sm font-bold text-emerald-950"><%= ticket.atendido_por || ticket.tecnico_resolvio || 'No especificado' %></span>
                            </div>
                            <div>
                                <span class="text-xs font-bold uppercase text-emerald-800 block">Entrega / Cierre:</span>
                                <span class="text-sm font-bold text-emerald-950"><%= ticket.entregado_por || ticket.tecnico_resolvio || 'No especificado' %></span>
                            </div>
                            <div>
                                <span class="text-xs font-bold uppercase text-emerald-800 block">Tipo de Resolución:</span>
                                <span class="text-sm font-bold text-emerald-950"><%= ticket.categoria_resolucion || 'Mantenimiento' %></span>
                            </div>
                        </div>

                        <% if (ticket.participantes_ti) { %>
                            <div class="text-xs text-emerald-900 bg-white/80 px-3 py-2 rounded border border-emerald-200">
                                <strong>Especialistas TI que intervinieron en el ticket:</strong> <%= ticket.participantes_ti %>
                            </div>
                        <% } %>

                        <% if (ticket.comentario_resolucion) { %>
                            <div class="space-y-1">
                                <span class="text-xs font-bold uppercase text-emerald-800 block">Comentarios de Cierre:</span>
                                <div class="bg-white border border-emerald-200 rounded-md p-3.5 text-xs text-emerald-900 leading-relaxed shadow-xs">
                                    <%= ticket.comentario_resolucion %>
                                </div>
                            </div>
                        <% } %>

                        <% if (ticket.categoria_resolucion === 'Reemplazo') { %>
                            <div class="bg-white border border-emerald-200 rounded-md p-4 space-y-3">
                                <strong class="text-xs font-bold uppercase text-emerald-900 block">Datos del Equipo Nuevo Asignado:</strong>
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                                    <div>
                                        <span class="text-slate-500 font-medium block">Tipo de Equipo:</span>
                                        <span class="font-bold text-slate-800"><%= ticket.tipo_equipo_nuevo || 'N/A' %></span>
                                    </div>
                                    <div>
                                        <span class="text-slate-500 font-medium block">Modelo:</span>
                                        <span class="font-bold text-slate-800"><%= ticket.modelo_nuevo || 'N/A' %></span>
                                    </div>
                                    <div>
                                        <span class="text-slate-500 font-medium block">Número de Serie:</span>
                                        <span class="font-bold text-slate-800"><%= ticket.numero_serie_nuevo || 'N/A' %></span>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>

                <!-- FORMULARIO DIRECTO PARA ACTUALIZAR ESTATUS (SOLO ADMINISTRADOR) -->
                <% if (typeof esAdmin !== 'undefined' && esAdmin) { %>
                    <div class="bg-white rounded-md shadow-xs border border-slate-200 p-6 space-y-4 no-print" id="seccionCambiarEstatus">
                        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-3">
                            
                            <span>Actualizar Estatus y Participación TI</span>
                        </h3>

                        <form action="/admin/tickets/cambiar-estatus" method="POST" id="formCambiarEstatusDetalle" class="space-y-4">
                            <input type="hidden" name="ticket_id" value="<%= ticket.id %>">
                            <input type="hidden" name="origen" value="detalle">

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                        Seleccionar Nuevo Estatus:
                                    </label>
                                    <select 
                                        name="estatus" 
                                        id="selectEstatusDetalle" 
                                        onchange="evaluarEstatusDetalle()" 
                                        required
                                        class="w-full rounded-md border border-slate-300 px-3 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500/20 bg-white shadow-xs font-bold"
                                    >
                                        <option value="Nuevo ticket" <%= ticket.estatus === 'Nuevo ticket' ? 'selected' : '' %>>Nuevo ticket</option>
                                        <option value="En proceso" <%= ticket.estatus === 'En proceso' ? 'selected' : '' %>>En proceso</option>
                                        <option value="Pendiente" <%= ticket.estatus === 'Pendiente' ? 'selected' : '' %>>Pendiente TI</option>
                                        <option value="Pendiente por cliente" <%= ticket.estatus === 'Pendiente por cliente' ? 'selected' : '' %>>Pendiente por cliente</option>
                                        <option value="Resuelto" <%= ticket.estatus === 'Resuelto' ? 'selected' : '' %>>Resuelto</option>
                                    </select>
                                </div>

                                <div>
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                        Especialista(s) en Diagnóstico / Avance:
                                    </label>
                                    <input 
                                        type="text" 
                                        name="atendido_por" 
                                        value="<%= ticket.atendido_por || (typeof adminNombre !== 'undefined' ? adminNombre : '') %>" 
                                        placeholder="Ej. Nombre(s) de quienes revisaron"
                                        class="w-full rounded-md border border-slate-300 px-3 py-2 text-xs text-slate-900 bg-white shadow-xs"
                                    >
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                                    Nota / Detalle de esta etapa (Para la bitácora):
                                </label>
                                <input 
                                    type="text" 
                                    name="detalle_etapa" 
                                    placeholder="Ej. Se adelantó revisión de hardware; listo para pruebas o entrega..."
                                    class="w-full rounded-md border border-slate-300 px-3 py-2 text-xs text-slate-900 bg-white shadow-xs"
                                >
                            </div>

                            <!-- Campos Condicionales si se selecciona "Pendiente por cliente" -->
                            <div id="bloquePendienteClienteDetalle" style="display: none;" class="p-4 bg-amber-50/80 border border-amber-300 rounded-md space-y-3">
                                <div class="flex items-center gap-2">
                                    
                                    <div>
                                        <h4 class="text-xs font-bold text-amber-950 uppercase tracking-wider m-0">
                                            Pausar Conteo de Tiempos: Pendiente por Cliente
                                        </h4>
                                        <p class="text-[11px] text-amber-800 m-0">El tiempo transcurrido en este estatus no afectará las métricas ni los reportes de TI.</p>
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-[11px] font-bold text-amber-900 mb-1">Fecha y hora programada de visita / contacto (Opcional):</label>
                                    <input 
                                        type="datetime-local" 
                                        name="fecha_programada_cliente" 
                                        id="inputFechaProgramadaDetalle" 
                                        value="<%= ticket.fecha_programada_cliente || '' %>"
                                        class="w-full rounded-md border border-slate-300 px-3 py-1.5 text-xs text-slate-900 bg-white shadow-xs font-bold"
                                    >
                                    <span class="text-[10px] text-slate-500 block mt-1">
                                        Si programas una cita, aparecerá un recordatorio destacado ese día en la barra superior del panel.
                                    </span>
                                </div>

                                <div>
                                    <label class="block text-[11px] font-bold text-amber-900 mb-1">Motivo o breve descripción (Opcional):</label>
                                    <input 
                                        type="text" 
                                        name="motivo_pendiente_cliente" 
                                        id="inputMotivoClienteDetalle" 
                                        value="<%= ticket.motivo_pendiente_cliente || '' %>"
                                        placeholder="Ej. El usuario estará disponible el día 2 de octubre a las 3:00 PM"
                                        class="w-full rounded-md border border-slate-300 px-3 py-1.5 text-xs text-slate-900 bg-white shadow-xs"
                                    >
                                </div>
                            </div>

                            <!-- Campos Condicionales de Resolución si se selecciona "Resuelto" -->
                            <div id="bloqueResolucionDetalle" style="display: none;" class="p-4 bg-emerald-50/70 border border-emerald-200 rounded-md space-y-3">
                                <h4 class="text-xs font-bold text-emerald-900 uppercase tracking-wider">
                                    Datos de Entrega y Cierre Final:
                                </h4>

                                <div>
                                    <label class="block text-[11px] font-bold text-emerald-800 mb-1">Especialista que Entrega / Cierra el Ticket <span class="text-brand-600">*</span>:</label>
                                    <input 
                                        type="text" 
                                        name="tecnico_resolvio" 
                                        id="inputTecnicoDetalle" 
                                        value="<%= ticket.entregado_por || ticket.tecnico_resolvio || (typeof adminNombre !== 'undefined' && adminNombre ? adminNombre : '') %>" 
                                        placeholder="Nombre de quien entrega o cierra"
                                        class="w-full rounded-md border border-slate-300 px-3 py-1.5 text-xs text-slate-900 bg-white shadow-xs"
                                    >
                                </div>

                                <div>
                                    <label class="block text-[11px] font-bold text-emerald-800 mb-1">Categoría de Resolución:</label>
                                    <select 
                                        name="categoria_resolucion" 
                                        id="selectCatResolucionDetalle" 
                                        onchange="evaluarReemplazoDetalle()"
                                        class="w-full rounded-md border border-slate-300 px-3 py-1.5 text-xs text-slate-900 bg-white shadow-xs"
                                    >
                                        <option value="Mantenimiento" <%= ticket.categoria_resolucion === 'Mantenimiento' ? 'selected' : '' %>>Mantenimiento</option>
                                        <option value="Cambio de pieza" <%= ticket.categoria_resolucion === 'Cambio de pieza' ? 'selected' : '' %>>Cambio de pieza</option>
                                        <option value="Reemplazo" <%= ticket.categoria_resolucion === 'Reemplazo' ? 'selected' : '' %>>Reemplazo de Equipo</option>
                                    </select>
                                </div>

                                <div>
                                    <label class="block text-[11px] font-bold text-emerald-800 mb-1">Comentario de la solución:</label>
                                    <textarea 
                                        name="comentario_resolucion" 
                                        id="inputComentarioDetalle" 
                                        rows="3" 
                                        placeholder="Describe qué procedimiento o solución se realizó..."
                                        class="w-full rounded-md border border-slate-300 px-3 py-1.5 text-xs text-slate-900 bg-white shadow-xs"
                                    ><%= ticket.comentario_resolucion || '' %></textarea>
                                </div>

                                <!-- Bloque Reemplazo -->
                                <div id="bloqueReemplazoDetalle" style="display: none;" class="bg-white border border-emerald-200 rounded-md p-3 space-y-2 shadow-xs">
                                    <strong class="text-xs font-bold text-emerald-900 block">Datos del Nuevo Equipo:</strong>
                                    <div>
                                        <label class="block text-[10px] text-slate-500">Tipo de Equipo Nuevo:</label>
                                        <input type="text" name="tipo_equipo_nuevo" value="<%= ticket.tipo_equipo_nuevo || '' %>" placeholder="Ej. Laptop / Monitor / Impresora" class="w-full rounded-md border border-slate-300 px-2.5 py-1 text-xs">
                                    </div>
                                    <div>
                                        <label class="block text-[10px] text-slate-500">Modelo del Equipo Nuevo:</label>
                                        <input type="text" name="modelo_nuevo" value="<%= ticket.modelo_nuevo || '' %>" placeholder="Ej. ThinkPad L14 / Dell P2419H" class="w-full rounded-md border border-slate-300 px-2.5 py-1 text-xs">
                                    </div>
                                    <div>
                                        <label class="block text-[10px] text-slate-500">Número de Serie Nuevo:</label>
                                        <input type="text" name="numero_serie_nuevo" value="<%= ticket.numero_serie_nuevo || '' %>" placeholder="Ej. PF-12345678" class="w-full rounded-md border border-slate-300 px-2.5 py-1 text-xs">
                                    </div>
                                </div>
                            </div>

                            <button 
                                type="submit" 
                                class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-md text-xs font-bold text-white bg-brand-600 hover:bg-brand-700 shadow-xs transition-all cursor-pointer"
                            >
                                Guardar y Actualizar Estatus
                            </button>
                        </form>
                    </div>
                <% } %>

            </div>

            <!-- COLUMNA DERECHA (1 COL EN LG) -->
            <div class="space-y-6">

                <!-- DATOS DEL USUARIO SOLICITANTE -->
                <div class="bg-white rounded-md shadow-xs border border-slate-200 p-6 space-y-4">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-3">
                        
                        <span>Datos del Solicitante</span>
                    </h3>

                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-md bg-brand-600 text-white font-extrabold flex items-center justify-center text-lg shadow-xs">
                            <%= (ticket.usuario_nombre || 'U').charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <div class="font-bold text-slate-900 text-sm">
                                <%= ticket.usuario_nombre %>
                            </div>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200 mt-0.5">
                                <%= ticket.usuario_rol === 'admin' ? 'Administrador TI' : 'Usuario Estándar' %>
                            </span>
                        </div>
                    </div>

                    <div class="text-xs space-y-2 pt-2 border-t border-slate-100">
                        <div>
                            <strong class="text-slate-500 block">Puesto / Cargo:</strong>
                            <span class="font-semibold text-slate-800"><%= ticket.usuario_puesto || 'Sin especificar' %></span>
                        </div>
                        <div>
                            <strong class="text-slate-500 block">Correo Electrónico:</strong>
                            <a href="mailto:<%= ticket.usuario_email %>" class="text-brand-600 hover:text-brand-800 font-semibold break-all">
                                <%= ticket.usuario_email %>
                            </a>
                        </div>
                        <div>
                            <strong class="text-slate-500 block">🆔 ID de Usuario:</strong>
                            <span class="font-semibold text-slate-800">#<%= ticket.usuario_id %></span>
                        </div>
                    </div>
                </div>

                <!-- BITÁCORA DE INTERVENCIÓN MULTI-ESPECIALISTA -->
                <div class="bg-white rounded-md shadow-xs border border-slate-200 p-6 space-y-3">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-3">
                        
                        <span>Especialistas de Sistemas TI</span>
                    </h3>
                    <div class="text-xs space-y-2">
                        <div>
                            <span class="text-slate-500 font-semibold block">Diagnóstico / Avance Técnico:</span>
                            <span class="font-bold text-slate-800"><%= ticket.atendido_por || 'En espera / Sin registro' %></span>
                        </div>
                        <div>
                            <span class="text-slate-500 font-semibold block">Entrega / Cierre Final:</span>
                            <span class="font-bold text-emerald-700"><%= ticket.entregado_por || ticket.tecnico_resolvio || 'Pendiente de cierre' %></span>
                        </div>
                        <% if (ticket.participantes_ti) { %>
                            <div>
                                <span class="text-slate-500 font-semibold block">Participantes TI:</span>
                                <span class="font-semibold text-slate-700"><%= ticket.participantes_ti %></span>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- HISTORIAL Y TRAZABILIDAD (TIMELINE POR ETAPAS) -->
                <div class="bg-white rounded-md shadow-xs border border-slate-200 p-6 space-y-4">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-3">
                        <span>⏱️</span>
                        <span>Historial y Trazabilidad por Etapas</span>
                    </h3>

                    <% if (!historial || historial.length === 0) { %>
                        <p class="text-xs text-slate-400 italic">No hay movimientos registrados en el historial de este ticket.</p>
                    <% } else { %>
                        <div class="timeline">
                            <% historial.forEach((h, index) => { %>
                                <div class="timeline-item <%= h.estatus === 'Resuelto' ? 'resuelto' : '' %>">
                                    <div class="timeline-dot"></div>
                                    <div class="bg-slate-50 border border-slate-200 rounded-md p-3 shadow-2xs space-y-1">
                                        <div class="flex items-center justify-between">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-white text-slate-800 border border-slate-200">
                                                <%= h.estatus %>
                                            </span>
                                            <span class="text-[10px] text-slate-400 font-bold">
                                                #<%= index + 1 %>
                                            </span>
                                        </div>
                                        <% if (h.usuario_nombre) { %>
                                            <div class="text-[11px] font-bold text-slate-700">
                                                <%= h.usuario_nombre %>
                                                <% if (h.usuario_puesto) { %>
                                                    <span class="text-[10px] font-normal text-slate-500">(<%= h.usuario_puesto %>)</span>
                                                <% } %>
                                            </div>
                                        <% } %>
                                        <% if (h.detalle) { %>
                                            <div class="text-[11px] text-slate-600 italic bg-white px-2 py-1 rounded border border-slate-200">
                                                <%= h.detalle %>
                                            </div>
                                        <% } %>
                                        <div class="text-[10px] text-slate-500">
                                             <%= new Date(h.fecha).toLocaleDateString('es-ES') %> - <%= new Date(h.fecha).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <!-- ACCIÓN RÁPIDA DE IMPRESIÓN -->
                <div class="bg-slate-100/70 border border-slate-200 rounded-md p-5 text-center space-y-2 no-print">
                    <p class="text-xs text-slate-600">¿Necesitas una copia física o comprobante impreso de este ticket?</p>
                    <button 
                        type="button" 
                        onclick="window.print()" 
                        class="w-full inline-flex items-center justify-center gap-1.5 py-2 px-4 rounded-md text-xs font-bold text-slate-700 bg-white hover:bg-slate-50 border border-slate-300 shadow-xs transition-colors cursor-pointer"
                    >
                        Imprimir Ticket / Exportar PDF
                    </button>
                </div>

            </div>

        </div>

    </main>

    <!-- MODAL DE CONFIRMACIÓN PARA ELIMINAR TICKET (SOLO ADMIN) -->
    <% if (typeof esAdmin !== 'undefined' && esAdmin) { %>
    <div id="modalEliminarTicketDetalle" class="modal">
        <div class="modal-content">
            <div class="flex items-center gap-2 mb-2 text-brand-600">
                
                <h4 class="text-base font-bold text-slate-900 m-0">Confirmar Envío a Papelera - Ticket #<%= ticket.id %></h4>
            </div>
            <p class="text-xs text-slate-600 mb-1">¿Deseas enviar este ticket a la papelera de reciclaje?</p>
            <p class="text-xs text-slate-800 font-semibold mb-2">Falla: <span class="font-normal text-slate-600"><%= ticket.titulo %></span></p>

            <div class="rounded-md bg-amber-50 border border-amber-200 p-2.5 text-xs text-amber-800 mb-3">
                ℹ️ <strong>Papelera:</strong> El ticket se retirará de la lista activa y se conservará en la papelera de reciclaje. Podrás <strong>restaurarlo en cualquier momento</strong> con todo su historial, notas y comentarios intactos.
            </div>

            <form action="/admin/tickets/eliminar" method="POST" class="space-y-3">
                <input type="hidden" name="ticket_id" value="<%= ticket.id %>">
                <input type="hidden" name="origen" value="detalle">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                        Ingresa TU contraseña de Administrador:
                    </label>
                    <div class="relative">
                        <input 
                            type="password" 
                            id="adminPassDetalle"
                            name="admin_password" 
                            required 
                            placeholder="Tu contraseña de administrador"
                            autocomplete="current-password"
                            class="w-full rounded-md border border-slate-300 pl-3 pr-10 py-2 text-xs text-slate-900 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
                        >
                        <button 
                            type="button" 
                            onclick="toggleVerPassword('adminPassDetalle', this)" 
                            title="Mostrar / Ocultar contraseña"
                            class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600 focus:outline-none text-sm cursor-pointer"
                        >
                            Mostrar
                        </button>
                    </div>
                </div>
                <div class="modal-actions">
                    <button type="button" onclick="cerrarModalEliminarTicketDetalle()" class="px-3.5 py-1.5 rounded-md text-xs font-bold text-slate-600 bg-slate-100 hover:bg-slate-200">Cancelar</button>
                    <button type="submit" class="px-3.5 py-1.5 rounded-md text-xs font-bold text-white bg-brand-600 hover:bg-brand-700 shadow-xs">Confirmar y Mover a Papelera</button>
                </div>
            </form>
        </div>
    </div>
    <% } %>

    <script>
        function toggleVerPassword(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const isPass = input.type === 'password';
            input.type = isPass ? 'text' : 'password';
            if (btn) {
                btn.textContent = isPass ? 'Ocultar' : 'Mostrar';
                btn.title = isPass ? 'Ocultar contraseña' : 'Ver contraseña';
            }
        }
        function abrirModalEliminarTicketDetalle() {
            const modal = document.getElementById('modalEliminarTicketDetalle');
            if (modal) modal.style.display = 'block';
        }

        function cerrarModalEliminarTicketDetalle() {
            const modal = document.getElementById('modalEliminarTicketDetalle');
            if (modal) modal.style.display = 'none';
        }

        function volverAlPanelPrincipal(e, fallbackUrl) {
            if (e) e.preventDefault();
            if (window.opener && !window.opener.closed) {
                try {
                    window.opener.focus();
                } catch(err) {}
                window.close();
            } else {
                window.close();
            }
            setTimeout(function() {
                if (!window.closed) {
                    window.location.href = fallbackUrl;
                }
            }, 250);
        }

        function evaluarEstatusDetalle() {
            const select = document.getElementById('selectEstatusDetalle');
            if (!select) return;
            const bloqueRes = document.getElementById('bloqueResolucionDetalle');
            const bloqueCli = document.getElementById('bloquePendienteClienteDetalle');
            const inputTecnico = document.getElementById('inputTecnicoDetalle');

            if (select.value === 'Resuelto') {
                if (bloqueRes) bloqueRes.style.display = 'block';
                if (bloqueCli) bloqueCli.style.display = 'none';
                if (inputTecnico) inputTecnico.required = true;
                evaluarReemplazoDetalle();
            } else if (select.value === 'Pendiente por cliente') {
                if (bloqueRes) bloqueRes.style.display = 'none';
                if (bloqueCli) bloqueCli.style.display = 'block';
                if (inputTecnico) inputTecnico.required = false;
            } else {
                if (bloqueRes) bloqueRes.style.display = 'none';
                if (bloqueCli) bloqueCli.style.display = 'none';
                if (inputTecnico) inputTecnico.required = false;
            }
        }

        function evaluarReemplazoDetalle() {
            const selectCat = document.getElementById('selectCatResolucionDetalle');
            if (!selectCat) return;
            const bloqueReemp = document.getElementById('bloqueReemplazoDetalle');
            if (selectCat.value === 'Reemplazo') {
                if (bloqueReemp) bloqueReemp.style.display = 'block';
            } else {
                if (bloqueReemp) bloqueReemp.style.display = 'none';
            }
        }

        function manejarSeleccionImagenDetalle(e) {
            const input = document.getElementById('detalleChatImagen');
            const previewCont = document.getElementById('detalleChatPreviewContenedor');
            const imgPreview = document.getElementById('detalleChatImgPreview');
            const nombreSpan = document.getElementById('detalleChatNombreImagenPreview');
            const sizeSpan = document.getElementById('detalleChatSizeImagenPreview');
            const label = document.getElementById('detalleNombreArchivo');

            if (input && input.files && input.files[0]) {
                const file = input.files[0];
                const sizeKb = (file.size / 1024).toFixed(1);

                if (nombreSpan) nombreSpan.textContent = file.name;
                if (sizeSpan) sizeSpan.textContent = `(${sizeKb} KB)`;
                if (label) label.textContent = file.name;

                const reader = new FileReader();
                reader.onload = function(evt) {
                    if (imgPreview) imgPreview.src = evt.target.result;
                    if (previewCont) previewCont.style.display = 'flex';
                };
                reader.readAsDataURL(file);
            } else {
                quitarImagenAdjuntaDetalle();
            }
        }

        function quitarImagenAdjuntaDetalle() {
            const input = document.getElementById('detalleChatImagen');
            const previewCont = document.getElementById('detalleChatPreviewContenedor');
            const imgPreview = document.getElementById('detalleChatImgPreview');
            const nombreSpan = document.getElementById('detalleChatNombreImagenPreview');
            const sizeSpan = document.getElementById('detalleChatSizeImagenPreview');
            const label = document.getElementById('detalleNombreArchivo');

            if (input) input.value = '';
            if (imgPreview) imgPreview.src = '';
            if (nombreSpan) nombreSpan.textContent = '';
            if (sizeSpan) sizeSpan.textContent = '';
            if (label) label.textContent = '';
            if (previewCont) previewCont.style.display = 'none';
        }

        function iniciarEdicionMensajeDetalle(comentarioId, textoActual) {
            const form = document.getElementById('formEdicionMensajeDetalle-' + comentarioId);
            const input = document.getElementById('inputEdicionMensajeDetalle-' + comentarioId);
            const cuerpo = document.getElementById('cuerpoMensajeDetalle-' + comentarioId);
            if (form && input) {
                input.value = textoActual;
                form.style.display = 'block';
                if (cuerpo) cuerpo.style.display = 'none';
                input.focus();
                const len = input.value.length;
                input.setSelectionRange(len, len);
            }
        }

        function cancelarEdicionMensajeDetalle(comentarioId) {
            const form = document.getElementById('formEdicionMensajeDetalle-' + comentarioId);
            const cuerpo = document.getElementById('cuerpoMensajeDetalle-' + comentarioId);
            if (form) form.style.display = 'none';
            if (cuerpo) cuerpo.style.display = 'block';
        }

        async function guardarEdicionMensajeDetalle(comentarioId) {
            const input = document.getElementById('inputEdicionMensajeDetalle-' + comentarioId);
            if (!input) return;
            const nuevoTexto = (input.value || '').trim();
            if (!nuevoTexto) {
                alert('El mensaje no puede estar vacío.');
                return;
            }

            try {
                const resp = await fetch(`/api/tickets/comentarios/${comentarioId}/editar`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mensaje: nuevoTexto })
                });
                const data = await resp.json();
                if (data.ok) {
                    window.location.reload();
                } else {
                    alert(data.error || 'No se pudo editar el mensaje.');
                }
            } catch (err) {
                console.error(err);
                alert('Error al guardar la edición.');
            }
        }

        async function eliminarMensajeDetalle(comentarioId) {
            if (!confirm('¿Estás seguro de que deseas eliminar este mensaje? Esta acción no se puede deshacer.')) {
                return;
            }

            try {
                const resp = await fetch(`/api/tickets/comentarios/${comentarioId}/eliminar`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await resp.json();
                if (data.ok) {
                    window.location.reload();
                } else {
                    alert(data.error || 'No se pudo eliminar el mensaje.');
                }
            } catch (err) {
                console.error(err);
                alert('Error al eliminar el mensaje.');
            }
        }

        let enviandoComentarioDetalle = false;

        async function enviarComentarioDetalle(e) {
            e.preventDefault();
            if (enviandoComentarioDetalle) return; // Candado estricto contra clics múltiples

            const msgInput = document.getElementById('detalleChatMensaje');
            const imgInput = document.getElementById('detalleChatImagen');
            const tipoSelect = document.getElementById('detalleChatTipo');
            const btn = document.getElementById('btnEnviarChatDetalle');

            const mensaje = (msgInput.value || '').trim();
            const archivo = imgInput && imgInput.files && imgInput.files[0];
            if (!mensaje && !archivo) {
                alert('Escribe un mensaje o adjunta una imagen antes de enviar.');
                return;
            }

            enviandoComentarioDetalle = true;
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span>⏳ Enviando...</span>';
                btn.classList.add('opacity-70', 'cursor-not-allowed');
            }

            const fd = new FormData();
            fd.append('mensaje', mensaje);
            fd.append('tipo_intervencion', tipoSelect ? tipoSelect.value : 'comentario');
            fd.append('formato', 'json');
            if (archivo) fd.append('imagen', archivo);

            try {
                const resp = await fetch('/api/tickets/<%= ticket.id %>/comentarios', {
                    method: 'POST',
                    headers: { 'Accept': 'application/json' },
                    body: fd
                });
                const data = await resp.json();
                if (data.ok) {
                    msgInput.value = '';
                    quitarImagenAdjuntaDetalle();
                    // Con WebSockets el mensaje se agrega en tiempo real sin recargar la página
                } else {
                    alert(data.error || 'Error al enviar el mensaje');
                }
            } catch (err) {
                console.error(err);
                alert('Ocurrió un error al enviar el mensaje.');
            } finally {
                enviandoComentarioDetalle = false;
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<span>Enviar Mensaje</span>';
                    btn.classList.remove('opacity-70', 'cursor-not-allowed');
                }
            }
        }

        // ==========================================
        // COMUNICACIÓN EN TIEMPO REAL CON WEBSOCKETS (SOCKET.IO)
        // ==========================================
        const miUsuarioId = <%= (typeof usuarioActual !== 'undefined' && usuarioActual) ? usuarioActual.id : 0 %>;

        function sonarChimeChat() {
            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) return;
                const ctx = new AudioCtx();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);
                const now = ctx.currentTime;
                osc.type = 'sine';
                osc.frequency.setValueAtTime(659.25, now);
                osc.frequency.exponentialRampToValueAtTime(880, now + 0.1);
                gain.gain.setValueAtTime(0.08, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
                osc.start(now);
                osc.stop(now + 0.3);
            } catch(e) {}
        }

        function agregarComentarioDetalleEnVivo(c) {
            if (!c || document.getElementById('bloqueComentarioDetalle-' + c.id)) return;
            const cont = document.getElementById('contenedorChatDetalle');
            if (!cont) return;

            const placeholder = cont.querySelector('.text-center.py-8');
            if (placeholder) placeholder.remove();

            const esAutorAdmin = c.autor_rol === 'admin';
            const esMio = (miUsuarioId && c.usuario_id === miUsuarioId);

            const wrapper = document.createElement('div');
            wrapper.className = `flex ${esAutorAdmin ? 'justify-end' : 'justify-start'} transition-all duration-300 transform translate-y-1`;
            wrapper.id = 'bloqueComentarioDetalle-' + c.id;

            const fechaObj = new Date(String(c.fecha).replace(' ', 'T'));
            const fechaStr = !isNaN(fechaObj.getTime())
                ? fechaObj.toLocaleString('es-ES', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' })
                : c.fecha;

            let tagIntervencion = '';
            if (c.tipo_intervencion === 'diagnostico') {
                tagIntervencion = '<span class="px-1.5 py-0.2 rounded text-[9px] font-extrabold bg-amber-100 text-amber-800">DIAGNÓSTICO</span>';
            } else if (c.tipo_intervencion === 'avance') {
                tagIntervencion = '<span class="px-1.5 py-0.2 rounded text-[9px] font-extrabold bg-sky-100 text-sky-800">AVANCE TI</span>';
            } else if (c.tipo_intervencion === 'entrega') {
                tagIntervencion = '<span class="px-1.5 py-0.2 rounded text-[9px] font-extrabold bg-emerald-100 text-emerald-800">ENTREGA</span>';
            }

            let imagenHtml = '';
            if (c.imagen) {
                imagenHtml = `
                    <div class="mt-2 pt-2 border-t border-slate-200/50">
                        <a href="/uploads/${c.imagen}" target="_blank" class="block group relative overflow-hidden rounded border border-slate-200">
                            <img src="/uploads/${c.imagen}" alt="Adjunto" class="max-h-48 rounded object-cover group-hover:scale-105 transition-transform" />
                        </a>
                    </div>
                `;
            }

            let botonesAccion = '';
            if (esMio) {
                const jsonMensaje = JSON.stringify(c.mensaje || "").replace(/'/g, "&#39;");
                botonesAccion = `
                    <button type="button" onclick='iniciarEdicionMensajeDetalle(${c.id}, ${jsonMensaje})' class="text-[10px] text-slate-400 hover:text-brand-600 px-1 py-0.5 rounded hover:bg-slate-200 transition-colors cursor-pointer" title="Editar este mensaje">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                    </button>
                    <button type="button" onclick="eliminarMensajeDetalle(${c.id})" class="text-[10px] text-slate-400 hover:text-red-600 px-1 py-0.5 rounded hover:bg-red-50 transition-colors cursor-pointer" title="Eliminar este mensaje">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    </button>
                `;
            }

            wrapper.innerHTML = `
                <div class="max-w-[85%] rounded-md p-3 shadow-2xs border ${esAutorAdmin ? 'bg-brand-50/80 border-brand-200 text-slate-900' : 'bg-white border-slate-200 text-slate-800'}">
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5 border-b border-slate-200/60 pb-1">
                        <div class="flex items-center gap-1.5">
                            <span class="text-xs font-extrabold ${esAutorAdmin ? 'text-brand-700' : 'text-slate-900'}">
                                ${esAutorAdmin ? '[TI] ' : ''}${escaparHtmlSimple(c.autor_nombre)}
                            </span>
                            ${c.autor_puesto ? `<span class="text-[10px] text-slate-500">(${escaparHtmlSimple(c.autor_puesto)})</span>` : ''}
                            ${tagIntervencion}
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="text-[10px] text-slate-400">${fechaStr}</span>
                            ${botonesAccion}
                        </div>
                    </div>
                    <div id="cuerpoMensajeDetalle-${c.id}">
                        ${c.mensaje ? `<div class="text-xs leading-relaxed whitespace-pre-line">${escaparHtmlSimple(c.mensaje)}</div>` : ''}
                        ${c.editado == 1 ? `<div class="flex items-center gap-1 text-[10px] text-slate-400 mt-1 italic select-none"><span>editado</span></div>` : ''}
                    </div>
                    ${imagenHtml}
                </div>
            `;

            cont.appendChild(wrapper);
            cont.scrollTop = cont.scrollHeight;

            if (!esMio) {
                sonarChimeChat();
            }
        }

        // Conectar al servidor de WebSockets en tiempo real
        if (typeof io !== 'undefined') {
            const socketTicket = io();
            socketTicket.emit('unirse_ticket', '<%= ticket.id %>');

            socketTicket.on('comentario:nuevo', function(data) {
                if (data && data.ticketId == '<%= ticket.id %>') {
                    agregarComentarioDetalleEnVivo(data.comentario);
                }
            });

            socketTicket.on('comentario:editado', function(data) {
                if (data && data.ticketId == '<%= ticket.id %>') {
                    const cuerpo = document.getElementById('cuerpoMensajeDetalle-' + data.comentarioId);
                    if (cuerpo) {
                        cuerpo.innerHTML = `
                            <div class="text-xs leading-relaxed whitespace-pre-line">${escaparHtmlSimple(data.mensaje)}</div>
                            <div class="flex items-center gap-1 text-[10px] text-slate-400 mt-1 italic select-none"><span>editado</span></div>
                        `;
                    }
                }
            });

            socketTicket.on('comentario:eliminado', function(data) {
                if (data && data.ticketId == '<%= ticket.id %>') {
                    const bloque = document.getElementById('bloqueComentarioDetalle-' + data.comentarioId);
                    if (bloque) bloque.remove();
                }
            });

            socketTicket.on('ticket:estatus_cambiado', function(data) {
                if (data && Number(data.ticket_id) === Number('<%= ticket.id %>')) {
                    const sel = document.getElementById('selectEstatusDetalle');
                    if (sel) {
                        sel.value = data.estatus;
                        if (typeof evaluarEstatusDetalle === 'function') evaluarEstatusDetalle();
                    }

                    const contBadge = document.getElementById('contenedorBadgeEstatusDetalle');
                    if (contBadge) {
                        let html = '';
                        const est = data.estatus;
                        if (est === 'Nuevo ticket') {
                            html = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200"><span class="w-2 h-2 rounded-full bg-sky-500"></span>Nuevo ticket</span>`;
                        } else if (est === 'En proceso') {
                            html = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200"><span class="w-2 h-2 rounded-full bg-amber-500"></span>En proceso</span>`;
                        } else if (est === 'Pendiente') {
                            html = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200"><span class="w-2 h-2 rounded-full bg-rose-500"></span>Pendiente</span>`;
                        } else if (est === 'Pendiente por cliente') {
                            html = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-orange-100 text-orange-800 border border-orange-300 shadow-2xs">Pendiente por cliente</span>`;
                        } else if (est === 'Resuelto') {
                            html = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200"><span class="w-2 h-2 rounded-full bg-emerald-500"></span>Resuelto</span>`;
                        } else {
                            html = `<span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-slate-100 text-slate-700">${escaparHtmlSimple(est)}</span>`;
                        }
                        contBadge.innerHTML = html;
                    }
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            evaluarEstatusDetalle();
            const cont = document.getElementById('contenedorChatDetalle');
            if (cont) cont.scrollTop = cont.scrollHeight;
        });
    </script>
    <script src="/socket.io/socket.io.js"></script>

</body>
</html>
