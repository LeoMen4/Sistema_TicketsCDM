    <footer class="bg-white border-t border-slate-200 py-4 text-center text-xs text-slate-400">
        &copy; <%= new Date().getFullYear() %> Grupo CDM &bull; Sistema Corporativo de Tickets TI &bull; Mesa de Servicio
    </footer>

    <script>
        const listaCategorias = <%- JSON.stringify(typeof categorias !== 'undefined' ? categorias : []) %>;

        // ==========================================
        // FUNCIONES DE MODIFICACIÓN Y CANCELACIÓN DE TICKETS POR USUARIO
        // ==========================================
        function abrirModalEditarTicketUsuario(ticketIdOrObj) {
            let ticket = null;
            if (typeof ticketIdOrObj === 'object' && ticketIdOrObj !== null) {
                ticket = ticketIdOrObj;
            } else {
                const el = document.getElementById('ticket-data-' + ticketIdOrObj);
                if (el) {
                    try {
                        ticket = JSON.parse(el.textContent);
                    } catch (e) {
                        console.error('Error parseando datos del ticket:', e);
                    }
                }
            }
            if (!ticket) {
                console.error('No se pudieron obtener los datos del ticket para edición:', ticketIdOrObj);
                return;
            }

            if (ticket.estatus !== 'Nuevo ticket') {
                alert('Este ticket ya está en estatus "' + ticket.estatus + '" y se encuentra en proceso de atención. Una vez cambiado el estatus ya no puede ser editado.');
                return;
            }

            document.getElementById('editTicketIdSpan').textContent = ticket.id;
            document.getElementById('editTicketIdInput').value = ticket.id;
            document.getElementById('editTicketTitulo').value = ticket.titulo || '';
            document.getElementById('editTicketDescripcion').value = ticket.descripcion || '';
            document.getElementById('editTicketPrioridad').value = ticket.prioridad || 'Media';

            const catSelect = document.getElementById('editTicketCategoria');
            if (catSelect) {
                catSelect.value = ticket.tipo_falla || '';
            }
            manejarCambioCategoriaModalEdit(ticket.subcategoria);

            const prevBox = document.getElementById('editPreviewImagenActual');
            const imgTag = document.getElementById('editImgTagActual');
            if (ticket.imagen) {
                imgTag.src = '/uploads/' + ticket.imagen;
                prevBox.style.display = 'block';
            } else {
                prevBox.style.display = 'none';
            }

            document.getElementById('modalEditarTicketUsuario').style.display = 'block';
        }

        function cerrarModalEditarTicketUsuario() {
            document.getElementById('modalEditarTicketUsuario').style.display = 'none';
        }

        function manejarCambioCategoriaModalEdit(subcatPrevia = null) {
            const catSelect = document.getElementById('editTicketCategoria');
            const subcatSelect = document.getElementById('editTicketSubcategoria');
            const grupoSubcat = document.getElementById('editGrupoSubcategoria');
            const subcatLabel = document.getElementById('editSubcategoriaLabel');

            if (!catSelect || !subcatSelect || !grupoSubcat) return;

            const catVal = catSelect.value;
            const catObj = (typeof listaCategorias !== 'undefined' ? listaCategorias : []).find(c => c.nombre === catVal);

            if (catObj && catObj.subcategorias && catObj.subcategorias.length > 0) {
                subcatSelect.innerHTML = '<option value="">-- Sin subcategoría adicional --</option>';
                catObj.subcategorias.forEach(s => {
                    const opt = document.createElement('option');
                    opt.value = s.nombre;
                    opt.textContent = s.nombre;
                    if (subcatPrevia && s.nombre === subcatPrevia) {
                        opt.selected = true;
                    }
                    subcatSelect.appendChild(opt);
                });
                if (subcatLabel) subcatLabel.textContent = `Dispositivo / Detalle en ${catObj.nombre}:`;
                grupoSubcat.style.display = 'block';
            } else {
                subcatSelect.innerHTML = '<option value="">Sin subcategorías</option>';
                subcatSelect.value = '';
                grupoSubcat.style.display = 'none';
            }
        }

        function abrirModalEliminarTicketUsuario(ticketIdOrObj, tituloParam) {
            let ticketId = ticketIdOrObj;
            let titulo = tituloParam || '';

            if (typeof ticketIdOrObj === 'object' && ticketIdOrObj !== null) {
                ticketId = ticketIdOrObj.id;
                titulo = ticketIdOrObj.titulo || '';
            } else {
                const el = document.getElementById('ticket-data-' + ticketIdOrObj);
                if (el) {
                    try {
                        const t = JSON.parse(el.textContent);
                        if (t) {
                            ticketId = t.id;
                            if (!titulo) titulo = t.titulo || '';
                        }
                    } catch (e) {}
                }
            }

            document.getElementById('delTicketIdSpan').textContent = ticketId;
            document.getElementById('delTicketIdInput').value = ticketId;
            document.getElementById('delTicketTituloPreview').textContent = '#' + ticketId + (titulo ? ' - ' + titulo : '');
            document.getElementById('modalEliminarTicketUsuario').style.display = 'block';
        }

        function cerrarModalEliminarTicketUsuario() {
            document.getElementById('modalEliminarTicketUsuario').style.display = 'none';
        }

        // Cerrar modales al hacer clic fuera del contenido
        window.addEventListener('click', function(e) {
            const mEdit = document.getElementById('modalEditarTicketUsuario');
            const mDel = document.getElementById('modalEliminarTicketUsuario');
            if (e.target === mEdit) cerrarModalEditarTicketUsuario();
            if (e.target === mDel) cerrarModalEliminarTicketUsuario();
        });

        // Navegación del menú lateral izquierdo del Usuario
        function cambiarModuloUsuario(mod) {
            const modulos = ['tickets', 'guias', 'equipos'];
            modulos.forEach(m => {
                const sec = document.getElementById('modulo-user-' + m);
                const btn = document.getElementById('btn-user-nav-' + m);
                if (sec) sec.style.display = (m === mod) ? 'block' : 'none';
                if (btn) {
                    if (m === mod) btn.classList.add('active');
                    else btn.classList.remove('active');
                }
            });
        }

        // Filtro de Guías Rápidas (FAQ)
        function filtrarGuiasUsuario() {
            const busqVal = (document.getElementById('buscarGuiasUsuario')?.value || '').toLowerCase().trim();
            const catVal = (document.getElementById('filtroGuiasCategoriaUser')?.value || '').toLowerCase().trim();
            const btnClear = document.getElementById('btnClearBuscarGuiasUser');
            if (btnClear) btnClear.style.display = busqVal.length > 0 ? 'block' : 'none';

            const tarjetas = document.querySelectorAll('.tarjeta-guia-usuario');
            let visCount = 0;

            tarjetas.forEach(t => {
                const coincideBusq = !busqVal || (t.dataset.search || '').includes(busqVal);
