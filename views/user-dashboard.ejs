<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Usuario - Sistema de Tickets</title>
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#fef2f2',
                            100: '#fee2e2',
                            200: '#fecaca',
                            300: '#fca5a5',
                            400: '#f87171',
                            500: '#ef4444',
                            600: '#dc2626',
                            700: '#b91c1c',
                            800: '#991b1b',
                            900: '#7f1d1d',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .sidebar-btn {
            transition: all 0.15s ease;
        }
        .sidebar-btn.active {
            background-color: #fef2f2;
            color: #dc2626;
            border-left: 4px solid #dc2626;
            font-weight: 700;
        }
        .modal-user {
            display: none;
            position: fixed;
            z-index: 60;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(15, 23, 42, 0.55);
            backdrop-filter: blur(2px);
            overflow-y: auto;
            padding: 1rem;
        }
    </style>
</head>
<body class="min-h-full bg-slate-50 font-sans text-slate-800 antialiased flex flex-col">

    <% 
        const listaGuias = (typeof guias !== 'undefined' && guias) ? guias : [];
        const totalEquipos = (typeof equipos !== 'undefined' && equipos) ? equipos.length : 0;
        const totalMensajesNoLeidosInicial = (tickets || []).reduce((acc, t) => acc + (t.no_leidos_usuario || 0), 0);
    %>

    <!-- CONTENEDOR DE ALERTAS FLOTANTES EN TIEMPO REAL (TOASTS) -->
    <div id="toastContainerUsuario" class="fixed top-20 right-4 z-50 flex flex-col gap-2.5 max-w-sm w-full pointer-events-none"></div>

    <!-- BARRA DE NAVEGACIÓN SUPERIOR CON LOGO CDM ARRIBA A LA IZQUIERDA -->
    <header class="bg-white border-b border-slate-200 border-t-4 border-brand-600 sticky top-0 z-30 shadow-xs">
        <div class="w-full px-4 sm:px-6 h-15 py-2.5 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
                <img 
                    src="/img/logo-cdm.jpg" 
                    alt="Grupo CDM" 
                    class="h-8 sm:h-9 w-auto object-contain select-none"
                    style="mix-blend-mode: multiply;"
                >
                <div class="h-6 w-px bg-slate-200"></div>
                <div>
                    <h1 class="text-sm sm:text-base font-extrabold text-slate-900 tracking-tight leading-tight">
                        Sistema de Tickets
                    </h1>
                    <span class="text-[11px] font-semibold text-slate-500 block leading-tight">
                        Portal de Solicitud y Soporte de Usuario
                    </span>
                </div>
            </div>

            <div class="flex items-center gap-2.5 sm:gap-3">
                <!-- Botón Sonido de Alertas -->
                <button 
                    type="button" 
                    id="btnToggleSonidoUser" 
                    onclick="toggleSonidoNotificacionesUser()" 
                    class="px-2.5 py-1.5 rounded-md bg-slate-100 hover:bg-slate-200 border border-slate-200 text-xs font-bold text-slate-700 transition-colors cursor-pointer"
                    title="Activar / Silenciar sonido de notificaciones"
                >
                    🔊
                </button>

                <!-- Campana de Mensajes de Sistemas en Tiempo Real -->
                <div class="relative">
                    <button 
                        type="button" 
                        onclick="togglePanelNotificacionesUser()" 
                        class="relative inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-slate-100 hover:bg-slate-200 border border-slate-200 text-xs font-bold text-slate-700 transition-colors cursor-pointer"
                        title="Mensajes de seguimiento de Sistemas TI"
                    >
                        <span>🔔</span>
                        <span class="hidden md:inline">Mensajes TI</span>
                        <span 
                            id="badgeNotificacionesUser" 
                            style="<%= totalMensajesNoLeidosInicial > 0 ? '' : 'display: none;' %>"
                            class="px-1.5 py-0.2 rounded-full text-[10px] font-extrabold bg-brand-600 text-white animate-pulse"
                        >
                            <%= totalMensajesNoLeidosInicial %>
                        </span>
                    </button>

                    <!-- Dropdown de Notificaciones Usuario -->
                    <div 
                        id="dropdownNotificacionesUser" 
                        style="display: none;" 
                        class="absolute right-0 mt-2 w-80 sm:w-96 bg-white rounded-md shadow-lg border border-slate-200 z-50 overflow-hidden"
                    >
                        <div class="px-4 py-2.5 bg-slate-900 text-white flex items-center justify-between">
                            <span class="text-xs font-bold flex items-center gap-1.5">
                                <span>💬</span>
                                <span>Respuestas de Sistemas TI</span>
                            </span>
                            <span class="text-[10px] text-slate-300">En tiempo real</span>
                        </div>
                        <div id="listaNotificacionesUser" class="max-h-72 overflow-y-auto divide-y divide-slate-100 text-xs">
                            <div class="p-4 text-center text-slate-400 italic">No tienes mensajes pendientes por leer.</div>
                        </div>
                    </div>
                </div>

                <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-md bg-slate-100 border border-slate-200 text-xs text-slate-700">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span>Usuario: <strong><%= usuarioNombre %></strong><% if (typeof usuarioPuesto !== 'undefined' && usuarioPuesto) { %> <span class="text-slate-500 font-medium">(<%= usuarioPuesto %>)</span><% } %></span>
                </div>
                <a 
                    href="/logout" 
                    class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-brand-600 px-3 py-1.5 rounded-md hover:bg-slate-100 transition-colors"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    <span class="hidden sm:inline">Cerrar Sesión</span>
                </a>
            </div>
        </div>
    </header>

    <!-- ESTRUCTURA PRINCIPAL CON MENÚ LATERAL IZQUIERDO -->
    <div class="flex-1 flex flex-col lg:flex-row w-full">

        <!-- MENÚ LATERAL IZQUIERDO -->
        <aside class="w-full lg:w-64 xl:w-68 bg-white border-b lg:border-b-0 lg:border-r border-slate-200 flex-shrink-0">
            <div class="p-3 lg:sticky lg:top-16 space-y-4">
                <div>
                    <div class="px-3 py-1.5 text-[10px] font-extrabold uppercase tracking-wider text-slate-400">
                        Menú del Portal
                    </div>
                    <nav class="space-y-1 mt-1">
                        <button 
                            type="button" 
                            id="btn-user-nav-tickets" 
                            onclick="cambiarModuloUsuario('tickets')" 
                            class="sidebar-btn active w-full flex items-center justify-between px-3 py-2.5 rounded-md text-xs text-slate-700 hover:bg-slate-50 cursor-pointer text-left"
                        >
                            <span class="flex items-center gap-2.5">
                                <span>🎫</span>
                                <span>Levantar y Mis Tickets</span>
                            </span>
                            <span class="px-2 py-0.5 text-[10px] rounded bg-slate-100 text-slate-700 font-bold border border-slate-200">
                                <%= tickets.length %>
                            </span>
                        </button>

                        <button 
                            type="button" 
                            id="btn-user-nav-guias" 
                            onclick="cambiarModuloUsuario('guias')" 
                            class="sidebar-btn w-full flex items-center justify-between px-3 py-2.5 rounded-md text-xs text-slate-700 hover:bg-slate-50 cursor-pointer text-left"
                        >
                            <span class="flex items-center gap-2.5">
                                <span>📚</span>
                                <span>Guías y Soluciones (FAQ)</span>
                            </span>
                            <span class="px-2 py-0.5 text-[10px] rounded bg-brand-50 text-brand-700 font-bold border border-brand-200">
                                <%= listaGuias.length %>
                            </span>
                        </button>

                        <button 
                            type="button" 
                            id="btn-user-nav-equipos" 
                            onclick="cambiarModuloUsuario('equipos')" 
                            class="sidebar-btn w-full flex items-center justify-between px-3 py-2.5 rounded-md text-xs text-slate-700 hover:bg-slate-50 cursor-pointer text-left"
                        >
                            <span class="flex items-center gap-2.5">
                                <span>💻</span>
                                <span>Mi Equipo Asignado</span>
                            </span>
                            <span class="px-2 py-0.5 text-[10px] rounded bg-slate-100 text-slate-700 font-bold border border-slate-200">
                                <%= totalEquipos %>
                            </span>
                        </button>
                    </nav>
                </div>

                <!-- Tarjeta de Ayuda Rápida -->
                <div class="rounded-md bg-slate-50 border border-slate-200 p-3 text-xs space-y-2">
                    <div class="font-bold text-slate-800 flex items-center gap-1.5">
                        <span>💡</span>
                        <span>¿Tienes un problema común?</span>
                    </div>
                    <p class="text-[11px] text-slate-500 leading-relaxed">
                        Consulta nuestras <strong>Guías Rápidas</strong> para resolver detalles de impresora, red u Outlook al instante, o usa el botón <strong>💬 Seguimiento</strong> en tu ticket para chatear con Sistemas.
                    </p>
                    <button 
                        type="button" 
                        onclick="cambiarModuloUsuario('guias')" 
                        class="w-full py-1.5 px-2.5 rounded bg-white hover:bg-brand-50 text-brand-600 border border-brand-200 font-bold text-[11px] transition-colors cursor-pointer"
                    >
                        📚 Ver Guías Rápidas (<%= listaGuias.length %>)
                    </button>
                </div>
            </div>
        </aside>

        <!-- CONTENIDO PRINCIPAL -->
        <main class="flex-1 min-w-0 p-4 sm:p-6 space-y-6">

            <!-- Notificaciones de éxito o error con botón de cierre (✕) -->
            <% if (mensaje) { %>
                <div id="alertaMensajeUser" class="rounded-md bg-emerald-50 border border-emerald-200 p-3.5 text-sm text-emerald-800 flex items-start justify-between gap-3 shadow-xs transition-opacity duration-300">
                    <div class="flex items-start gap-2.5">
                        <span class="text-base leading-none text-emerald-600 mt-0.5">✅</span>
                        <div class="font-medium text-xs sm:text-sm leading-snug"><%= mensaje %></div>
                    </div>
                    <button type="button" onclick="const a=document.getElementById('alertaMensajeUser'); if(a) a.remove();" class="text-emerald-500 hover:text-emerald-800 hover:bg-emerald-100 p-1 rounded transition-colors text-xs font-bold leading-none cursor-pointer flex-shrink-0" title="Cerrar notificación">
                        ✕
                    </button>
                </div>
            <% } %>
            <% if (error) { %>
                <div id="alertaErrorUser" class="rounded-md bg-rose-50 border border-rose-200 p-3.5 text-sm text-rose-800 flex items-start justify-between gap-3 shadow-xs transition-opacity duration-300">
                    <div class="flex items-start gap-2.5">
                        <span class="text-base leading-none text-rose-600 mt-0.5">⚠️</span>
                        <div class="font-medium text-xs sm:text-sm leading-snug"><%= error %></div>
                    </div>
                    <button type="button" onclick="const a=document.getElementById('alertaErrorUser'); if(a) a.remove();" class="text-rose-500 hover:text-rose-800 hover:bg-rose-100 p-1 rounded transition-colors text-xs font-bold leading-none cursor-pointer flex-shrink-0" title="Cerrar notificación">
                        ✕
                    </button>
                </div>
            <% } %>

            <!-- ========================================== -->
            <!-- MÓDULO 1: LEVANTAR TICKET Y MIS TICKETS -->
            <!-- ========================================== -->
            <div id="modulo-user-tickets" class="space-y-6">

                <!-- FORMULARIO DE REPORTAR INCIDENCIA -->
                <section class="bg-white rounded-md shadow-xs border border-slate-200 overflow-hidden">
                    <div class="border-b border-slate-200 px-6 py-4 bg-slate-50/70 flex flex-wrap items-center justify-between gap-2">
                        <div class="flex items-center gap-2.5">
                            <span class="w-2.5 h-2.5 rounded-full bg-brand-600"></span>
                            <h2 class="text-base font-bold text-slate-900">
                                Reportar un Problema o Incidencia
                            </h2>
                        </div>
                        <button 
                            type="button" 
                            onclick="cambiarModuloUsuario('guias')" 
                            class="text-xs font-bold text-brand-600 hover:text-brand-800 bg-brand-50 border border-brand-200 px-3 py-1 rounded-md transition-colors cursor-pointer"
                        >
                            📚 ¿Ya revisaste las Guías de Solución Rápida?
                        </button>
                    </div>

                    <div class="p-6">
                        <form action="/tickets/crear" method="POST" enctype="multipart/form-data" autocomplete="off" onsubmit="prevenirDobleEnvio(this)" class="space-y-5">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <!-- Título de la falla -->
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                                        Título breve de la falla <span class="text-brand-600">*</span>
                                    </label>
                                    <input 
                                        type="text" 
                                        name="titulo" 
                                        required 
                                        autocomplete="off" 
                                        autocorrect="off" 
                                        autocapitalize="off" 
                                        spellcheck="false"
                                        placeholder="Ej. Computadora no enciende / No hay conexión a internet / Falla en Outlook"
                                        class="w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500/20 transition-colors shadow-xs"
                                    >
                                </div>

                                <!-- Tipo de Falla / Categoría -->
                                <div>
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                                        Tipo de Falla / Área Afectada <span class="text-brand-600">*</span>
                                    </label>
                                    <select 
                                        name="tipo_falla" 
                                        id="categoriaSelect" 
                                        required 
                                        onchange="manejarCambioCategoria()" 
                                        autocomplete="off"
                                        class="w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500/20 transition-colors shadow-xs bg-white"
                                    >
                                        <option value="" disabled selected>-- Selecciona el tipo de falla / área --</option>
                                        <% if (typeof categorias !== 'undefined' && categorias && categorias.length > 0) { %>
                                            <% categorias.forEach(c => { %>
                                                <option value="<%= c.nombre %>"><%= c.nombre %></option>
                                            <% }) %>
                                        <% } %>
                                    </select>
                                </div>

                                <!-- Prioridad -->
                                <div>
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                                        Nivel de Prioridad <span class="text-brand-600">*</span>
                                    </label>
                                    <select 
                                        name="prioridad" 
                                        required 
                                        autocomplete="off"
                                        class="w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500/20 transition-colors shadow-xs bg-white"
                                    >
                                        <option value="Baja">Baja (No impide realizar tareas críticas)</option>
                                        <option value="Media" selected>Media (Afecta parcialmente las tareas)</option>
                                        <option value="Alta">Alta (Trabajo totalmente detenido)</option>
                                    </select>
                                </div>

                                <!-- Subcategoría condicional -->
                                <div 
                                    id="grupoSubcategoria" 
                                    style="display: none;" 
                                    class="md:col-span-2 rounded-md bg-brand-50/50 border border-brand-200/80 p-4 transition-all"
                                >
                                    <label id="subcategoriaLabel" class="block text-xs font-bold uppercase tracking-wider text-brand-800 mb-1.5">
                                        Especificar Dispositivo / Componente Afectado:
                                    </label>
                                    <select 
                                        name="subcategoria" 
                                        id="subcategoriaSelect" 
                                        autocomplete="off"
                                        class="w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500/20 transition-colors shadow-xs bg-white"
                                    >
                                        <option value="">-- Selecciona una opción (opcional) --</option>
                                    </select>
                                </div>

                                <!-- Descripción detallada -->
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                                        Descripción detallada del problema <span class="text-brand-600">*</span>
                                    </label>
                                    <textarea 
                                        name="descripcion" 
                                        rows="4" 
                                        required 
                                        autocomplete="off" 
                                        autocorrect="off" 
                                        autocapitalize="off" 
                                        spellcheck="false"
                                        placeholder="Describe con claridad lo sucedido: qué estabas haciendo, si apareció algún mensaje de error, desde qué hora comenzó la falla..."
                                        class="w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500/20 transition-colors shadow-xs"
                                    ></textarea>
                                </div>

                                <!-- Evidencia o captura -->
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                                        Adjuntar Captura o Imagen de la falla (Opcional)
                                    </label>
                                    <div class="mt-1 flex items-center gap-4">
                                        <input 
                                            type="file" 
                                            name="imagen" 
                                            accept="image/*"
                                            class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100 cursor-pointer border border-slate-300 rounded-md p-1.5 bg-white shadow-xs"
                                        >
                                    </div>
                                </div>
                            </div>

                            <!-- Botón Enviar -->
                            <div class="pt-2 flex justify-end">
                                <button 
                                    type="submit" 
                                    class="inline-flex items-center gap-2 py-2.5 px-6 border border-transparent rounded-md shadow-xs text-sm font-bold text-white bg-brand-600 hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500 transition-all cursor-pointer"
                                >
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                                    </svg>
                                    <span>Enviar Ticket de Soporte</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </section>

                <!-- LISTA DE TICKETS REPORTADOS -->
                <section class="bg-white rounded-md shadow-xs border border-slate-200 overflow-hidden">
                    <div class="border-b border-slate-200 px-6 py-4 bg-slate-50/70 space-y-3">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <div class="flex items-center gap-2.5">
                                <span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
                                <h2 class="text-base font-bold text-slate-900">
                                    Mis Tickets Reportados y Seguimiento Remoto
                                </h2>
                            </div>
                            <span id="contadorMisTickets" class="text-xs bg-slate-100 text-slate-700 font-bold px-2.5 py-1 rounded-md border border-slate-200">
                                <%= tickets.length %> ticket<%= tickets.length === 1 ? '' : 's' %>
                            </span>
                        </div>

                        <!-- Barra de Búsqueda y Filtros en Mis Tickets -->
                        <% if (tickets.length > 0) { %>
                            <div class="flex flex-wrap items-center gap-2.5 pt-2 border-t border-slate-200/80">
                                <div class="relative flex-1 min-w-[230px]">
                                    <input 
                                        type="text" 
                                        id="buscarMisTickets" 
                                        oninput="filtrarMisTickets()" 
                                        placeholder="Buscar en mis tickets por #ID, título, tipo de falla o descripción..." 
                                        class="w-full rounded-md border border-slate-300 pl-8 pr-7 py-1.5 text-xs text-slate-900 placeholder-slate-400 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                                    >
                                    <span class="absolute left-2.5 top-2 text-slate-400 text-xs">🔍</span>
                                    <button 
                                        type="button" 
                                        id="btnClearBuscarMisTickets" 
                                        onclick="document.getElementById('buscarMisTickets').value=''; filtrarMisTickets();" 
                                        style="display: none;" 
                                        class="absolute right-2 top-1.5 text-slate-400 hover:text-slate-600 text-xs font-bold cursor-pointer"
                                    >✕</button>
                                </div>

                                <div class="min-w-[155px]">
                                    <select 
                                        id="filtroMisTicketsEstatus" 
                                        onchange="filtrarMisTickets()" 
                                        class="w-full rounded-md border border-slate-300 px-2.5 py-1.5 text-xs text-slate-900 bg-white font-medium focus:border-brand-600 focus:outline-none shadow-2xs"
                                    >
                                        <option value="">📌 Todos los estatus</option>
                                        <option value="nuevo ticket">🆕 Nuevo ticket</option>
                                        <option value="en proceso">⚙️ En proceso</option>
                                        <option value="pendiente">⏳ Pendiente</option>
                                        <option value="resuelto">✅ Resuelto</option>
                                    </select>
                                </div>

                                <div class="min-w-[145px]">
                                    <select 
                                        id="filtroMisTicketsPrioridad" 
                                        onchange="filtrarMisTickets()" 
                                        class="w-full rounded-md border border-slate-300 px-2.5 py-1.5 text-xs text-slate-900 bg-white font-medium focus:border-brand-600 focus:outline-none shadow-2xs"
                                    >
                                        <option value="">⚡ Todas las prioridades</option>
                                        <option value="alta">🔴 Alta</option>
                                        <option value="media">🟡 Media</option>
                                        <option value="baja">🟢 Baja</option>
                                    </select>
                                </div>

                                <button 
                                    type="button" 
                                    onclick="limpiarFiltrosMisTickets()" 
                                    class="text-xs font-bold text-slate-600 hover:text-brand-600 bg-white border border-slate-200 px-2.5 py-1.5 rounded-md transition-colors cursor-pointer"
                                >
                                    Limpiar
                                </button>
                            </div>
                        <% } %>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-slate-200 bg-slate-50/50 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                                    <th class="py-3.5 px-4 w-20">ID</th>
                                    <th class="py-3.5 px-4">Título / Tipo de Falla</th>
                                    <th class="py-3.5 px-4">Prioridad</th>
                                    <th class="py-3.5 px-4 max-w-xs">Descripción</th>
                                    <th class="py-3.5 px-4 text-center">Evidencia</th>
                                    <th class="py-3.5 px-4">Estatus y Atención TI</th>
                                    <th class="py-3.5 px-4 text-center">Seguimiento / Chat</th>
                                    <th class="py-3.5 px-4 whitespace-nowrap">Fecha</th>
                                    <th class="py-3.5 px-4 text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-xs">
                                <% if (tickets.length === 0) { %>
                                    <tr>
                                        <td colspan="9" class="py-12 text-center text-slate-400 italic">
                                            <div class="text-3xl mb-2">📋</div>
                                            Aún no has registrado ningún ticket de soporte.
                                        </td>
                                    </tr>
                                <% } %>
                                <% tickets.forEach(t => { %>
                                    <tr 
                                        class="fila-mi-ticket hover:bg-slate-50/80 transition-colors"
                                        data-estatus="<%= (t.estatus || '').toLowerCase() %>"
                                        data-prioridad="<%= (t.prioridad || '').toLowerCase() %>"
                                        data-search="<%= ('#' + t.id + ' ' + t.id + ' ' + (t.titulo || '') + ' ' + (t.tipo_falla || '') + ' ' + (t.subcategoria || '') + ' ' + (t.descripcion || '') + ' ' + (t.estatus || '') + ' ' + (t.atendido_por || '') + ' ' + (t.entregado_por || '')).toLowerCase() %>"
                                    >
                                        <!-- ID del Ticket -->
                                        <td class="py-3.5 px-4 font-bold whitespace-nowrap">
                                            <a 
                                                href="/tickets/<%= t.id %>" 
                                                target="_blank" 
                                                class="inline-flex items-center gap-1 text-brand-600 hover:text-brand-800 font-extrabold hover:underline"
                                                title="Abrir ticket completo en pestaña nueva"
                                            >
                                                <span>#<%= t.id %></span>
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                                </svg>
                                            </a>
                                        </td>

                                        <!-- Título / Tipo de Falla -->
                                        <td class="py-3.5 px-4">
                                            <div class="font-semibold text-slate-900 text-sm flex items-center gap-1.5 flex-wrap">
                                                <span><%= t.titulo %></span>
                                                <% if (t.editado) { %>
                                                    <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded text-[10px] font-bold bg-amber-50 text-amber-800 border border-amber-300 shadow-2xs" title="Modificado el <%= t.editado_at ? new Date(t.editado_at).toLocaleString('es-ES') : '' %>">
                                                        ✏️ Editado
                                                    </span>
                                                <% } %>
                                            </div>
                                            <div class="text-[11px] text-slate-500 mt-0.5 flex items-center gap-1">
                                                <span>📍 <%= t.tipo_falla %></span>
                                                <% if (t.subcategoria) { %>
                                                    <span class="text-brand-600 font-bold">› <%= t.subcategoria %></span>
                                                <% } %>
                                            </div>
                                            <% if (t.creado_por_admin) { %>
                                                <div class="mt-1">
                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-purple-50 text-purple-700 border border-purple-200">
                                                        ✍️ Levantado por Admin: <%= t.creado_por_admin %>
                                                    </span>
                                                </div>
                                            <% } %>
                                        </td>

                                        <!-- Prioridad -->
                                        <td class="py-3.5 px-4 whitespace-nowrap">
                                            <% if (t.prioridad === 'Alta') { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-bold bg-brand-50 text-brand-700 border border-brand-200">
                                                    ⚡ Alta
                                                </span>
                                            <% } else if (t.prioridad === 'Media') { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                    ⚡ Media
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                    ⚡ Baja
                                                </span>
                                            <% } %>
                                        </td>

                                        <!-- Descripción -->
                                        <td class="py-3.5 px-4 text-slate-600 max-w-xs">
                                            <p class="line-clamp-2 leading-relaxed" title="<%= t.descripcion %>">
                                                <%= t.descripcion %>
                                            </p>
                                        </td>

                                        <!-- Evidencia -->
                                        <td class="py-3.5 px-4 text-center whitespace-nowrap">
                                            <% if (t.imagen) { %>
                                                <a href="/uploads/<%= t.imagen %>" target="_blank" class="inline-block group" title="Ver imagen de evidencia">
                                                    <img 
                                                        src="/uploads/<%= t.imagen %>" 
                                                        alt="Captura Falla" 
                                                        class="w-11 h-11 object-cover rounded-md border border-slate-200 group-hover:border-brand-500 shadow-xs transition-all"
                                                    >
                                                </a>
                                            <% } else { %>
                                                <span class="text-slate-400 text-[11px] italic">Sin imagen</span>
                                            <% } %>
                                        </td>

                                        <!-- Estatus Actual y Especialistas que Intervinieron (Punto 5) -->
                                        <td class="py-3.5 px-4">
                                            <div>
                                                <% if (t.estatus === 'Nuevo ticket') { %>
                                                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[11px] font-bold bg-sky-50 text-sky-700 border border-sky-200">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
                                                        Nuevo ticket
                                                    </span>
                                                <% } else if (t.estatus === 'En proceso') { %>
                                                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                                        En proceso
                                                    </span>
                                                <% } else if (t.estatus === 'Pendiente') { %>
                                                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[11px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                                        Pendiente
                                                    </span>
                                                <% } else if (t.estatus === 'Resuelto') { %>
                                                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                                        Resuelto
                                                    </span>
                                                <% } else { %>
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-bold bg-slate-100 text-slate-700">
                                                        <%= t.estatus %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <% if (t.atendido_por || t.entregado_por || t.tecnico_resolvio) { %>
                                                <div class="mt-1.5 text-[10px] text-slate-600 space-y-0.5 bg-slate-50 p-1.5 rounded border border-slate-200/80">
                                                    <% if (t.atendido_por) { %>
                                                        <div>🔧 <strong>Avance TI:</strong> <%= t.atendido_por %></div>
                                                    <% } %>
                                                    <% if (t.entregado_por) { %>
                                                        <div>✅ <strong>Entrega/Cierre:</strong> <%= t.entregado_por %></div>
                                                    <% } else if (!t.atendido_por && t.tecnico_resolvio) { %>
                                                        <div>👨‍💻 <strong>TI:</strong> <%= t.tecnico_resolvio %></div>
                                                    <% } %>
                                                </div>
                                            <% } %>
                                        </td>

                                        <!-- Seguimiento / Chat Remoto (Punto 2) -->
                                        <td class="py-3.5 px-4 text-center whitespace-nowrap">
                                            <button 
                                                type="button" 
                                                onclick="abrirModalChatUsuario(<%= t.id %>)" 
                                                class="relative inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-bold bg-slate-100 hover:bg-brand-50 text-slate-700 hover:text-brand-700 border border-slate-200 hover:border-brand-300 transition-colors cursor-pointer"
                                                title="Abrir chat de seguimiento con Sistemas TI"
                                            >
                                                <span>💬</span>
                                                <span>Seguimiento</span>
                                                <span 
                                                    id="badge-total-com-user-<%= t.id %>" 
                                                    class="px-1.5 py-0.2 rounded text-[10px] bg-white text-slate-600 border border-slate-200 font-bold"
                                                >
                                                    <%= t.total_comentarios || 0 %>
                                                </span>
                                                <span 
                                                    id="badge-unread-com-user-<%= t.id %>" 
                                                    style="<%= (t.no_leidos_usuario || 0) > 0 ? '' : 'display: none;' %>"
                                                    class="px-1.5 py-0.2 rounded-full text-[10px] bg-brand-600 text-white font-extrabold animate-pulse"
                                                >
                                                    <%= t.no_leidos_usuario || 0 %> nuevo<%= (t.no_leidos_usuario || 0) === 1 ? '' : 's' %>
                                                </span>
                                            </button>
                                        </td>

                                        <!-- Fecha de Registro -->
                                        <td class="py-3.5 px-4 whitespace-nowrap text-slate-500 text-[11px]">
                                            <div class="font-medium text-slate-700">
                                                📅 <%= new Date(t.fecha).toLocaleDateString('es-ES') %>
                                            </div>
                                            <div class="text-slate-400">
                                                ⏰ <%= new Date(t.fecha).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) %>
                                            </div>
                                        </td>

                                        <!-- Acciones (Modificar / Eliminar sólo si estatus es Nuevo ticket) -->
                                        <td class="py-3.5 px-4 text-center whitespace-nowrap">
                                            <% if (t.estatus === 'Nuevo ticket') { %>
                                                <script type="application/json" id="ticket-data-<%= t.id %>"><%- JSON.stringify(t).replace(/</g, '\\u003c') %></script>
                                                <div class="flex items-center justify-center gap-1.5">
                                                    <button 
                                                        type="button" 
                                                        onclick="abrirModalEditarTicketUsuario(<%= t.id %>)"
                                                        class="inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-bold text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 transition-colors cursor-pointer"
                                                        title="Modificar los datos de este ticket"
                                                    >
                                                        <span>✏️</span>
                                                        <span>Modificar</span>
                                                    </button>
                                                    <button 
                                                        type="button" 
                                                        onclick="abrirModalEliminarTicketUsuario(<%= t.id %>)"
                                                        class="inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-bold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-colors cursor-pointer"
                                                        title="Cancelar y eliminar este ticket"
                                                    >
                                                        <span>🗑️</span>
                                                        <span>Eliminar</span>
                                                    </button>
                                                </div>
                                            <% } else { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-1 rounded text-[11px] font-semibold bg-slate-100 text-slate-500 border border-slate-200" title="El ticket ya cambió a <%= t.estatus %> y se encuentra en atención por TI. Una vez cambiado el estatus ya no puede ser editado ni eliminado.">
                                                    <span>🔒</span>
                                                    <span>Bloqueado (<%= t.estatus %>)</span>
                                                </span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                                <tr id="filaSinCoincidenciasMisTickets" style="display: none;">
                                    <td colspan="9" class="py-10 text-center text-slate-400 italic text-xs">
                                        🔍 No se encontraron tickets que coincidan con tu búsqueda o filtros seleccionados.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>

            <!-- ========================================== -->
            <!-- MÓDULO 2: GUÍAS RÁPIDAS Y SOLUCIONES (FAQ - PUNTO 6) -->
            <!-- ========================================== -->
            <div id="modulo-user-guias" style="display: none;" class="space-y-6">
                <section class="bg-white rounded-md shadow-xs border border-slate-200 overflow-hidden border-t-4 border-t-brand-600">
                    <div class="border-b border-slate-200 px-6 py-4 bg-slate-50/70 space-y-3">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div>
                                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                                    <span>📚</span>
                                    <span>Guías Rápidas y Soluciones Frecuentes (FAQ)</span>
                                </h2>
                                <p class="text-xs text-slate-500 mt-0.5">
                                    Pasos prácticos elaborados por el área de Sistemas para resolver dudas o incidencias comunes de inmediato.
                                </p>
                            </div>
                            <span id="contadorGuiasUsuario" class="text-xs bg-brand-50 text-brand-700 font-bold px-3 py-1 rounded-md border border-brand-200">
                                <%= listaGuias.length %> guía<%= listaGuias.length === 1 ? '' : 's' %> disponible<%= listaGuias.length === 1 ? '' : 's' %>
                            </span>
                        </div>

                        <!-- Buscador y Filtro de Categoría para Guías Rápidas -->
                        <div class="flex flex-wrap items-center gap-2.5 pt-2 border-t border-slate-200/80">
                            <div class="relative flex-1 min-w-[230px]">
                                <input 
                                    type="text" 
                                    id="buscarGuiasUsuario" 
                                    oninput="filtrarGuiasUsuario()" 
                                    placeholder="Buscar guía por problema (ej. impresora, internet, Outlook, lento)..." 
                                    class="w-full rounded-md border border-slate-300 pl-8 pr-7 py-2 text-xs text-slate-900 placeholder-slate-400 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                                >
                                <span class="absolute left-2.5 top-2.5 text-slate-400 text-xs">🔍</span>
                                <button 
                                    type="button" 
                                    id="btnClearBuscarGuiasUser" 
                                    onclick="document.getElementById('buscarGuiasUsuario').value=''; filtrarGuiasUsuario();" 
                                    style="display: none;" 
                                    class="absolute right-2.5 top-2 text-slate-400 hover:text-slate-600 text-xs font-bold cursor-pointer"
                                >✕</button>
                            </div>

                            <div class="min-w-[200px]">
                                <select 
                                    id="filtroGuiasCategoriaUser" 
                                    onchange="filtrarGuiasUsuario()" 
                                    class="w-full rounded-md border border-slate-300 px-3 py-2 text-xs text-slate-900 bg-white font-medium focus:border-brand-600 focus:outline-none shadow-2xs"
                                >
                                    <option value="">🏷️ Todas las categorías</option>
                                    <% 
                                        const catsGuiasUser = Array.from(new Set(listaGuias.map(g => g.categoria).filter(Boolean)));
                                        catsGuiasUser.forEach(catNom => { 
                                    %>
                                        <option value="<%= catNom.toLowerCase() %>"><%= catNom %></option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="p-6">
                        <% if (listaGuias.length === 0) { %>
                            <div class="text-center py-10 text-slate-400">
                                <div class="text-3xl mb-2">📖</div>
                                <p class="text-xs font-medium text-slate-600">Aún no hay guías rápidas publicadas.</p>
                            </div>
                        <% } else { %>
                            <div id="gridGuiasUsuario" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <% listaGuias.forEach(g => { %>
                                    <div 
                                        class="tarjeta-guia-usuario rounded-md border <%= g.destacada ? 'border-brand-300 bg-brand-50/20' : 'border-slate-200 bg-white' %> p-5 shadow-2xs hover:shadow-xs transition-all flex flex-col justify-between space-y-3"
                                        data-categoria="<%= (g.categoria || '').toLowerCase() %>"
                                        data-search="<%= ((g.titulo || '') + ' ' + (g.categoria || '') + ' ' + (g.resumen || '') + ' ' + (g.contenido || '')).toLowerCase() %>"
                                    >
                                        <div class="space-y-2.5">
                                            <div class="flex items-center justify-between gap-2 flex-wrap">
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-[11px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                                    🏷️ <%= g.categoria %>
                                                </span>
                                                <% if (g.destacada) { %>
                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-brand-600 text-white">
                                                        ⭐ Guía Destacada
                                                    </span>
                                                <% } %>
                                            </div>

                                            <h3 class="text-sm font-extrabold text-slate-900 leading-snug">
                                                <%= g.titulo %>
                                            </h3>

                                            <% if (g.resumen) { %>
                                                <p class="text-xs text-slate-600 font-medium leading-relaxed">
                                                    <%= g.resumen %>
                                                </p>
                                            <% } %>

                                            <div class="rounded-md bg-slate-50 border border-slate-200/80 p-3.5 text-xs text-slate-700 whitespace-pre-line leading-relaxed">
<%= g.contenido %>
                                            </div>

                                            <% if (g.imagen) { %>
                                                <div class="pt-1">
                                                    <a href="/uploads/<%= g.imagen %>" target="_blank" class="inline-block group">
                                                        <img 
                                                            src="/uploads/<%= g.imagen %>" 
                                                            alt="<%= g.titulo %>" 
                                                            class="max-h-44 rounded border border-slate-200 group-hover:border-brand-500 object-contain"
                                                        >
                                                    </a>
                                                </div>
                                            <% } %>
                                        </div>

                                        <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
                                            <span>✍️ Por: <strong class="text-slate-600"><%= g.autor_nombre || 'Sistemas TI' %></strong></span>
                                            <span>📅 <%= new Date(g.fecha_actualizacion || g.fecha_creacion).toLocaleDateString('es-ES') %></span>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                            <div id="sinCoincidenciasGuiasUser" style="display: none;" class="text-center py-8 text-slate-400 italic text-xs">
                                🔍 No se encontraron guías con ese término. Si tu problema persiste, puedes levantar un ticket en el menú lateral.
                            </div>
                        <% } %>
                    </div>
                </section>
            </div>

            <!-- ========================================== -->
            <!-- MÓDULO 3: MI EQUIPO DE CÓMPUTO Y PERIFÉRICOS -->
            <!-- ========================================== -->
            <div id="modulo-user-equipos" style="display: none;" class="space-y-6">
                <section class="bg-white rounded-md shadow-xs border border-slate-200 overflow-hidden">
                    <div class="border-b border-slate-200 px-6 py-4 bg-slate-50/70 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-2.5">
                            <span class="w-2.5 h-2.5 rounded-full bg-brand-600"></span>
                            <div>
                                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                                    <span>💻</span>
                                    <span>Mi Equipo de Cómputo y Periféricos Asignados</span>
                                </h2>
                                <p class="text-xs text-slate-500 mt-0.5">Componentes y dispositivos registrados a tu nombre por el departamento de TI</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 flex-wrap">
                            <% if (totalEquipos > 0) { %>
                                <div class="relative min-w-[230px]">
                                    <input 
                                        type="text" 
                                        id="buscarMisEquipos" 
                                        oninput="filtrarMisEquipos()" 
                                        placeholder="Buscar por componente, marca, modelo o serie..." 
                                        class="w-full rounded-md border border-slate-300 pl-8 pr-7 py-1.5 text-xs text-slate-900 placeholder-slate-400 bg-white focus:border-brand-600 focus:outline-none shadow-2xs"
                                    >
                                    <span class="absolute left-2.5 top-2 text-slate-400 text-xs">🔍</span>
                                    <button 
                                        type="button" 
                                        id="btnClearBuscarMisEquipos" 
                                        onclick="document.getElementById('buscarMisEquipos').value=''; filtrarMisEquipos();" 
                                        style="display: none;" 
                                        class="absolute right-2 top-1.5 text-slate-400 hover:text-slate-600 text-xs font-bold cursor-pointer"
                                    >✕</button>
                                </div>
                            <% } %>
                            <span id="contadorMisEquipos" class="text-xs bg-slate-100 text-slate-700 font-bold px-2.5 py-1 rounded-md border border-slate-200">
                                <%= totalEquipos %> componente<%= totalEquipos === 1 ? '' : 's' %>
                            </span>
                        </div>
                    </div>

                    <div class="p-6">
                        <% if (totalEquipos === 0) { %>
                            <div class="text-center py-8 text-slate-400">
                                <div class="text-3xl mb-2">🖥️</div>
                                <p class="text-xs font-medium text-slate-600">No tienes equipos o periféricos registrados a tu nombre todavía.</p>
                                <p class="text-[11px] text-slate-400 mt-1">El personal de TI registrará aquí tu equipo de cómputo, monitor, mouse y demás accesorios.</p>
                            </div>
                        <% } else { %>
                            <div id="gridMisEquipos" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                                <% equipos.forEach(eq => { %>
                                    <% 
                                        const tLower = (eq.tipo || '').toLowerCase();
                                        let icono = '📦';
                                        if (tLower.includes('mouse') || tLower.includes('raton')) icono = '🖱️';
                                        else if (tLower.includes('teclado')) icono = '⌨️';
                                        else if (tLower.includes('monitor') || tLower.includes('pantalla')) icono = '🖥️';
                                        else if (tLower.includes('laptop') || tLower.includes('portatil')) icono = '💻';
                                        else if (tLower.includes('ensamblad')) icono = '⚙️';
                                        else if (tLower.includes('cpu') || tLower.includes('torre') || tLower.includes('computadora')) icono = '🖲️';
                                        else if (tLower.includes('diadema') || tLower.includes('auricular') || tLower.includes('audifono')) icono = '🎧';
                                        else if (tLower.includes('impresora') || tLower.includes('escaner')) icono = '🖨️';
                                        else if (tLower.includes('ups') || tLower.includes('break') || tLower.includes('regulador')) icono = '🔌';
                                        else if (tLower.includes('disco') || tLower.includes('memoria') || tLower.includes('usb')) icono = '💾';
                                    %>
                                    <div 
                                        class="tarjeta-mi-equipo rounded-md border border-slate-200 bg-white p-4 shadow-2xs hover:shadow-xs transition-shadow flex flex-col justify-between space-y-3"
                                        data-search="<%= ((eq.tipo || '') + ' ' + (eq.marca || '') + ' ' + (eq.modelo || '') + ' ' + (eq.numero_serie || '') + ' ' + (eq.detalles || '') + ' ' + (eq.estado || '')).toLowerCase() %>"
                                    >
                                        <div>
                                            <div class="flex items-center justify-between gap-2 mb-2">
                                                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-xs font-bold bg-slate-100 text-slate-800 border border-slate-200">
                                                    <span><%= icono %></span>
                                                    <span><%= eq.tipo %></span>
                                                </span>
                                                <% const est = eq.estado || 'Operativo'; %>
                                                <% if (est === 'Nuevo' || est === 'Excelente') { %>
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-sky-50 text-sky-700 border border-sky-200">
                                                        ✨ <%= est %>
                                                    </span>
                                                <% } else if (est === 'Operativo' || est === 'Bueno') { %>
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                        ✓ <%= est %>
                                                    </span>
                                                <% } else if (est === 'Regular') { %>
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                        ⚡ <%= est %>
                                                    </span>
                                                <% } else if (est === 'En revisión' || est === 'Mantenimiento') { %>
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-purple-50 text-purple-700 border border-purple-200">
                                                        🔧 <%= est %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                                        ⚠️ <%= est %>
                                                    </span>
                                                <% } %>
                                            </div>

                                            <div class="mt-1">
                                                <div class="text-sm font-bold text-slate-900 leading-tight">
                                                    <%= (eq.marca ? eq.marca + ' ' : '') + (eq.modelo || '') || 'Sin modelo especificado' %>
                                                </div>
                                            </div>

                                            <div class="mt-2 text-xs">
                                                <span class="text-slate-400 font-medium">No. de Serie:</span>
                                                <% if (eq.numero_serie) { %>
                                                    <span class="font-mono text-[11px] font-semibold text-slate-700 bg-slate-50 px-1.5 py-0.5 rounded border border-slate-200 ml-1">
                                                        <%= eq.numero_serie %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="text-slate-400 italic text-[11px] ml-1">Sin serie</span>
                                                <% } %>
                                            </div>

                                            <% if (eq.detalles) { %>
                                                <div class="mt-2.5 p-2 rounded bg-slate-50 border border-slate-100 text-[11px] text-slate-600 leading-relaxed">
                                                    <strong class="text-slate-700 block font-semibold mb-0.5">⚙️ Especificaciones:</strong>
                                                    <%= eq.detalles %>
                                                </div>
                                            <% } %>
                                        </div>

                                        <div class="pt-2 border-t border-slate-100 text-[10px] text-slate-400 flex items-center justify-between">
                                            <span>Asignado el:</span>
                                            <span>📅 <%= new Date(eq.fecha_registro).toLocaleDateString('es-ES') %></span>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                            <div id="sinCoincidenciasMisEquipos" style="display: none;" class="text-center py-8 text-slate-400 italic text-xs">
                                🔍 No se encontraron equipos o componentes que coincidan con tu búsqueda.
                            </div>
                        <% } %>
                    </div>
                </section>
            </div>

        </main>
    </div>

