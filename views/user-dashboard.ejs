        let idMensajeEnEdicionUser = null;

        function iniciarEdicionMensajeUser(comentarioId, textoActual) {
            if (idMensajeEnEdicionUser && idMensajeEnEdicionUser !== comentarioId) {
                cancelarEdicionMensajeUser(idMensajeEnEdicionUser);
            }
            idMensajeEnEdicionUser = comentarioId;
            const form = document.getElementById('formEdicionMensajeUser-' + comentarioId);
            const input = document.getElementById('inputEdicionMensajeUser-' + comentarioId);
            const cuerpo = document.getElementById('cuerpoMensajeTextoUser-' + comentarioId);
            if (form && input) {
                input.value = textoActual;
                form.style.display = 'block';
                if (cuerpo) cuerpo.style.display = 'none';
                input.focus();
                const len = input.value.length;
                input.setSelectionRange(len, len);
            }
        }

        function cancelarEdicionMensajeUser(comentarioId) {
            if (idMensajeEnEdicionUser === comentarioId) {
                idMensajeEnEdicionUser = null;
            }
            const form = document.getElementById('formEdicionMensajeUser-' + comentarioId);
            const cuerpo = document.getElementById('cuerpoMensajeTextoUser-' + comentarioId);
            if (form) form.style.display = 'none';
            if (cuerpo) cuerpo.style.display = 'block';
        }

        async function guardarEdicionMensajeUser(comentarioId) {
            const input = document.getElementById('inputEdicionMensajeUser-' + comentarioId);
            if (!input) return;
            const nuevoTexto = (input.value || '').trim();
            if (!nuevoTexto) {
                alert('El mensaje no puede estar vacío.');
                return;
            }

            const ticketId = document.getElementById('chatUserTicketId').value;

            try {
                const resp = await fetch(`/api/tickets/comentarios/${comentarioId}/editar`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mensaje: nuevoTexto })
                });
                const data = await resp.json();
                if (data.ok) {
                    idMensajeEnEdicionUser = null;
                    if (ticketId) abrirModalChatUsuario(ticketId, true);
                } else {
                    alert(data.error || 'No se pudo editar el mensaje.');
                }
            } catch (err) {
                console.error(err);
                alert('Error al guardar la edición.');
            }
        }

        async function eliminarMensajeUser(comentarioId) {
            if (!confirm('¿Estás seguro de que deseas eliminar este mensaje? Esta acción no se puede deshacer.')) {
                return;
            }

            const ticketId = document.getElementById('chatUserTicketId').value;

            try {
                const resp = await fetch(`/api/tickets/comentarios/${comentarioId}/eliminar`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await resp.json();
                if (data.ok) {
                    if (ticketId) abrirModalChatUsuario(ticketId);
                } else {
                    alert(data.error || 'No se pudo eliminar el mensaje.');
                }
            } catch (err) {
                console.error(err);
                alert('Error al eliminar el mensaje.');
            }
        }

        async function abrirModalChatUsuario(ticketId, forzar = false) {
            const activo = document.activeElement;
            const tieneFocoEnEdicion = activo && activo.id && activo.id.startsWith('inputEdicionMensajeUser');
            if ((idMensajeEnEdicionUser !== null || tieneFocoEnEdicion) && !forzar) {
                return;
            }

            const modal = document.getElementById('modalChatUsuario');
            document.getElementById('chatUserTicketId').value = ticketId;
            document.getElementById('chatUserTituloModal').textContent = `Seguimiento Remoto — Ticket #${ticketId}`;
            modal.style.display = 'block';

            const badgeUnread = document.getElementById('badge-unread-com-user-' + ticketId);
            if (badgeUnread) badgeUnread.style.display = 'none';

            try {
                const res = await fetch(`/api/tickets/${ticketId}/comentarios`, { headers: { 'Accept': 'application/json' } });
                const data = await res.json();
                if (data && data.ok) {
                    document.getElementById('chatUserTituloModal').textContent = `Ticket #${data.ticket.id} — ${data.ticket.titulo}`;
                    const banner = document.getElementById('chatUserBannerEspecialistas');
                    const partes = [];
                    if (data.ticket.atendido_por) partes.push(`<span>🔧 <strong>Atendido/Avanzado por:</strong> ${escaparHtmlUser(data.ticket.atendido_por)}</span>`);
                    if (data.ticket.entregado_por) partes.push(`<span>✅ <strong>Entregado/Cerrado por:</strong> ${escaparHtmlUser(data.ticket.entregado_por)}</span>`);
                    if (partes.length > 0 && banner) {
                        banner.innerHTML = partes.join('<span class="text-amber-400">•</span>');
                        banner.style.display = 'flex';
                    } else if (banner) {
                        banner.style.display = 'none';
                    }
                    renderizarMensajesChatUsuario(data.comentarios || [], data.usuarioActual);
                    verificarNotificacionesVivoUsuario();
                }
            } catch (e) {}
        }

        function cerrarModalChatUsuario() {
            document.getElementById('modalChatUsuario').style.display = 'none';
            document.getElementById('chatUserTicketId').value = '';
            idMensajeEnEdicionUser = null;
            quitarImagenAdjuntaChatUser();
        }

        function manejarSeleccionImagenChatUser(e) {
            const input = document.getElementById('chatUserImagenInput');
            const previewCont = document.getElementById('chatUserPreviewContenedor');
            const imgPreview = document.getElementById('chatUserImgPreview');
            const nombreSpan = document.getElementById('chatUserNombreImagenPreview');
            const sizeSpan = document.getElementById('chatUserSizeImagenPreview');
            const label = document.getElementById('chatUserArchivoNombre');

            if (input && input.files && input.files[0]) {
                const file = input.files[0];
                const sizeKb = (file.size / 1024).toFixed(1);

                if (nombreSpan) nombreSpan.textContent = file.name;
                if (sizeSpan) sizeSpan.textContent = `(${sizeKb} KB)`;
                if (label) label.textContent = file.name;

                const reader = new FileReader();
                reader.onload = function(evt) {
                    if (imgPreview) imgPreview.src = evt.target.result;
                    if (previewCont) previewCont.style.display = 'flex';
                };
                reader.readAsDataURL(file);
            } else {
                quitarImagenAdjuntaChatUser();
            }
        }

        function quitarImagenAdjuntaChatUser() {
            const input = document.getElementById('chatUserImagenInput');
            const previewCont = document.getElementById('chatUserPreviewContenedor');
            const imgPreview = document.getElementById('chatUserImgPreview');
            const nombreSpan = document.getElementById('chatUserNombreImagenPreview');
            const sizeSpan = document.getElementById('chatUserSizeImagenPreview');
            const label = document.getElementById('chatUserArchivoNombre');

            if (input) input.value = '';
            if (imgPreview) imgPreview.src = '';
            if (nombreSpan) nombreSpan.textContent = '';
            if (sizeSpan) sizeSpan.textContent = '';
            if (label) label.textContent = '';
            if (previewCont) previewCont.style.display = 'none';
        }

        let enviandoMensajeChatUser = false;

        async function enviarMensajeChatUsuario(e) {
            e.preventDefault();
            if (enviandoMensajeChatUser) return; // Candado estricto contra clics múltiples

            const ticketId = document.getElementById('chatUserTicketId').value;
            const msgInput = document.getElementById('chatUserMensajeInput');
            const imgInput = document.getElementById('chatUserImagenInput');
            const btn = document.getElementById('btnEnviarChatUser');

            if (!ticketId) return;
            const texto = (msgInput.value || '').trim();
            const archivo = (imgInput.files && imgInput.files[0]) ? imgInput.files[0] : null;

            if (!texto && !archivo) {
                alert('Escribe un mensaje o adjunta una imagen antes de enviar.');
                return;
            }

            enviandoMensajeChatUser = true;
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span>⏳ Enviando...</span>';
                btn.classList.add('opacity-70', 'cursor-not-allowed');
            }

            const formData = new FormData();
            formData.append('mensaje', texto);
            formData.append('formato', 'json');
            if (archivo) formData.append('imagen', archivo);

            try {
                const res = await fetch(`/api/tickets/${ticketId}/comentarios`, {
                    method: 'POST',
                    headers: { 'Accept': 'application/json' },
                    body: formData
                });
                const data = await res.json();
                if (data && data.ok) {
                    msgInput.value = '';
                    quitarImagenAdjuntaChatUser();
                    abrirModalChatUsuario(ticketId);
                } else {
                    alert(data?.error || 'No se pudo enviar el mensaje.');
                }
            } catch (err) {
                console.error(err);
                alert('Ocurrió un error al enviar el mensaje.');
            } finally {
                enviandoMensajeChatUser = false;
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<span>📤 Enviar Mensaje</span>';
                    btn.classList.remove('opacity-70', 'cursor-not-allowed');
                }
            }
        }

        async function verificarNotificacionesVivoUsuario() {
            try {
                const res = await fetch('/api/usuario/notificaciones-live', { headers: { 'Accept': 'application/json' } });
                if (res.status === 401) {
                    window.location.href = '/?inactividad=1';
                    return;
                }
                const data = await res.json();
                if (!data || !data.ok) return;

                const totalNoLeidos = data.totalMensajesNoLeidos || 0;
                const badge = document.getElementById('badgeNotificacionesUser');
                if (badge) {
                    if (totalNoLeidos > 0) {
                        badge.style.display = '';
                        badge.textContent = totalNoLeidos;
                        document.title = `(${totalNoLeidos}) 🔔 Mensaje de TI - Sistema de Tickets`;
                    } else {
                        badge.style.display = 'none';
                        document.title = 'Panel de Usuario - Sistema de Tickets';
                    }
                }

                // Actualizar contadores por fila de ticket
                (data.conteosPorTicket || []).forEach(c => {
                    const bTotal = document.getElementById('badge-total-com-user-' + c.ticket_id);
                    const bUnread = document.getElementById('badge-unread-com-user-' + c.ticket_id);
                    if (bTotal) bTotal.textContent = c.total_comentarios || 0;
                    if (bUnread) {
                        if ((c.no_leidos_usuario || 0) > 0) {
                            bUnread.style.display = '';
                            bUnread.textContent = `${c.no_leidos_usuario} nuevo${c.no_leidos_usuario === 1 ? '' : 's'}`;
                        } else {
                            bUnread.style.display = 'none';
                        }
                    }
                });

                // Lista en dropdown
                const lista = document.getElementById('listaNotificacionesUser');
                if (lista) {
                    if ((data.mensajesNoLeidos || []).length === 0) {
                        lista.innerHTML = '<div class="p-4 text-center text-slate-400 italic">No tienes mensajes pendientes por leer.</div>';
                    } else {
                        lista.innerHTML = data.mensajesNoLeidos.map(m => `
                            <div onclick="abrirModalChatUsuario(${m.ticket_id}); document.getElementById('dropdownNotificacionesUser').style.display='none';" class="p-3 hover:bg-brand-50/60 cursor-pointer transition-colors">
                                <div class="flex items-center justify-between font-bold text-slate-900">
                                    <span>Ticket #${m.ticket_id}: ${escaparHtmlUser(m.ticket_titulo)}</span>
                                    <span class="text-[10px] text-brand-600">Nuevo</span>
                                </div>
                                <div class="text-[11px] text-slate-600 mt-0.5 line-clamp-2">
                                    <strong>${escaparHtmlUser(m.autor_nombre)}:</strong> ${escaparHtmlUser(m.mensaje)}
                                </div>
                            </div>
                        `).join('');
                    }
                }

                // Detectar mensajes nuevos para sonar alerta y mostrar toast
                (data.mensajesNoLeidos || []).forEach(m => {
                    if (!idsMensajesConocidosUser.has(m.id)) {
                        idsMensajesConocidosUser.add(m.id);
                        if (!primeraCargaNotifUser) {
                            reproducirSonidoNotificacionUser();
                            mostrarToastUsuario(`Ticket #${m.ticket_id} — ${m.autor_nombre}`, m.mensaje, m.ticket_id);
                            // Si tiene abierto el modal de ese ticket, refrescarlo en vivo
                            const abiertoId = document.getElementById('chatUserTicketId')?.value;
                            if (String(abiertoId) === String(m.ticket_id)) {
                                abrirModalChatUsuario(m.ticket_id);
                            }
                        }
                    }
                });
                primeraCargaNotifUser = false;
            } catch (e) {}
        }

        verificarNotificacionesVivoUsuario();
        setInterval(verificarNotificacionesVivoUsuario, 12000);

        // Control de tiempo de inactividad de 5 minutos para usuarios
        (function() {
            const CINCO_MINUTOS_MS = 5 * 60 * 1000; // 5 minutos = 300,000 ms
            let ultimaActividad = Date.now();
            let timerInactividad = null;

            function expirarSesion() {
                window.location.href = '/logout?inactividad=1';
            }

            function reiniciarContadorInactividad() {
                ultimaActividad = Date.now();
                if (timerInactividad) clearTimeout(timerInactividad);
                timerInactividad = setTimeout(expirarSesion, CINCO_MINUTOS_MS);
            }

            const eventos = ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click'];
            eventos.forEach(evt => {
                window.addEventListener(evt, reiniciarContadorInactividad, { passive: true });
            });

            window.addEventListener('focus', function() {
                if (Date.now() - ultimaActividad >= CINCO_MINUTOS_MS) {
                    expirarSesion();
                }
            });

            setInterval(function() {
                if (Date.now() - ultimaActividad >= CINCO_MINUTOS_MS) {
                    expirarSesion();
                }
            }, 10000);

            reiniciarContadorInactividad();
        })();
    </script>
</body>
</html>